{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/coverage/**",
      "!{projectRoot}/.control/**",
      "!{projectRoot}/generated/**",
      "!{projectRoot}/prisma/generated/**",
      "!{projectRoot}/src/generated/**",
      "!{projectRoot}/node_modules/.prisma/**",
      "!{projectRoot}/node_modules/@prisma/**"
    ],
    "clientProduction": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/coverage/**",
      "!{projectRoot}/.control/**",
      "{workspaceRoot}/bun.lock"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/**"
      ]
    },
    "server:build": {
      "cache": true,
      "dependsOn": [
        "prisma:generate",
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/**"
      ]
    },
    "frontend:build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/**",
        "{projectRoot}/frontend/dist/**",
        "{projectRoot}/frontend/**/dist/**"
      ]
    },
    "admin:build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/admin/**"
      ]
    },
    "worker:build": {
      "cache": true,
      "dependsOn": [
        "prisma:generate",
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist-worker/**"
      ]
    },
    "test": {
      "cache": false,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "test:unit": {
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/coverage/**"
      ]
    },
    "check-types": {
      "cache": true,
      "dependsOn": [
        "^check-types"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "prisma:generate": {
      "cache": true,
      "dependsOn": [
        "^prisma:generate"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/node_modules/.prisma/**",
        "{projectRoot}/node_modules/@prisma/**",
        "{projectRoot}/generated/**",
        "{projectRoot}/prisma/generated/**",
        "{projectRoot}/src/generated/**",
        "{workspaceRoot}/node_modules/.prisma/**",
        "{workspaceRoot}/node_modules/@prisma/**"
      ]
    },
    "prisma:push": {
      "cache": false
    },
    "dev": {
      "cache": false
    },
    "deploy": {
      "cache": false
    }
  }
}
