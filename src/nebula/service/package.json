{
  "name": "@metorial/nebula",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-nebula ./dist && sentry-cli sourcemaps upload --org metorial --project mte-nebula ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "dev": "bun \"$(ROOT=$(git rev-parse --show-toplevel); if [ -f \"$ROOT/scripts/dev-tools/src/cli.ts\" ]; then echo \"$ROOT/scripts/dev-tools/src/cli.ts\"; else echo \"$ROOT/oss/scripts/dev-tools/src/cli.ts\"; fi)\" watch-bun ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "bun prisma generate",
    "db:push:dev": "sh -c 'set -a; . ./.env; set +a; bun prisma db push --accept-data-loss'",
    "db:push:test": "sh -c 'set -a; . ./.env.test; set +a; bun prisma db push --accept-data-loss'",
    "db:push": "bun run db:push:dev && bun run db:push:test",
    "test": "bun run test:unit",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts --passWithNoTests --configLoader runner",
    "test:e2e": "bun --bun x vitest run e2e.test.ts --configLoader native",
    "test:watch": "bunx vitest watch",
    "typecheck": "tsc --noEmit",
    "test:start-e2e": "bun ./src/server.ts",
    "dev:start": "bun --watch ./src/server.ts",
    "control:db:generate": "bun run prisma:generate",
    "control:db:push": "bun run prisma:push"
  },
  "devDependencies": {
    "@lowerdeck/testing-tools": "workspace:2.0.0",
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@vercel/ncc": "^0.38.1",
    "vitest": "4.0.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.957.0",
    "@aws-sdk/credential-providers": "^3.957.0",
    "@lowerdeck/api-mux": "workspace:2.0.0",
    "@lowerdeck/cache": "workspace:2.0.0",
    "@lowerdeck/canonicalize": "workspace:2.0.0",
    "@lowerdeck/cron": "workspace:2.0.0",
    "@lowerdeck/env": "workspace:2.0.0",
    "@lowerdeck/error": "workspace:2.0.0",
    "@lowerdeck/hash": "workspace:2.0.0",
    "@lowerdeck/id": "workspace:2.0.0",
    "@lowerdeck/jwt": "workspace:2.0.0",
    "@lowerdeck/lock": "workspace:2.0.0",
    "@lowerdeck/pagination": "workspace:2.0.0",
    "@lowerdeck/queue": "workspace:2.0.0",
    "@lowerdeck/rpc-client": "workspace:2.0.0",
    "@lowerdeck/rpc-server": "workspace:2.0.0",
    "@lowerdeck/sentry": "workspace:2.0.0",
    "@lowerdeck/service": "workspace:2.0.0",
    "@lowerdeck/snowflake": "workspace:2.0.0",
    "@lowerdeck/validation": "workspace:2.0.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "date-fns": "^4.1.0",
    "prisma": "^7.2.0"
  }
}
