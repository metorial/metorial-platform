  "extends": "@metorial/tsconfig/base.json",
  "exclude": ["dist"],
  "include": ["src"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "lib": ["es2021", "DOM", "WebWorker"],
    "target": "ESNext",
    "module": "ESNext"
  }
}
