enum SsoTenantStatus {
  pending
  completed
}

model SsoTenant {
  oid BigInt @id
  id  String @unique

  status SsoTenantStatus @default(pending)

  clientId   String  @unique
  name       String
  externalId String? @unique

  /// [JsonObject]
  metadata Json?

  isGlobal Boolean @default(false)
  hideInUI Boolean @default(false)

  appOid BigInt
  app    App    @relation(fields: [appOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  connections      SsoConnection[]
  connectionSetups SsoConnectionSetup[]
  users            SsoUser[]
  userChanges      SsoUserChange[]
  userProfiles     SsoUserProfile[]
  groups           SsoGroup[]
  roles            SsoRole[]
  auths            SsoAuth[]

  identityProvider UserIdentityProvider?
  ssoTenantDomain  SsoTenantDomain[]
}

model SsoTenantDomain {
  oid BigInt @id
  id  String @unique

  domain String

  tenantOid BigInt
  tenant    SsoTenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  appOid BigInt
  app    App    @relation(fields: [appOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([appOid, domain])
}
