// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

generator json {
  provider = "prisma-json-types-generator"
}

model Tenant {
  oid BigInt @id
  id  String @unique

  identifier String @unique
  name       String

  createdAt DateTime @default(now())

  eventDestinations                EventDestination[]
  webhookDestinationWebhooks       WebhookDestinationWebhook[]
  webhookDestinationSigningSecrets WebhookDestinationSigningSecret[]
  webhookSecretIssuanceReceipts    WebhookSecretIssuanceReceipt[]
  webhookSecretAuditRecords        WebhookSecretAuditRecord[]
  events                           Event[]
  callbacks                        Callback[]
}

model Sender {
  oid BigInt @id
  id  String @unique

  identifier String @unique
  name       String

  createdAt DateTime @default(now())

  events            Event[]
  eventDestinations EventDestination[]
  callbacks         Callback[]
}

enum EventDestinationType {
  http_endpoint
}

enum EventDestinationStatus {
  active
  inactive
}

enum EventRetryType {
  linear
  exponential
}

model EventDestination {
  oid        BigInt  @id
  id         String  @unique
  externalId String?

  status                EventDestinationStatus
  isCallbackDestination Boolean                @default(false)

  type EventDestinationType

  eventTypes          String[]
  hasEventTypesFilter Boolean

  name        String
  description String?

  retryType         EventRetryType
  retryDelaySeconds Int
  retryMaxAttempts  Int

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  senderOid BigInt
  sender    Sender @relation(fields: [senderOid], references: [oid])

  currentInstanceOid BigInt?
  currentInstance    EventDestinationInstance? @relation(fields: [currentInstanceOid], references: [oid], name: "currentInstance")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime?
  lastActiveAt DateTime?
  expiresAt    DateTime?

  callbackDestinationLinks  CallbackDestinationLink[]
  intents                   EventDeliveryIntent[]
  eventDestinationInstances EventDestinationInstance[]

  @@unique([tenantOid, senderOid, externalId])
}

enum CallbackStatus {
  active
  archived
}

enum CallbackDestinationLinkStatus {
  active
  inactive
}

enum CallbackEventStatus {
  pending
  processing
  retrying
  succeeded
  failed
  skipped
}

model Callback {
  oid BigInt @id
  id  String @unique

  status CallbackStatus

  name        String
  description String?

  eventTypes          String[]
  hasEventTypesFilter Boolean

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  senderOid BigInt
  sender    Sender @relation(fields: [senderOid], references: [oid])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?

  destinations   CallbackDestinationLink[]
  events         Event[]
  callbackEvents CallbackEvent[]

  @@index([tenantOid, status])
  @@index([senderOid, status])
}

model CallbackDestinationLink {
  oid BigInt @id

  callbackOid BigInt
  callback    Callback @relation(fields: [callbackOid], references: [oid])

  eventDestinationOid BigInt
  eventDestination    EventDestination @relation(fields: [eventDestinationOid], references: [oid])

  status CallbackDestinationLinkStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([callbackOid, eventDestinationOid])
  @@index([callbackOid, status])
  @@index([eventDestinationOid, status])
}

model CallbackEvent {
  oid BigInt @id
  id  String @unique

  idempotencyKey String              @unique
  externalId     String?
  status         CallbackEventStatus @default(succeeded)

  callbackOid BigInt
  callback    Callback @relation(fields: [callbackOid], references: [oid])

  eventOid BigInt? @unique
  event    Event?  @relation(fields: [eventOid], references: [oid])

  type               String
  sourceId           String?
  triggerId          String?
  triggerKey         String?
  callbackInstanceId String?
  errorCode          String?
  errorMessage       String?

  inputJson        String?
  inputStorageKey  String?
  outputJson       String?
  outputStorageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([callbackOid, createdAt])
  @@index([externalId])
  @@index([status])
  @@index([callbackOid, status])
  @@index([callbackInstanceId])
}

model EventDestinationInstance {
  oid BigInt @id

  type EventDestinationType

  webhookOid BigInt?
  webhook    WebhookDestinationWebhook? @relation(fields: [webhookOid], references: [oid])

  destinationOid BigInt
  destination    EventDestination @relation(fields: [destinationOid], references: [oid])

  createdAt DateTime @default(now())

  currentForDestinations EventDestination[]     @relation(name: "currentInstance")
  eventDeliveryAttempts  EventDeliveryAttempt[]
}

enum WebhookMethod {
  POST
  PUT
  PATCH
}

model WebhookDestinationWebhook {
  oid BigInt @id
  id  String @unique

  url    String
  method WebhookMethod

  signingSecret String

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  createdAt DateTime @default(now())

  eventDestinationInstances EventDestinationInstance[]
  signingSecrets            WebhookDestinationSigningSecret[]
  secretIssuanceReceipts    WebhookSecretIssuanceReceipt[]
  secretAuditRecords        WebhookSecretAuditRecord[]
}

model WebhookDestinationSigningSecret {
  oid BigInt @id
  id  String @unique(map: "signal_webhook_secret_id_key")

  webhookDestinationWebhookOid BigInt
  webhookDestinationWebhook    WebhookDestinationWebhook @relation(fields: [webhookDestinationWebhookOid], references: [oid], onDelete: Cascade, map: "signal_webhook_secret_owner_fk")

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade, map: "signal_webhook_secret_tenant_fk")

  purpose              String
  encryptedValue       String
  secretVersion        Int
  encryptionKeyVersion Int
  aadVersion           Int
  status               String
  validFrom            DateTime
  validUntil           DateTime?
  createdAt            DateTime  @default(now())
  rotatedAt            DateTime?
  revokedAt            DateTime?

  @@unique([webhookDestinationWebhookOid, purpose, secretVersion], map: "signal_webhook_secret_owner_version_key")
  @@index([tenantOid, webhookDestinationWebhookOid], map: "signal_webhook_secret_owner_idx")
  @@index([webhookDestinationWebhookOid, status, validUntil], map: "signal_webhook_secret_status_idx")
}

enum WebhookSecretIssuanceReceiptStatus {
  issued
  consumed
  expired
}

enum WebhookSecretAuditAction {
  secret_created
  secret_imported
  secret_projected
  secret_rotated
  secret_revoked
  secret_issuance_receipt_issued
  secret_issuance_receipt_consumed
  secret_issuance_receipt_denied
}

model WebhookSecretIssuanceReceipt {
  oid       BigInt @id
  id        String @unique(map: "signal_webhook_receipt_id_key")
  tokenHash String @unique(map: "signal_webhook_receipt_token_hash_key")

  tenantOid                    BigInt
  tenant                       Tenant                    @relation(fields: [tenantOid], references: [oid], onDelete: Cascade, map: "signal_webhook_receipt_tenant_fk")
  webhookDestinationWebhookOid BigInt
  webhookDestinationWebhook    WebhookDestinationWebhook @relation(fields: [webhookDestinationWebhookOid], references: [oid], onDelete: Cascade, map: "signal_webhook_receipt_owner_fk")

  secretId          String
  encryptedMaterial String
  status            WebhookSecretIssuanceReceiptStatus @default(issued)
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime                           @default(now())

  @@index([tenantOid, webhookDestinationWebhookOid, status, expiresAt], map: "signal_webhook_receipt_status_idx")
}

model WebhookSecretAuditRecord {
  oid                BigInt @id
  id                 String @unique(map: "signal_webhook_audit_id_key")
  auditCorrelationId String

  tenantOid                    BigInt
  tenant                       Tenant                    @relation(fields: [tenantOid], references: [oid], onDelete: Cascade, map: "signal_webhook_audit_tenant_fk")
  webhookDestinationWebhookOid BigInt
  webhookDestinationWebhook    WebhookDestinationWebhook @relation(fields: [webhookDestinationWebhookOid], references: [oid], onDelete: Cascade, map: "signal_webhook_audit_owner_fk")

  action    WebhookSecretAuditAction
  metadata  Json
  createdAt DateTime                 @default(now())

  @@index([auditCorrelationId], map: "signal_webhook_audit_correlation_idx")
  @@index([tenantOid, webhookDestinationWebhookOid, createdAt], map: "signal_webhook_audit_owner_idx")
}

enum EventStatus {
  pending
  delivered
  failed
}

enum EventInitializationStatus {
  awaiting_enqueue
  queued
  initialized
}

model Event {
  oid                      BigInt                    @id
  id                       String                    @unique
  idempotencyKey           String?                   @unique
  requestFingerprint       String?
  initializationStatus     EventInitializationStatus @default(awaiting_enqueue)
  initializationEnqueuedAt DateTime?
  initializedAt            DateTime?
  status                   EventStatus

  topics String[]

  deliveryDestinationCount Int
  deliverySuccessCount     Int
  deliveryFailureCount     Int

  eventType   String
  payloadJson String?

  onlyForDestinations          String[]
  hasOnlyForDestinationsFilter Boolean  @default(false)

  /// [Headers]
  headers Json @default("[]")

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  senderOid BigInt
  sender    Sender @relation(fields: [senderOid], references: [oid])

  callbackOid BigInt?
  callback    Callback? @relation(fields: [callbackOid], references: [oid])

  callbackInstanceId String?
  callbackSourceId   String?
  callbackTriggerId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  intents       EventDeliveryIntent[]
  callbackEvent CallbackEvent?

  @@index([topics])
  @@index([eventType])
  @@index([callbackOid, createdAt])
  @@index([callbackInstanceId])
  @@index([initializationStatus, idempotencyKey, createdAt])
}

enum EventDeliveryIntentStatus {
  pending
  delivered
  retrying
  failed
}

model EventDeliveryIntent {
  oid    BigInt                    @id
  id     String                    @unique
  status EventDeliveryIntentStatus

  attemptCount Int @default(0)

  errorCode    String?
  errorMessage String?

  eventOid BigInt
  event    Event  @relation(fields: [eventOid], references: [oid])

  destinationOid BigInt
  destination    EventDestination @relation(fields: [destinationOid], references: [oid])

  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  attempts EventDeliveryAttempt[]

  @@unique([eventOid, destinationOid])
  @@index([status])
}

enum EventDeliveryAttemptStatus {
  succeeded
  failed
}

model EventDeliveryAttempt {
  oid    BigInt                     @id
  id     String                     @unique
  status EventDeliveryAttemptStatus

  attemptNumber Int
  durationMs    Int

  errorCode    String?
  errorMessage String?

  responseStatusCode Int?
  // responseBody       String?
  // responseHeaders    String?

  destinationInstanceOid BigInt
  destinationInstance    EventDestinationInstance @relation(fields: [destinationInstanceOid], references: [oid])

  intentOid BigInt
  intent    EventDeliveryIntent @relation(fields: [intentOid], references: [oid])

  createdAt DateTime @default(now())

  @@index([status])
}
