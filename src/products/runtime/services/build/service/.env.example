# Service configuration
DATABASE_URL=postgresql://forge:forge@postgres:5432/forge
REDIS_URL=redis://redis:6379

ENCRYPTION_KEY=

# Object storage
OBJECT_STORAGE_URL=http://object-storage:52010
ARTIFACT_BUCKET_NAME=artifacts
LOG_BUCKET_NAME=logs

# Provider defaults
DEFAULT_PROVIDER=aws.code-build

# Object storage overrides (optional)
OBJECT_STORAGE_BACKEND_TYPE=local
OBJECT_STORAGE_BACKEND_ROOT_PATH=/app/data
OBJECT_STORAGE_AWS_REGION=us-east-1
OBJECT_STORAGE_AWS_S3_BUCKET=forge-local
OBJECT_STORAGE_AWS_ACCESS_KEY_ID=test
OBJECT_STORAGE_AWS_SECRET_ACCESS_KEY=test

# Kubernetes configuration (DEFAULT_PROVIDER=kubernetes)
# CLUSTER_MANAGER_URL=http://metorial-cluster-manager:52240/rpc
# CLUSTER_MANAGER_TOKEN_FILE=/var/run/secrets/metorial/cluster-manager/token
# BUILD_SIGNING_KEY=
# BUILD_SIGNING_KEY_ID=
# BUILD_EGRESS_HOSTS=registry.npmjs.org:443,archive.ubuntu.com:80
# BUILD_EGRESS_CIDRS=10.20.0.0/16:443
# KUBERNETES_BUILD_TIMEOUT_SECONDS=3600
# SLATE_DEPLOYMENT_NPM_REGISTRY_URL=

# AWS CodeBuild configuration (optional)
CODE_BUILD_AWS_REGION=us-east-1
# CODE_BUILD_AWS_ACCESS_KEY_ID=
# CODE_BUILD_AWS_SECRET_ACCESS_KEY=
# CODE_BUILD_PROJECT_NAME=
# CODE_BUILD_ROLE_ARN=
# CODE_BUILD_CONCURRENCY_LIMIT=
# CODE_BUILD_LOG_RETENTION_DAYS=
# CODE_BUILD_LOG_GROUP_NAME=
