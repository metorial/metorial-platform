enum ScmProvider {
  github
  gitlab
  bitbucket
}

enum ScmRepositorySyncStatus {
  pending
  creating_branch
  syncing_contents
  creating_pr
  waiting_for_ci
  waiting_for_review
  merging
  merged
  failed
  cancelled
  complete_unmerged
  complete_direct_push
  complete_no_changes
}

enum ScmRepositoryAccessMode {
  pull_request
  default_branch
}

enum ScmAccountType {
  user
  organization
}

enum ScmRepositorySyncSourceType {
  code_bucket
  manifest
}

model ScmAccount {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  provider ScmProvider
  type     ScmAccountType

  name       String
  identifier String

  externalId String

  backendOid BigInt
  backend    ScmBackend @relation(fields: [backendOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  scmRepos ScmRepository[]

  @@unique([tenantOid, backendOid, externalId])
}

model ScmRepository {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  provider ScmProvider

  name       String
  identifier String

  externalId        String
  externalName      String
  externalOwner     String
  externalUrl       String
  externalIsPrivate Boolean

  defaultBranch String @default("main")

  webhookReconcileBlockedUntil  DateTime?
  webhookReconcileBlockedReason String?
  webhookReconciledAt           DateTime?

  backendOid BigInt
  backend    ScmBackend @relation(fields: [backendOid], references: [oid], onDelete: Cascade)

  accountOid BigInt
  account    ScmAccount @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  installationOid BigInt
  installation    ScmInstallation @relation(fields: [installationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  codeBuckets         CodeBucket[]
  scmRepoWebhooks     ScmRepositoryWebhook[]
  scmRepoPushes       ScmRepositoryPush[]
  changeNotifications ChangeNotification[]
  scmRepositorySyncs  ScmRepositorySync[]
  remoteStates        ScmRepositoryRemoteState[]

  @@unique([tenantOid, backendOid, externalId])
  @@index([webhookReconcileBlockedUntil, oid])
  @@index([webhookReconciledAt, oid])
}

model ScmRepositorySync {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status               ScmRepositorySyncStatus @default(pending)
  repositoryAccessMode ScmRepositoryAccessMode @default(pull_request)
  requestKey           String?
  endReason            String?

  sourceType ScmRepositorySyncSourceType @default(code_bucket)
  sourceKey  String?

  manifestBucket         String?
  manifestKey            String?
  manifestSha256         String?
  manifestEntryCount     Int?
  previousManifestBucket String?
  previousManifestKey    String?
  previousManifestSha256 String?

  /// [RepositorySyncDeletionGuard]
  deletionGuard   Json?
  allowMassDelete Boolean @default(false)

  branchName             String
  requestedBranchName    String?
  baseBranch             String
  baseCommitSha          String?
  lastPushedCommitSha    String?
  /// Sticky once anyone else's commits were seen on the branch since Origin created or last
  /// reset it; a conflicting branch is only reset while this is false.
  foreignCommitsOnBranch Boolean @default(false)

  title       String
  description String?

  enableAutoMerge       Boolean @default(true)
  forceMergeOrPush      Boolean @default(false)
  mergeBeforeChecksPass Boolean @default(false)

  deletePaths String[] @default([])

  explicitDeletesOnly Boolean @default(false)

  gitLfsThresholdBytes Int?

  providerPrId               String?
  providerPrUrl              String?
  providerMergeSha           String?
  mergeAttemptSnapshotHashes String[] @default([])

  errorMessage         String?
  errorCode            String?
  /// [RepositorySyncErrorDetails]
  errorDetails         Json?
  waitingReason        String?
  ciState              String?
  /// [RepositorySyncStatusSnapshot]
  statusSnapshot       Json?
  attemptCount         Int     @default(0)
  noProgressSliceCount Int     @default(0)

  /// [SyncLogEntry]
  logs Json[] @default([])

  /// [RepositorySyncResultStats]
  resultStats Json?

  lastPolledAt DateTime?
  nextPollAt   DateTime?
  completedAt  DateTime?

  continuedFromSyncOid BigInt?
  continuedFromSync    ScmRepositorySync?  @relation("RepositorySyncContinuation", fields: [continuedFromSyncOid], references: [oid], onDelete: SetNull)
  continuedBySyncs     ScmRepositorySync[] @relation("RepositorySyncContinuation")

  supersededBySyncOid BigInt?
  supersededBySync    ScmRepositorySync?  @relation("RepositorySyncSupersession", fields: [supersededBySyncOid], references: [oid], onDelete: SetNull)
  supersededSyncs     ScmRepositorySync[] @relation("RepositorySyncSupersession")

  repoOid BigInt
  repo    ScmRepository @relation(fields: [repoOid], references: [oid], onDelete: Cascade)

  codeBucketOid BigInt?
  codeBucket    CodeBucket? @relation(fields: [codeBucketOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  changeNotifications ChangeNotification[] @relation("RepositorySyncChangeNotifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantOid, requestKey])
  @@index([tenantOid])
  @@index([repoOid])
  @@index([repoOid, repositoryAccessMode, status])
  @@index([codeBucketOid])
  @@index([repoOid, sourceKey, baseBranch, oid])
  @@index([status])
  @@index([status, nextPollAt])
  @@index([supersededBySyncOid])
  @@index([createdAt])
}

model ScmRepositoryRemoteState {
  oid BigInt @id @default(autoincrement())

  sourceKey String
  branch    String

  commitSha  String
  treeSha    String
  listingKey String
  entryCount Int

  repoOid BigInt
  repo    ScmRepository @relation(fields: [repoOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([repoOid, sourceKey, branch])
  @@index([updatedAt])
  @@index([listingKey])
}

model ScmInstallation {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  provider ScmProvider

  backendOid BigInt
  backend    ScmBackend @relation(fields: [backendOid], references: [oid], onDelete: Cascade)

  ownerActorOid BigInt
  ownerActor    Actor  @relation(fields: [ownerActorOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  externalInstallationId String?
  accountType            ScmAccountType?

  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?

  tokensNebulaSecretId String?

  externalAccountId       String
  externalAccountLogin    String
  externalAccountName     String?
  externalAccountEmail    String?
  externalAccountImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  repos    ScmRepository[]
  sessions ScmInstallationSession[]

  @@unique([tenantOid, provider, backendOid, externalAccountId])
}

enum ScmRepositoryWebhookType {
  push
}

enum ScmRepositoryWebhookEvent {
  push
  pull_request
  pull_request_review
  ci_status
  ci_check
}

model ScmRepositoryWebhook {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type ScmRepositoryWebhookType

  repoOid BigInt        @unique
  repo    ScmRepository @relation(fields: [repoOid], references: [oid], onDelete: Cascade)

  externalId       String
  registeredEvents ScmRepositoryWebhookEvent[] @default([])

  signingSecret               String?
  signingSecretNebulaSecretId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  events ScmRepositoryWebhookReceivedEvent[]
}

model ScmRepositoryWebhookReceivedEvent {
  oid BigInt @id @default(autoincrement())

  webhookOid BigInt
  webhook    ScmRepositoryWebhook @relation(fields: [webhookOid], references: [oid], onDelete: Cascade)

  idempotencyKey String?

  eventType String
  payload   String

  createdAt DateTime @default(now())

  pushes ScmRepositoryPush[]

  @@unique([webhookOid, idempotencyKey])
  @@index([createdAt])
}

model ScmRepositoryPush {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  repoOid BigInt
  repo    ScmRepository @relation(fields: [repoOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  webhookReceivedEventOid BigInt?
  webhookReceivedEvent    ScmRepositoryWebhookReceivedEvent? @relation(fields: [webhookReceivedEventOid], references: [oid], onDelete: SetNull)
  webhookDispatchedAt     DateTime?

  pusherName       String?
  pusherEmail      String?
  senderIdentifier String?
  commitMessage    String?

  branchName String
  sha        String

  createdAt           DateTime             @default(now())
  changeNotifications ChangeNotification[]

  @@index([webhookReceivedEventOid])
}
