{
  "name": "@mtsrc/mcp-runtime-service",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "check-types": "tsc --noEmit -p tsconfig.server.json",
    "server:build": "bun run check-types && metorial-editions build ./src/server.ts --edition cloud --outfile ./dist/index.js && metorial-editions build ../packages/data-utils/src/jsonata/_worker.ts --edition cloud --outfile ./dist/_worker.ts",
    "sentry:sourcemaps": "(sentry-cli sourcemaps inject --org metorial --project mte-shuttle ./dist && sentry-cli sourcemaps upload --org metorial --project mte-shuttle ./dist) || true",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "dev": "bun \"$(ROOT=$(git rev-parse --show-toplevel); if [ -f \"$ROOT/scripts/dev-tools/src/cli.ts\" ]; then echo \"$ROOT/scripts/dev-tools/src/cli.ts\"; else echo \"$ROOT/oss/scripts/dev-tools/src/cli.ts\"; fi)\" watch-bun ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "infra:up": "docker compose -p shuttle -f ./docker-compose.dev.yml --profile infra up -d --pull always",
    "infra:down": "docker compose -p shuttle -f ./docker-compose.dev.yml --profile infra down",
    "infra:logs": "docker compose -p shuttle -f ./docker-compose.dev.yml --profile infra logs -f",
    "test": "vitest run --passWithNoTests --pool=forks --configLoader runner",
    "test:e2e": "metorial-e2e",
    "test:watch": "bunx vitest watch --configLoader runner",
    "typecheck": "bun run check-types",
    "dev:start": "bun --watch ./src/server.ts",
    "e2e:start": "bun ./src/server.ts"
  },
  "devDependencies": {
    "@metorial/e2e": "1.0.0",
    "@lowerdeck/testing-tools": "workspace:2.0.0",
    "@types/bun": "latest",
    "@types/node": "^25.9.9",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@lowerdeck/api-mux": "workspace:2.0.0",
    "@lowerdeck/doctor": "workspace:2.0.0",
    "@lowerdeck/queue": "workspace:2.0.0",
    "@lowerdeck/rpc-server": "workspace:2.0.0",
    "@lowerdeck/sentry": "workspace:2.0.0",
    "@lowerdeck/telemetry": "workspace:2.0.0",
    "@metorial/doctor": "workspace:*",
    "@metorial/editions": "workspace:*",
    "@mtsrc/mcp-runtime-api-connection": "workspace:*",
    "@mtsrc/mcp-runtime-api-internal": "workspace:*",
    "@mtsrc/mcp-runtime-api-public": "workspace:*",
    "@mtsrc/mcp-runtime-db": "workspace:*",
    "@mtsrc/mcp-runtime-env": "workspace:*",
    "@mtsrc/mcp-runtime-module-change-notifications": "workspace:*",
    "@mtsrc/mcp-runtime-module-connections": "workspace:*",
    "@mtsrc/mcp-runtime-module-deployments": "workspace:*",
    "@mtsrc/mcp-runtime-module-discovery": "workspace:*",
    "@mtsrc/mcp-runtime-module-oauth": "workspace:*",
    "@mtsrc/mcp-runtime-module-retention": "workspace:*",
    "@mtsrc/mcp-runtime-module-servers": "workspace:*",
    "@mtsrc/mcp-runtime-storage": "workspace:*",
    "@sentry/bun": "^11.11.0",
    "@sentry/cli": "^3.8.2"
  }
}
