enum SecretStatus {
  active
  deleted
}

enum SecretType {
  registry_credentials
  server_config_value
  oauth_connection_credentials
  oauth_token
}

model Secret {
  oid    BigInt       @id
  id     String       @unique
  type   SecretType
  status SecretStatus

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  encryptedSecret String

  isDelegatedToNebula Boolean @default(false)
  nebulaSecretId      String?

  createdAt DateTime @default(now())

  registries                         ContainerRegistry[]
  serverConfigs                      ServerConfig[]
  remoteOAuthConnections             RemoteOAuthConnection[]
  remoteOAuthConnectionAuthTokens    RemoteOAuthConnectionAuthToken[]
  delegatedOAuthConnections          DelegatedOAuthConnection[]
  delegatedOAuthConnectionAuthTokens DelegatedOAuthConnectionAuthToken[]
}
