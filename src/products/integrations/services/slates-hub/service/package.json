{
  "name": "@metorial/slates",
  "private": true,
  "main": "src/server.ts",
  "type": "commonjs",
  "scripts": {
    "start": "bun run server:start",
    "check-types": "tsc --noEmit -p tsconfig.server.json",
    "server:build": "bun run check-types && metorial-editions build ./src/server.ts --edition cloud --outfile ./dist/index.js",
    "sentry:sourcemaps": "(sentry-cli sourcemaps inject --org metorial --project mte-slates-hub ./dist && sentry-cli sourcemaps upload --org metorial --project mte-slates-hub ./dist) || true",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "dev": "bun \"$(ROOT=$(git rev-parse --show-toplevel); if [ -f \"$ROOT/scripts/dev-tools/src/cli.ts\" ]; then echo \"$ROOT/scripts/dev-tools/src/cli.ts\"; else echo \"$ROOT/oss/scripts/dev-tools/src/cli.ts\"; fi)\" watch-bun ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "infra:up": "docker compose -p slates-hub -f ./docker-compose.dev.yml --profile infra up -d",
    "infra:down": "docker compose -p slates-hub -f ./docker-compose.dev.yml --profile infra down",
    "infra:logs": "docker compose -p slates-hub -f ./docker-compose.dev.yml --profile infra logs -f",
    "infra:restart": "docker compose -p slates-hub -f ./docker-compose.dev.yml --profile infra restart",
    "test": "bun run test:unit",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts --passWithNoTests",
    "test:watch": "bunx vitest watch --config vitest.unit.config.ts",
    "typecheck": "bun run check-types && bun run admin:typecheck",
    "admin:typecheck": "tsc --noEmit --project admin/tsconfig.json",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:dev": "vite --config admin/vite.config.ts",
    "dev:start": "bun --watch ./src/server.ts",
    "e2e:start": "bun ./src/server.ts",
    "test:e2e": "metorial-e2e"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@lowerdeck/api-mux": "workspace:2.0.0",
    "@lowerdeck/doctor": "workspace:2.0.0",
    "@lowerdeck/error": "workspace:2.0.0",
    "@lowerdeck/hono": "workspace:2.0.0",
    "@lowerdeck/queue": "workspace:2.0.0",
    "@lowerdeck/rpc-client": "workspace:2.0.0",
    "@lowerdeck/sentry": "workspace:2.0.0",
    "@lowerdeck/telemetry": "workspace:2.0.0",
    "@metorial-io/data-hooks": "^1.0.1",
    "@metorial-io/layout": "^1.0.1",
    "@metorial-io/ui": "^1.0.0",
    "@metorial-io/ui-product": "^1.0.0",
    "@metorial-platform-systems/runtime-trust-publisher": "workspace:*",
    "@metorial/doctor": "workspace:*",
    "@metorial/editions": "workspace:*",
    "@metorial/service-init": "workspace:*",
    "@mtsrc/slates-hub-api-admin": "workspace:*",
    "@mtsrc/slates-hub-api-internal": "workspace:*",
    "@mtsrc/slates-hub-api-public": "workspace:*",
    "@mtsrc/slates-hub-db": "workspace:*",
    "@mtsrc/slates-hub-env": "workspace:*",
    "@mtsrc/slates-hub-module-callbacks": "workspace:*",
    "@mtsrc/slates-hub-module-catalog": "workspace:*",
    "@mtsrc/slates-hub-module-errors": "workspace:*",
    "@mtsrc/slates-hub-module-instances": "workspace:*",
    "@mtsrc/slates-hub-module-invocations": "workspace:*",
    "@mtsrc/slates-hub-module-retention": "workspace:*",
    "@mtsrc/slates-hub-module-trigger-routing": "workspace:*",
    "@mtsrc/slates-hub-module-triggers": "workspace:*",
    "@mtsrc/slates-hub-network": "workspace:*",
    "@mtsrc/slates-hub-storage": "workspace:*",
    "@remixicon/react": "^4.9.0",
    "@sentry/bun": "^11.12.0",
    "@sentry/cli": "^3.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.5",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@lowerdeck/testing-tools": "workspace:2.0.0",
    "@metorial/e2e": "1.0.0",
    "@types/bun": "latest",
    "@types/lodash": "^4.17.27",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "date-fns": "^4.4.0",
    "lodash": "4.18.1",
    "vite": "^7.3.7",
    "vitest": "5.0.4"
  }
}
