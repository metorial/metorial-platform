generator client {
  provider = "prisma-client"
  output   = "../generated"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

model GatewayToken {
  oid BigInt @id
  id  String @unique

  prefix     String @unique
  secretHash String

  name        String
  consumerRef String?

  allowedModels String[]

  /// [GatewayLimits]
  limits Json @default("[]")

  /// [GatewayTokenMetadata]
  metadata Json @default("{}")

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  @@index([organizationOid])
  @@index([instanceOid])
}

enum BillingWindowStatus {
  open
  complete
}

model BillingWindow {
  oid BigInt @id
  id  String @unique

  windowStart DateTime
  windowEnd   DateTime
  status      BillingWindowStatus @default(open)

  costNanoUsd  BigInt @default(0)
  requestCount Int    @default(0)
  revision     Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectOid BigInt
  project    Project @relation(fields: [projectOid], references: [oid])

  @@unique([projectOid, windowStart])
  @@index([windowStart, id])
  @@index([status, windowEnd])
}

model CatalogSync {
  oid BigInt @id
  id  String @unique

  url String @unique

  etag        String?
  fingerprint String?
  lastError   String?

  /// [CatalogSyncCounts]
  counts Json?

  generatedAt   DateTime?
  lastCheckedAt DateTime?
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum CatalogEntryStatus {
  active
  retired
}

model Lab {
  oid BigInt @id
  id  String @unique

  slug String @unique

  name        String
  description String?
  website     String?
  logo        String?

  status CatalogEntryStatus

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  models Model[]
}

enum ProviderKind {
  metorial
  first_party
  cloud
  inference
  aggregator
  subscription
  decision
}

model Provider {
  oid BigInt @id
  id  String @unique

  slug String @unique

  name    String
  kind    ProviderKind
  website String?
  docs    String?
  logo    String?

  status CatalogEntryStatus

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  offerings   ModelOffering[]
  connections ProviderConnection[]
}

enum ModelStatus {
  preview
  active
  deprecated
  retired
}

model Model {
  oid BigInt @id
  id  String @unique

  slug       String  @unique
  familySlug String?

  name        String
  description String?
  kind        String

  status      ModelStatus
  releaseDate DateTime?   @db.Date
  openWeights Boolean

  contextTokens    Int?
  outputTokens     Int?
  inputModalities  String[]
  outputModalities String[]

  /// [ModelCapabilities]
  capabilities Json

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  labOid BigInt
  lab    Lab    @relation(fields: [labOid], references: [oid])

  offerings ModelOffering[]
  aliases   ModelAlias[]

  @@index([labOid])
  @@index([status])
}

model ModelOffering {
  oid BigInt @id
  id  String @unique

  catalogId     String @unique
  vendorModelId String

  name   String
  status ModelStatus
  apis   String[]

  /// [Pricing]
  pricing     Json?
  pricingHash String?

  contextTokens    Int?
  outputTokens     Int?
  inputModalities  String[]
  outputModalities String[]

  /// [ModelCapabilities]
  capabilities Json

  /// [OfferingVariant]
  variant Json

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  providerOid BigInt
  provider    Provider @relation(fields: [providerOid], references: [oid])

  modelOid BigInt?
  model    Model?  @relation(fields: [modelOid], references: [oid])

  @@index([providerOid, vendorModelId])
  @@index([modelOid])
}

model ModelAlias {
  oid BigInt @id
  id  String @unique

  catalogId String @unique

  namespace String
  raw       String
  key       String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  modelOid BigInt
  model    Model  @relation(fields: [modelOid], references: [oid])

  @@index([raw])
  @@index([key])
  @@index([modelOid])
}

enum ProviderConnectionStatus {
  pending
  valid
  invalid
  disabled
}

model ProviderConnection {
  oid BigInt @id
  id  String @unique

  name        String
  description String?
  priority    Int     @default(0)

  /// [ProviderConnectionConfig]
  config Json @default("{}")

  /// [ProviderFeatures]
  features Json @default("{}")

  /// [ConnectionPricingOverride]
  pricingOverride Json?

  nebulaSecretId String
  credentialHint String?

  status              ProviderConnectionStatus @default(pending)
  statusMessage       String?
  consecutiveFailures Int                      @default(0)

  lastCheckedAt DateTime?
  lastValidAt   DateTime?
  nextCheckAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  providerOid BigInt
  provider    Provider @relation(fields: [providerOid], references: [oid])

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  @@index([instanceOid, status])
  @@index([organizationOid])
  @@index([providerOid])
  @@index([nextCheckAt])
}

model Organization {
  oid BigInt @id
  id  String @unique

  ref  String  @unique
  name String?

  nebulaTenantId String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projects            Project[]
  instances           Instance[]
  gatewayTokens       GatewayToken[]
  providerConnections ProviderConnection[]
  virtualModels       VirtualModel[]
}

model Project {
  oid BigInt @id
  id  String @unique

  ref  String  @unique
  name String?

  /// [PlatformLimits]
  platformLimits         Json      @default("[]")
  platformLimitsSyncedAt DateTime?

  disabledAt     DateTime?
  disabledReason String?

  billingRestrictedAt      DateTime?
  billingRestrictionReason String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  instances      Instance[]
  billingWindows BillingWindow[]

  @@index([organizationOid])
}

model Instance {
  oid BigInt @id
  id  String @unique

  ref  String  @unique
  name String?

  logRetentionDays Int @default(90)

  /// [InstanceSettings]
  settings Json @default("{}")

  /// [GatewayLimits]
  limits Json @default("[]")

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  projectOid BigInt
  project    Project @relation(fields: [projectOid], references: [oid])

  gatewayTokens       GatewayToken[]
  providerConnections ProviderConnection[]
  virtualModels       VirtualModel[]

  @@index([organizationOid])
  @@index([projectOid])
}

model VirtualModel {
  oid BigInt @id
  id  String @unique

  slug        String
  name        String
  description String?

  currentVersionOid BigInt?              @unique
  currentVersion    VirtualModelVersion? @relation("CurrentVersion", fields: [currentVersionOid], references: [oid])

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  versions VirtualModelVersion[] @relation("Versions")

  @@index([instanceOid, slug])
  @@index([organizationOid])
}

model VirtualModelVersion {
  oid BigInt @id
  id  String @unique

  number Int

  /// [VirtualModelDefinition]
  definition Json

  targetModelSlugs String[]

  createdAt DateTime @default(now())

  virtualModelOid BigInt
  virtualModel    VirtualModel @relation("Versions", fields: [virtualModelOid], references: [oid])

  currentOf VirtualModel? @relation("CurrentVersion")

  @@unique([virtualModelOid, number])
}
