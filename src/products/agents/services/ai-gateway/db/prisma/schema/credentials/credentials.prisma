enum ProviderConnectionStatus {
  pending
  valid
  invalid
  disabled
}

model ProviderConnection {
  oid BigInt @id
  id  String @unique

  name        String
  description String?
  priority    Int     @default(0)

  /// [ProviderConnectionConfig]
  config Json @default("{}")

  /// [ProviderFeatures]
  features Json @default("{}")

  /// [ConnectionPricingOverride]
  pricingOverride Json?

  nebulaSecretId String
  credentialHint String?

  status              ProviderConnectionStatus @default(pending)
  statusMessage       String?
  consecutiveFailures Int                      @default(0)

  lastCheckedAt DateTime?
  lastValidAt   DateTime?
  nextCheckAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  providerOid BigInt
  provider    Provider @relation(fields: [providerOid], references: [oid])

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  @@index([instanceOid, status])
  @@index([organizationOid])
  @@index([providerOid])
  @@index([nextCheckAt])
}
