{
  "name": "@mtsrc/agent-tracking-db",
  "version": "1.0.0",
  "private": true,
  "author": "Tobias Herber",
  "license": "FSL-1.1",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "prettier src/**/*.ts --check",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "bun prisma generate",
    "db:push:dev": "sh -c 'set -a; . ./.env; set +a; bun prisma db push --accept-data-loss'",
    "control:db:generate": "bun run prisma:generate",
    "control:db:push": "bun run prisma:push"
  },
  "dependencies": {
    "@lowerdeck/id": "workspace:2.0.0",
    "@lowerdeck/snowflake": "workspace:2.0.0",
    "@metorial/model-catalog": "workspace:*",
    "@mtsrc/agent-tracking-layers": "workspace:*",
    "@mtsrc/agent-tracking-rule-match": "workspace:*",
    "@mtsrc/agent-tracking-spec": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/extension-read-replicas": "^0.5.0",
    "prisma": "^7.10.1",
    "prisma-json-types-generator": "^5.2.0"
  },
  "devDependencies": {
    "@lowerdeck/testing-tools": "workspace:2.0.0",
    "@types/bun": "latest",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
