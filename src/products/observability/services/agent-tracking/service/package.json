{
  "name": "@mtsrc/agent-tracking-service",
  "version": "1.0.0",
  "private": true,
  "author": "Tobias Herber",
  "license": "FSL-1.1",
  "type": "commonjs",
  "scripts": {
    "start": "bun run server:start",
    "dev": "bun \"$(ROOT=$(git rev-parse --show-toplevel); if [ -f \"$ROOT/scripts/dev-tools/src/cli.ts\" ]; then echo \"$ROOT/scripts/dev-tools/src/cli.ts\"; else echo \"$ROOT/oss/scripts/dev-tools/src/cli.ts\"; fi)\" watch-bun ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only",
    "sentry:sourcemaps": "(sentry-cli sourcemaps inject --org metorial --project mte-agent-tracking ./dist && sentry-cli sourcemaps upload --org metorial --project mte-agent-tracking ./dist) || true",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "metorial-e2e",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "dev:start": "bun --watch ./src/server.ts",
    "e2e:start": "bun ./src/server.ts",
    "lint": "prettier src/**/*.ts --check"
  },
  "dependencies": {
    "@lowerdeck/queue": "workspace:2.0.0",
    "@lowerdeck/sentry": "workspace:2.0.0",
    "@lowerdeck/telemetry": "workspace:2.0.0",
    "@lowerdeck/validation": "workspace:2.0.0",
    "@metorial/settings": "workspace:*",
    "@mtsrc/agent-tracking-api-ingest": "workspace:*",
    "@mtsrc/agent-tracking-api-internal": "workspace:*",
    "@mtsrc/agent-tracking-db": "workspace:*",
    "@mtsrc/agent-tracking-module-attribution": "workspace:*",
    "@mtsrc/agent-tracking-module-classification": "workspace:*",
    "@mtsrc/agent-tracking-module-entities": "workspace:*",
    "@mtsrc/agent-tracking-module-erasure": "workspace:*",
    "@mtsrc/agent-tracking-module-identity": "workspace:*",
    "@mtsrc/agent-tracking-module-ingest": "workspace:*",
    "@mtsrc/agent-tracking-module-ingest-access": "workspace:*",
    "@mtsrc/agent-tracking-module-knowledge": "workspace:*",
    "@mtsrc/agent-tracking-module-rebuild": "workspace:*",
    "@mtsrc/agent-tracking-module-records": "workspace:*",
    "@mtsrc/agent-tracking-module-sessions": "workspace:*",
    "@mtsrc/agent-tracking-spec": "workspace:*",
    "@mtsrc/agent-tracking-store": "workspace:*",
    "@sentry/bun": "^11.9.0",
    "@sentry/cli": "^3.8.2"
  },
  "devDependencies": {
    "@lowerdeck/rpc-client": "workspace:2.0.0",
    "@lowerdeck/testing-tools": "workspace:2.0.0",
    "@metorial/control": "workspace:*",
    "@metorial/e2e": "1.0.0",
    "@metorial/model-catalog": "workspace:*",
    "@mtsrc/agent-tracking-db": "workspace:*",
    "@mtsrc/agent-tracking-module-scope": "workspace:*",
    "@mtsrc/agent-tracking-module-usage": "workspace:*",
    "@mtsrc/agent-tracking-redis": "workspace:*",
    "@mtsrc/agent-tracking-testing": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^25.9.9",
    "@vercel/ncc": "^0.45.0",
    "mongoose": "^9.11.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
