{
  "name": "@metorial-subspace/app-public",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun \"$(ROOT=$(git rev-parse --show-toplevel); if [ -f \"$ROOT/scripts/dev-tools/src/cli.ts\" ]; then echo \"$ROOT/scripts/dev-tools/src/cli.ts\"; else echo \"$ROOT/oss/scripts/dev-tools/src/cli.ts\"; fi)\" watch-bun ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "start:dev:server": "bun run dev",
    "start:dev:vite": "bun run frontend:watch",
    "start:dev": "bun run dev",
    "frontend:watch": "vite build --watch ./frontend",
    "dev:hmr": "vite ./frontend",
    "start": "bun ./src/server.ts",
    "build": "vite build ./frontend",
    "frontend:build": "vite build ./frontend",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "server:build": "bun run check-types && ncc build ./src/server.ts -o ./dist --source-map --external bun:sqlite --external bun --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "(sentry-cli sourcemaps inject --org metorial --project mte-subspace-frontend ./dist && sentry-cli sourcemaps upload --org metorial --project mte-subspace-frontend ./dist) || true",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@hono/zod-validator": "^0.7.6",
    "@hookform/resolvers": "^5.2.2",
    "@lowerdeck/api-key": "workspace:2.0.0",
    "@lowerdeck/api-mux": "workspace:2.0.0",
    "@lowerdeck/error": "workspace:2.0.0",
    "@lowerdeck/hono": "workspace:2.0.0",
    "@lowerdeck/rpc-server": "workspace:2.0.0",
    "@lowerdeck/validation": "workspace:2.0.0",
    "@metorial-io/data-hooks": "^1.0.1",
    "@metorial-io/pages": "^1.0.0",
    "@metorial-subspace/app-controller": "workspace:*",
    "@metorial-subspace/module-auth": "^1.0.0",
    "@metorial-subspace/module-integration": "^1.0.0",
    "@lowerdeck/telemetry": "workspace:2.0.0",
    "@metorial-subspace/module-tenant": "^1.0.0",
    "@metorial-subspace/presenters": "^1.0.0",
    "@metorial-subspace/provider-native": "^1.0.0",
    "@sentry/bun": "^10.34.0",
    "@sentry/cli": "^3.2.0",
    "@types/react-dom": "19.2.3",
    "@vercel/ncc": "^0.38.3",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "framer-motion": "^12.9.4",
    "react-router-dom": "^6.26.1",
    "semver": "^7.7.3",
    "snowflake-uuid": "^1.0.0",
    "styled-components": "^6.1.13",
    "unzipper": "^0.12.3",
    "vite": "^5.4.1",
    "yaml": "^2.8.2",
    "yup": "^1.7.1",
    "@lowerdeck/rpc-client": "workspace:2.0.0",
    "@lowerdeck/shadow-id": "workspace:2.0.0",
    "@lowerdeck/base62": "workspace:2.0.0",
    "@lowerdeck/sentry": "workspace:2.0.0",
    "@lowerdeck/env": "workspace:2.0.0"
  }
}