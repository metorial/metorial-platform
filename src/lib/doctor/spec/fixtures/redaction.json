[
  {
    "name": "plain values pass through",
    "input": { "host": "db.internal", "port": 5432, "tls": true, "region": null },
    "expected": { "host": "db.internal", "port": 5432, "tls": true, "region": null }
  },
  {
    "name": "url password",
    "input": "connect to postgres://metorial:hunter2@db.internal:5432/metorial_core failed",
    "expected": "connect to postgres://metorial:***@db.internal:5432/metorial_core failed"
  },
  {
    "name": "url with empty user",
    "input": "redis://:s3cr3t@valkey:6379/0",
    "expected": "redis://:***@valkey:6379/0"
  },
  {
    "name": "url user without password is kept",
    "input": "postgres://metorial@db.internal:5432/metorial_core",
    "expected": "postgres://metorial@db.internal:5432/metorial_core"
  },
  {
    "name": "query parameters",
    "input": "GET https://bucket.s3.amazonaws.com/a?X-Amz-Credential=AKIA123%2F2026&X-Amz-Signature=abcdef&versionId=7 403",
    "expected": "GET https://bucket.s3.amazonaws.com/a?X-Amz-Credential=***&X-Amz-Signature=***&versionId=7 403"
  },
  {
    "name": "query parameter names are matched exactly",
    "input": "https://example.com/?monkey=1&key=abc&tokens=2;token=xyz",
    "expected": "https://example.com/?monkey=1&key=***&tokens=2;token=***"
  },
  {
    "name": "url password and query together",
    "input": "mongodb://app:pw@mongo:27017/db?authSource=admin&password=again",
    "expected": "mongodb://app:***@mongo:27017/db?authSource=admin&password=***"
  },
  {
    "name": "bearer token",
    "input": "request with Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.e30.sig was rejected",
    "expected": "request with Authorization: Bearer *** was rejected"
  },
  {
    "name": "bearer keeps spelling and ignores short words",
    "input": "bearer abcdefghij, bearer token",
    "expected": "bearer ***, bearer token"
  },
  {
    "name": "pem block",
    "input": "bad key: -----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC\n-----END PRIVATE KEY----- end",
    "expected": "bad key: [redacted PRIVATE KEY] end"
  },
  {
    "name": "secret keys",
    "input": {
      "password": "hunter2",
      "dbPassword": "hunter2",
      "client_secret": "x",
      "secretAccessKey": "x",
      "sessionToken": "x",
      "api-key": 12345,
      "privateKey": { "kty": "OKP" },
      "Authorization": "Basic abc",
      "cookie": "a=b",
      "x-amz-signature": "x",
      "credentials": ["a", "b"],
      "pwd": "x",
      "pass": "x",
      "auth": "x",
      "secret": null
    },
    "expected": {
      "password": "***",
      "dbPassword": "***",
      "client_secret": "***",
      "secretAccessKey": "***",
      "sessionToken": "***",
      "api-key": "***",
      "privateKey": "***",
      "Authorization": "***",
      "cookie": "***",
      "x-amz-signature": "***",
      "credentials": "***",
      "pwd": "***",
      "pass": "***",
      "auth": "***",
      "secret": null
    }
  },
  {
    "name": "non-secret keys that look close",
    "input": {
      "keyId": "arn:aws:kms:eu-central-1:111122223333:key/abc",
      "accessKeyId": "AKIAEXAMPLE",
      "author": "x",
      "passive": "x",
      "fingerprint": "3f9a1c0b2e7d"
    },
    "expected": {
      "keyId": "arn:aws:kms:eu-central-1:111122223333:key/abc",
      "accessKeyId": "AKIAEXAMPLE",
      "author": "x",
      "passive": "x",
      "fingerprint": "3f9a1c0b2e7d"
    }
  },
  {
    "name": "nested values and arrays",
    "input": {
      "error": { "message": "redis://u:p@h:6379 refused", "code": "ECONNREFUSED" },
      "hosts": ["postgres://a:b@one", "two"]
    },
    "expected": {
      "error": { "message": "redis://u:***@h:6379 refused", "code": "ECONNREFUSED" },
      "hosts": ["postgres://a:***@one", "two"]
    }
  },
  {
    "name": "depth limit",
    "input": { "a": { "b": { "c": { "d": { "e": { "f": { "g": { "h": { "i": 1 } } } } } } } } },
    "expected": { "a": { "b": { "c": { "d": { "e": { "f": { "g": { "h": "[truncated]" } } } } } } } }
  },
  {
    "name": "depth limit applies to arrays",
    "input": [[[[[[[[[1]]]]]]]]],
    "expected": [[[[[[[["[truncated]"]]]]]]]]
  },
  {
    "name": "multi-byte characters are kept",
    "input": "Zugriff verweigert für Schlüssel ✓",
    "expected": "Zugriff verweigert für Schlüssel ✓"
  }
]
