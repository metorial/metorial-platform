{
  "name": "@metorial/slates-registry",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "server:build": "bun run check-types && ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "(sentry-cli sourcemaps inject --org metorial --project mte-slates-registry ./dist && sentry-cli sourcemaps upload --org metorial --project mte-slates-registry ./dist) || true",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "dev": "bun \"$(ROOT=$(git rev-parse --show-toplevel); if [ -f \"$ROOT/scripts/dev-tools/src/cli.ts\" ]; then echo \"$ROOT/scripts/dev-tools/src/cli.ts\"; else echo \"$ROOT/oss/scripts/dev-tools/src/cli.ts\"; fi)\" watch-bun ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "bun prisma generate --schema prisma/schema.prisma",
    "db:push:dev": "sh -c 'set -a; . ./.env; set +a; bun prisma db push --accept-data-loss'",
    "infra:dev": "docker compose -p slates-registry -f ./docker-compose.dev.yml up --pull always --build slates-registry object-storage",
    "infra:up": "docker compose -p slates-registry -f ./docker-compose.dev.yml up --pull always --build slates-registry object-storage",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:dev": "vite --config admin/vite.config.ts",
    "typecheck": "tsc --noEmit && bun run admin:typecheck",
    "admin:typecheck": "tsc --noEmit --project admin/tsconfig.json",
    "test:e2e": "bun ./e2e/reachability.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/minimatch": "^6.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/tar-stream": "^3.1.4",
    "@vercel/ncc": "^0.38.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "vite": "^5.4.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@hono/zod-validator": "^0.7.6",
    "@lowerdeck/api-key": "workspace:2.0.0",
    "@lowerdeck/api-mux": "workspace:2.0.0",
    "@lowerdeck/cache": "workspace:2.0.0",
    "@lowerdeck/canonicalize": "workspace:2.0.0",
    "@lowerdeck/cron": "workspace:2.0.0",
    "@lowerdeck/encryption": "workspace:2.0.0",
    "@lowerdeck/env": "workspace:2.0.0",
    "@lowerdeck/error": "workspace:2.0.0",
    "@lowerdeck/hash": "workspace:2.0.0",
    "@lowerdeck/hono": "workspace:2.0.0",
    "@lowerdeck/id": "workspace:2.0.0",
    "@lowerdeck/lock": "workspace:2.0.0",
    "@lowerdeck/once": "workspace:2.0.0",
    "@lowerdeck/pagination": "workspace:2.0.0",
    "@lowerdeck/queue": "workspace:2.0.0",
    "@lowerdeck/rpc-client": "workspace:2.0.0",
    "@lowerdeck/rpc-server": "workspace:2.0.0",
    "@lowerdeck/sentry": "workspace:2.0.0",
    "@lowerdeck/service": "workspace:2.0.0",
    "@lowerdeck/shadow-id": "workspace:2.0.0",
    "@lowerdeck/slugify": "workspace:2.0.0",
    "@lowerdeck/snowflake": "workspace:2.0.0",
    "@lowerdeck/validation": "workspace:2.0.0",
    "@metorial-io/data-hooks": "^1.0.1",
    "@metorial-io/layout": "^1.0.1",
    "@metorial-io/ui": "^1.0.0",
    "@metorial-io/ui-product": "^1.0.0",
    "@metorial-platform-systems/ares-client": "^1.0.0",
    "@metorial/util-endpoint": "^1.0.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@remixicon/react": "^4.0.0",
    "@sentry/bun": "^10.36.0",
    "@sentry/cli": "^3.2.0",
    "@types/semver": "^7.7.1",
    "@types/unzipper": "^0.10.11",
    "date-fns": "^4.1.0",
    "hono": "4.12.23",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.22",
    "object-storage-client": "^0.2.5",
    "prisma": "^7.2.0",
    "prisma-json-types-generator": "^4.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "^6.26.1",
    "semver": "^7.7.3",
    "styled-components": "^6.1.13",
    "tar-stream": "^3.1.8",
    "unzipper": "^0.12.3",
    "yaml": "^2.8.2",
    "@lowerdeck/delay": "workspace:2.0.0"
  }
}