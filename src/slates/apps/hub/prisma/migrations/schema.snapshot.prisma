generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

generator json {
  provider = "prisma-json-types-generator"
}

model Adapter {
  oid BigInt @id
  id  String @unique

  name       String
  identifier String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  slateAdapters        SlateAdapter[]
  slateVersionAdapters SlateVersionAdapter[]
  adapterCapabilities  AdapterCapability[]
}

model AdapterCapability {
  oid BigInt @id
  id  String @unique

  adapterOid BigInt
  adapter    Adapter @relation(fields: [adapterOid], references: [oid])

  identifier String

  createdAt DateTime @default(now())

  slateVersionAdapterCapabilities SlateVersionAdapterCapability[]

  @@unique([adapterOid, identifier])
}

model SlateAdapter {
  oid BigInt @id
  id  String @unique

  identifier String @unique

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid])

  adapterOid BigInt
  adapter    Adapter @relation(fields: [adapterOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  slateVersionAdapters SlateVersionAdapter[]
  slateActions         SlateAction[]

  @@unique([slateOid, adapterOid])
}

model SlateVersionAdapter {
  oid BigInt @id
  id  String @unique

  slateVersionOid BigInt
  slateVersion    SlateVersion @relation(fields: [slateVersionOid], references: [oid])

  adapterOid BigInt
  adapter    Adapter @relation(fields: [adapterOid], references: [oid])

  slateAdapterOid BigInt
  slateAdapter    SlateAdapter @relation(fields: [slateAdapterOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  slateVersionAdapterCapabilities SlateVersionAdapterCapability[]

  @@unique([slateVersionOid, adapterOid])
  @@unique([slateVersionOid, slateAdapterOid])
}

model SlateVersionAdapterCapability {
  oid BigInt @id
  id  String @unique

  slateVersionAdapterOid BigInt
  slateVersionAdapter    SlateVersionAdapter @relation(fields: [slateVersionAdapterOid], references: [oid])

  adapterCapabilityOid BigInt
  adapterCapability    AdapterCapability @relation(fields: [adapterCapabilityOid], references: [oid])

  /// [SlateAdapterCapabilityValue]
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([slateVersionAdapterOid, adapterCapabilityOid])
}

model AdminUser {
  oid BigInt @id
  id  String @unique

  email String @unique
  name  String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  oid BigInt @id
  id  String @unique

  token String @unique

  adminUserOid BigInt
  adminUser    AdminUser @relation(fields: [adminUserOid], references: [oid])

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([expiresAt])
}

model SlateAttachment {
  oid BigInt @id
  id  String @unique

  // Non-unique: many attachments can share the same digest - deduped via SlateAttachmentBlob.
  digest Bytes?

  tenantOid BigInt?
  tenant    Tenant? @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  authConfigOid BigInt?
  authConfig    SlateAuthConfig? @relation(fields: [authConfigOid], references: [oid], onDelete: SetNull)

  slateInstanceOid BigInt?
  slateInstance    SlateInstance? @relation(fields: [slateInstanceOid], references: [oid], onDelete: SetNull)

  targetUrl String?

  storageBucket String?
  storageKey    String?

  headers  Json?
  query    Json?
  mimeType String?

  refreshReference        Json?
  refreshAfter            DateTime?
  lastRefreshedAt         DateTime?
  refreshFailureCount     Int       @default(0)
  lastRefreshErrorCode    String?
  lastRefreshErrorMessage String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  slateInvocationAttachments SlateInvocationAttachment[]

  @@index([digest])
  @@index([expiresAt])
  @@index([refreshAfter])
}

model SlateAttachmentBlob {
  oid BigInt @id
  id  String @unique

  digest Bytes @unique

  storageBucket String
  storageKey    String

  mimeType  String?
  sizeBytes Int?

  createdAt DateTime @default(now())
}

model SlateAttachmentUpload {
  oid BigInt @id
  id  String @unique

  invocationOid BigInt
  invocation    SlateInvocation @relation(fields: [invocationOid], references: [oid], onDelete: Cascade)

  mimeType String?
  filename String?

  sizeBytes Int?

  status String @default("pending")

  storageBucket String
  storageKey    String

  createdAt DateTime @default(now())
  expiresAt DateTime // signed upload URL expiry

  @@index([expiresAt, status])
  @@index([invocationOid])
}

enum CallbackStatus {
  active
  deleted
}

model Callback {
  oid    BigInt         @id
  id     String         @unique
  status CallbackStatus @default(active)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid], onDelete: Cascade)

  name        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  instances CallbackInstance[]

  @@index([tenantOid, createdAt])
  @@index([slateOid])
}

enum CallbackInstanceStatus {
  active
  deleted
}

model CallbackInstance {
  oid    BigInt                 @id
  id     String                 @unique
  status CallbackInstanceStatus @default(active)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  callbackOid BigInt
  callback    Callback @relation(fields: [callbackOid], references: [oid], onDelete: Cascade)

  triggerRegistrationOid BigInt              @unique
  triggerRegistration    TriggerRegistration @relation(fields: [triggerRegistrationOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([callbackOid, createdAt])
  @@index([tenantOid, createdAt])
}

enum ChangeNotificationType {
  slate_version_created
}

model ChangeNotification {
  oid BigInt @id
  id  String @unique

  type ChangeNotificationType

  // Denormalized for easier querying
  slateId        String
  slateVersionId String?

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid])

  slateVersionOid BigInt?
  slateVersion    SlateVersion? @relation(fields: [slateVersionOid], references: [oid])

  createdAt DateTime @default(now())

  @@index([type])
}

enum SlateErrorType {
  tool_call_failed
  config_validation_failed
  auth_processing_failed
  oauth_token_refresh_failed
  oauth_setup_failed
  profile_fetch_failed
  attachment_refresh_failed
}

model SlateError {
  oid BigInt @id
  id  String @unique

  type SlateErrorType

  errorCode    String
  errorMessage String

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  slateOid BigInt?
  slate    Slate?  @relation(fields: [slateOid], references: [oid], onDelete: Cascade)

  slateVersionOid BigInt?
  slateVersion    SlateVersion? @relation(fields: [slateVersionOid], references: [oid], onDelete: Cascade)

  slateInstanceOid BigInt?
  slateInstance    SlateInstance? @relation(fields: [slateInstanceOid], references: [oid], onDelete: Cascade)

  invocationOid BigInt?
  invocation    SlateInvocation? @relation(fields: [invocationOid], references: [oid], onDelete: Cascade)

  toolCallOid BigInt?
  toolCall    SlateSessionToolCall? @relation(fields: [toolCallOid], references: [oid], onDelete: Cascade)

  sessionOid BigInt?
  session    SlateSession? @relation(fields: [sessionOid], references: [oid], onDelete: Cascade)

  authConfigOid BigInt?
  authConfig    SlateAuthConfig? @relation(fields: [authConfigOid], references: [oid], onDelete: Cascade)

  instanceConfigOid BigInt?
  instanceConfig    SlateInstanceConfig? @relation(fields: [instanceConfigOid], references: [oid], onDelete: Cascade)

  oauthSetupOid BigInt?
  oauthSetup    SlateInstanceOAuthSetup? @relation(fields: [oauthSetupOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([tenantOid, createdAt])
  @@index([slateOid, createdAt])
}

model Hub {
  oid BigInt @id
  id  String @unique

  internalIdentifier String @unique
  identifier         String @unique

  createdAt DateTime @default(now())
}

model SlateInstance {
  oid BigInt @id
  id  String @unique

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  lockedSlateVersionOid BigInt?
  lockedSlateVersion    SlateVersion? @relation(fields: [lockedSlateVersionOid], references: [oid], onDelete: Cascade)

  currentConfigOid BigInt?
  currentConfig    SlateInstanceConfig? @relation(fields: [currentConfigOid], references: [oid], name: "currentConfig")

  defaultAuthConfigOid BigInt?
  defaultAuthConfig    SlateAuthConfig? @relation(fields: [defaultAuthConfigOid], references: [oid], name: "defaultAuthConfig")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  configs              SlateInstanceConfig[]
  authConfigs          SlateAuthConfig[]
  events               SlateInstanceEvent[]
  oAuthSetups          SlateInstanceOAuthSetup[]
  usedAuthConfig       SlateAuthConfigUsedForInstance[]
  slateSessions        SlateSession[]
  slateErrors          SlateError[]
  triggerRegistrations TriggerRegistration[]
  slateAttachments     SlateAttachment[]
}

model SlateInstanceConfiguration {
  oid BigInt @id
  id  String @unique

  enclaveId String

  /// [CompiledEgressNetworkAllowList]
  egressPolicy Json

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  slateSessions            SlateSession[]
  slateInstanceOAuthSetups SlateInstanceOAuthSetup[]
}

enum SlateInstanceEventType {
  slate_instance_created
  slate_config_set
  slate_auth_config_set_default
  slate_auth_credentials_updated
  slate_version_locked
  slate_version_changed
}

model SlateInstanceEvent {
  oid  BigInt                 @id
  id   String                 @unique
  type SlateInstanceEventType

  payload Json

  instanceOid BigInt
  instance    SlateInstance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantOid, createdAt])
}

model SlateInstanceConfig {
  oid BigInt @id
  id  String @unique

  instanceOid BigInt
  instance    SlateInstance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  schemaOid BigInt
  schema    SlateConfigSchema @relation(fields: [schemaOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  errorCode         String?
  errorMessage      String?
  errorInvocationId String?

  /// [AnyRecord]
  value Json

  createdAt DateTime @default(now())

  currentConfigForInstances SlateInstance[]       @relation(name: "currentConfig")
  slateErrors               SlateError[]
  triggerRegistrations      TriggerRegistration[]
}

model SlateOAuthCredentials {
  oid BigInt @id
  id  String @unique

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  clientId String
  scopes   String[]

  secretOid BigInt
  secret    Secret @relation(fields: [secretOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  authConfigs          SlateAuthConfig[]
  oAuthSetups          SlateInstanceOAuthSetup[]
  webhookRegistrations SlateWebhookRegistrationOAuthCredentials[]
}

enum SlateAuthConfigType {
  manual
  oauth_automated
  oauth_manual
}

model SlateAuthConfig {
  oid  BigInt              @id
  id   String              @unique
  type SlateAuthConfigType

  isProcessing Boolean

  errorCode         String?
  errorMessage      String?
  errorInvocationId String?

  tokenExpiresAt DateTime?

  grantedScopes String[]

  /// [AuthProfile]
  profile      Json?
  profileUid   String?
  profileEmail String?
  profileName  String?

  /// [TriggerRawEventMatchers]
  routingMatchers Json?

  instanceOid BigInt?
  instance    SlateInstance? @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid], onDelete: Cascade)

  authMethodOid BigInt
  authMethod    SlateAuthMethod @relation(fields: [authMethodOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  oauthCredentialsOid BigInt?
  oauthCredentials    SlateOAuthCredentials? @relation(fields: [oauthCredentialsOid], references: [oid])

  secretOid BigInt
  secret    Secret @relation(fields: [secretOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  defaultForInstances           SlateInstance[]                  @relation(name: "defaultAuthConfig")
  slateInstanceOAuthSetups      SlateInstanceOAuthSetup[]
  usingInstances                SlateAuthConfigUsedForInstance[]
  slateAuthConfigEvents         SlateAuthConfigEvent[]
  slateAuthConfigManualDecrypts SlateAuthConfigManualDecrypt[]
  slateErrors                   SlateError[]
  triggerRegistrations          TriggerRegistration[]
  slateAttachments              SlateAttachment[]

  @@index([slateOid, profileUid])
}

model SlateAuthConfigManualDecrypt {
  oid BigInt @id

  configOid BigInt
  config    SlateAuthConfig @relation(fields: [configOid], references: [oid], onDelete: Cascade)

  note String

  createdAt DateTime @default(now())
}

model SlateAuthConfigUsedForInstance {
  oid BigInt @id

  configOid BigInt
  config    SlateAuthConfig @relation(fields: [configOid], references: [oid])

  instanceOid BigInt
  instance    SlateInstance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([configOid, instanceOid])
}

enum SlateAuthConfigEventType {
  oauth_token_refresh_completed
  oauth_token_refresh_failed
}

model SlateAuthConfigEvent {
  oid  BigInt                   @id
  id   String?                  @unique
  type SlateAuthConfigEventType

  configOid BigInt
  config    SlateAuthConfig @relation(fields: [configOid], references: [oid], onDelete: Cascade)

  invocationOid BigInt?
  invocation    SlateInvocation? @relation(fields: [invocationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([configOid, createdAt])
}

enum SlateInstanceOAuthSetupStatus {
  unused
  opened
  completed
  failed
}

model SlateInstanceOAuthSetup {
  oid    BigInt                        @id
  id     String                        @unique
  status SlateInstanceOAuthSetupStatus @default(unused)

  redirectUrl         String
  callbackUrlOverride String?

  isAdminSetup      Boolean @default(false)
  adminInstructions String?

  errorCode    String?
  errorMessage String?

  oauthCredentialsOid BigInt
  oauthCredentials    SlateOAuthCredentials @relation(fields: [oauthCredentialsOid], references: [oid])

  authMethodOid BigInt
  authMethod    SlateAuthMethod @relation(fields: [authMethodOid], references: [oid])

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  slateVersionOid BigInt
  slateVersion    SlateVersion @relation(fields: [slateVersionOid], references: [oid])

  slateInstanceOid BigInt?
  slateInstance    SlateInstance? @relation(fields: [slateInstanceOid], references: [oid])

  slateAuthConfigOid BigInt?
  slateAuthConfig    SlateAuthConfig? @relation(fields: [slateAuthConfigOid], references: [oid])

  instanceConfigurationOid BigInt?
  instanceConfiguration    SlateInstanceConfiguration? @relation(fields: [instanceConfigurationOid], references: [oid])

  secretOid BigInt
  secret    Secret @relation(fields: [secretOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  events      SlateInstanceOAuthSetupEvent[]
  slateErrors SlateError[]
}

enum SlateInstanceOAuthSetupEventType {
  setup_link_opened
  get_authorization_url
  exchange_authorization_code
  access_token_received
  oauth_setup_completed
  oauth_setup_failed
}

model SlateInstanceOAuthSetupEvent {
  oid  BigInt                           @id
  id   String?                          @unique
  type SlateInstanceOAuthSetupEventType

  setupOid BigInt
  setup    SlateInstanceOAuthSetup @relation(fields: [setupOid], references: [oid], onDelete: Cascade)

  invocationOid BigInt?
  invocation    SlateInvocation? @relation(fields: [invocationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([setupOid, createdAt])
}

model SlateInvocationStorageBucket {
  oid              Int               @id
  bucket           String            @unique
  slateInvocations SlateInvocation[]
}

model SlateInvocation {
  oid BigInt @id
  id  String @unique

  isPending          Boolean
  hasResponseError   Boolean @default(false)
  hasInvocationError Boolean @default(false)

  providerInvocationId String

  deploymentOid BigInt
  deployment    SlateDeployment @relation(fields: [deploymentOid], references: [oid])

  bucketOid Int
  bucket    SlateInvocationStorageBucket @relation(fields: [bucketOid], references: [oid])

  createdAt DateTime @default(now())

  slateVersionDiscoveries                  SlateVersionDiscovery[]
  slateInstanceOAuthSetupEvents            SlateInstanceOAuthSetupEvent[]
  slateAuthConfigEvents                    SlateAuthConfigEvent[]
  slateSessionToolCalls                    SlateSessionToolCall[]
  slatePublicToolCalls                     SlatePublicToolCall[]
  slateInvocationAttachment                SlateInvocationAttachment[]
  slateErrors                              SlateError[]
  slateWebhookEventInvocations             SlateWebhookEventInvocation[]
  triggerPollingRuns                       TriggerPollingRun[]
  triggerWebhookTargetRegistrationAttempts TriggerWebhookTargetRegistrationAttempt[]
  triggerEventInvocations                  TriggerEventInvocation[]
  slateAttachmentUploads                   SlateAttachmentUpload[]

  @@index([deploymentOid, createdAt])
}

model SlateInvocationAttachment {
  oid BigInt @id
  id  String @unique

  invocationOid BigInt
  invocation    SlateInvocation @relation(fields: [invocationOid], references: [oid], onDelete: Cascade)

  attachmentsOid BigInt
  attachments    SlateAttachment @relation(fields: [attachmentsOid], references: [oid])

  createdAt DateTime @default(now())
}

enum RegistryStatus {
  active
  disabled
}

model Registry {
  oid    BigInt         @id
  id     String         @unique
  status RegistryStatus

  isPredefined Boolean

  identifier String @unique

  name String
  url  String

  encryptedReaderToken     String?
  changeNotificationCursor String?

  tenantOid BigInt?
  tenant    Tenant? @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  lastSyncedAt DateTime?

  slates        Slate[]
  registrySyncs RegistrySync[]
  slateVersions SlateVersion[]

  @@unique([tenantOid, url])
}

model RegistrySync {
  oid BigInt @id
  id  String @unique

  registryOid BigInt
  registry    Registry @relation(fields: [registryOid], references: [oid], onDelete: Cascade)

  slatesSyncedIds        String[]
  slateVersionsSyncedIds String[]

  createdAt DateTime @default(now())
}

enum SecretStatus {
  active
  deleted
}

enum SecretType {
  slate_authentication_configuration
  slate_oauth_credentials
  slate_oauth_setup
  slate_webhook_registration_payload
}

model Secret {
  oid    BigInt       @id
  id     String       @unique
  type   SecretType
  status SecretStatus

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  encryptedSecret String

  isDelegatedToNebula Boolean @default(false)
  nebulaSecretId      String?

  createdAt DateTime @default(now())

  slateAuthConfigs          SlateAuthConfig[]
  slateOAuthCredentials     SlateOAuthCredentials[]
  slateInstanceOAuthSetups  SlateInstanceOAuthSetup[]
  slateWebhookRegistrations SlateWebhookRegistration[]
}

enum SlateStatus {
  active
  inactive
}

model Slate {
  oid    BigInt      @id
  id     String      @unique
  status SlateStatus

  identifier  String  @unique
  name        String
  description String?

  registryOid BigInt
  registry    Registry @relation(fields: [registryOid], references: [oid], onDelete: Cascade)

  currentVersionOid BigInt?
  currentVersion    SlateVersion? @relation(fields: [currentVersionOid], references: [oid], name: "currentVersion")

  slateScopeIdentifierOnRegistry String
  slateScopeIdOnRegistry         String

  slateFullIdentifierOnRegistry String
  slateIdentifierOnRegistry     String
  slateIdOnRegistry             String

  slateVersions    SlateVersion[]
  slateDeployments SlateDeployment[]

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt
  slateSpecifications       SlateSpecification[]
  slateAuthMethods          SlateAuthMethod[]
  slateConfigSchemas        SlateConfigSchema[]
  slateSpecificationChanges SlateSpecificationChange[]
  slateActions              SlateAction[]
  slateEvents               SlateEvent[]
  slateInstances            SlateInstance[]
  slateOAuthCredentials     SlateOAuthCredentials[]
  slateInstanceOAuthSetups  SlateInstanceOAuthSetup[]
  slateAuthConfigs          SlateAuthConfig[]
  slateSessions             SlateSession[]
  slatePublicToolCalls      SlatePublicToolCall[]
  changeNotifications       ChangeNotification[]
  slateErrors               SlateError[]
  slateAdapters             SlateAdapter[]
  slateTriggerGroups        SlateTriggerGroup[]
  slateWebhookRegistrations SlateWebhookRegistration[]
  triggerRegistrations      TriggerRegistration[]
  callbacks                 Callback[]

  @@unique([registryOid, slateIdOnRegistry])
  @@unique([registryOid, slateFullIdentifierOnRegistry])
}

enum SlateVersionStatus {
  active
  unavailable
  pending
  deploying
  discovering
  deployment_failed
  discovery_failed
}

model SlateVersion {
  oid    BigInt             @id
  id     String             @unique
  status SlateVersionStatus

  isCurrent     Boolean
  willBeCurrent Boolean

  version String

  versionIdOnRegistry         String
  versionIdentifierOnRegistry String

  /// [SlateJson]
  manifest Json

  /// [SlateDeploymentProviderDeploymentInfo]
  providerDeploymentInfo Json @default("null")

  /// [SlateCapabilities]
  capabilities Json @default("{}")

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid])

  registryOid BigInt
  registry    Registry @relation(fields: [registryOid], references: [oid], onDelete: Cascade)

  activeDeploymentOid BigInt?
  activeDeployment    SlateDeployment? @relation(fields: [activeDeploymentOid], references: [oid], name: "activeDeployment")

  specificationOid BigInt?
  specification    SlateSpecification? @relation(fields: [specificationOid], references: [oid])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  lastDiscoveredAt DateTime?

  currentInSlates            Slate[]                    @relation("currentVersion")
  slateDeployments           SlateDeployment[]
  slateVersionDiscoveries    SlateVersionDiscovery[]
  slateSpecificationChanges1 SlateSpecificationChange[] @relation("fromVersion")
  slateSpecificationChanges2 SlateSpecificationChange[] @relation("toVersion")
  slateEvents                SlateEvent[]
  slateSpecifications        SlateSpecification[]       @relation("mostRecentSpecificationVersion")
  slateInstances             SlateInstance[]
  slateInstanceOAuthSetups   SlateInstanceOAuthSetup[]
  slateSessions              SlateSession[]
  slateSessionToolCalls      SlateSessionToolCall[]
  slatePublicToolCalls       SlatePublicToolCall[]
  changeNotifications        ChangeNotification[]
  slateErrors                SlateError[]
  slateVersionAdapters       SlateVersionAdapter[]

  @@unique([slateOid, version])
}

enum SlateAuthMethodType {
  oauth
  token
  service_account
  custom
}

model SlateAuthMethod {
  oid  BigInt              @id
  id   String              @unique
  type SlateAuthMethodType

  identifier String @unique
  hash       String

  key  String
  name String

  /// [SlateAuthMethod]
  spec Json

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid])

  mostRecentSpecificationOid BigInt
  mostRecentSpecification    SlateSpecification @relation(fields: [mostRecentSpecificationOid], references: [oid])

  createdAt DateTime @default(now())

  slateSpecifications      SlateSpecificationAuthMethod[]
  slateAuthConfigs         SlateAuthConfig[]
  slateInstanceOAuthSetups SlateInstanceOAuthSetup[]
  webhookRegistrations     SlateWebhookRegistrationAuthMethod[]
}

model SlateSpecificationAuthMethod {
