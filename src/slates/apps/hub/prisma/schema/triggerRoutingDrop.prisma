enum TriggerRoutingDropReason {
  no_matcher
  no_match
  registration_inactive
  registration_not_matchable
  no_subscribers
}

model TriggerRoutingDrop {
  oid    BigInt                   @id
  id     String                   @unique
  reason TriggerRoutingDropReason

  // Not set for global registrations
  tenantOid BigInt?
  tenant    Tenant? @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  webhookRegistrationOid BigInt
  webhookRegistration    SlateWebhookRegistration @relation(fields: [webhookRegistrationOid], references: [oid], onDelete: Cascade)

  triggerGroupOid BigInt
  triggerGroup    SlateTriggerGroup @relation(fields: [triggerGroupOid], references: [oid], onDelete: Cascade)

  bucketStart DateTime
  count       Int      @default(0)

  /// [TriggerRawEventMatchers]
  lastMatchers Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([webhookRegistrationOid, reason, bucketStart])
  @@index([tenantOid, bucketStart])
  @@index([triggerGroupOid, bucketStart])
  @@index([bucketStart])
}
