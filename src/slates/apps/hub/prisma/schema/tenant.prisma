model Tenant {
  oid BigInt @id
  id  String @unique

  identifier String @unique
  name       String

  signalTenantId              String? @unique
  nebulaTenantId              String?
  functionBayTenantId         String?
  functionBayTenantIdentifier String?

  logRetentionInDays Int @default(30)

  createdAt DateTime @default(now())

  secrets                         Secret[]
  registries                      Registry[]
  slateInstances                  SlateInstance[]
  slateOAuthCredentials           SlateOAuthCredentials[]
  slateAuthConfigs                SlateAuthConfig[]
  slateCallbackConfigs            SlateCallbackConfig[]
  slateInstanceOAuthSetups        SlateInstanceOAuthSetup[]
  slateInstanceConfigs            SlateInstanceConfig[]
  slateInstanceEvents             SlateInstanceEvent[]
  slateSessions                   SlateSession[]
  slateTriggerDestinations        SlateTriggerDestination[]             @ignore
  slateTriggerReceivers           SlateTriggerReceiver[]
  slateTriggerReceiverPathSecrets SlateTriggerReceiverPathSecret[]
  slateTriggerReceiverSecrets     SlateTriggerReceiverSecret[]
  provisionedTenantAppProjections SlateProvisionedTenantAppProjection[]
  slateErrors                     SlateError[]
  slateInstanceConfigurations     SlateInstanceConfiguration[]
}
