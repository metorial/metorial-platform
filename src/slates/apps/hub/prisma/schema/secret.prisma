enum SecretStatus {
  active
  deleted
}

enum SecretType {
  slate_authentication_configuration
  slate_oauth_credentials
  slate_oauth_setup
  slate_callback_path
  slate_callback_value
  slate_callback_registration
}

model Secret {
  oid    BigInt       @id
  id     String       @unique
  type   SecretType
  status SecretStatus

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  encryptedSecret String

  isDelegatedToNebula Boolean @default(false)
  nebulaSecretId      String?

  createdAt DateTime @default(now())

  slateAuthConfigs           SlateAuthConfig[]
  slateOAuthCredentials      SlateOAuthCredentials[]
  slateInstanceOAuthSetups   SlateInstanceOAuthSetup[]
  receiverPathSecret         SlateTriggerReceiverPathSecret? @relation("receiverPathSecret")
  receiverCallbackSecret     SlateTriggerReceiverSecret?     @relation("receiverCallbackSecret")
  triggerRegistrationDetails SlateTriggerReceiverTrigger?    @relation("triggerRegistrationDetails")
}
