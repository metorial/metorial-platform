{
  "name": "@lowerdeck/once",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/**",
    "dist/**",
    "README.md",
    "package.json"
  ],
  "author": "Tobias Herber",
