# generated by control bootstrap
FROM oven/bun:1.2 AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/ ./
RUN bun install --linker=hoisted
FROM deps AS build
WORKDIR /app
COPY _inputs/ ./
RUN cd /app && bun x nx run-many --target=prisma:generate --projects=@metorial/voyager
RUN cd /app && bun x nx run @metorial/voyager:server:build
FROM build AS workspace
WORKDIR /app/src/systems/voyager/service
CMD ["sleep", "infinity"]
FROM oven/bun:1.2-alpine AS runner
WORKDIR /app
RUN apk add --no-cache curl
COPY --from=build /app/src/systems/voyager/service/dist /app/dist
COPY --from=build /app/src/systems/voyager/service/prisma /app/prisma
COPY --from=build /app/src/systems/voyager/service/prisma.config.ts /app/prisma.config.ts
COPY --from=build /app/node_modules /app/node_modules
ENV NODE_ENV="production"
EXPOSE 52060
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:52060/metorial-voyager && curl -f http://localhost:12121/ || exit 1
CMD ["sh", "-c", "bun prisma db push --accept-data-loss && bun /app/dist/index.js"]
