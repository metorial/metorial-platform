# generated by control bootstrap
FROM oven/bun:1.2-alpine AS deps
WORKDIR /app
RUN apk add --no-cache go git ca-certificates
COPY oss/src/systems/origin/apps/code-bucket/go.mod ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-bucket/go.sum ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-bucket/package.json ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-workspace/extensions/memfs/package.json ./oss/src/systems/origin/apps/code-workspace/extensions/memfs/
COPY oss/src/systems/origin/apps/code-workspace/package.json ./oss/src/systems/origin/apps/code-workspace/
RUN go mod download
FROM deps AS build
WORKDIR /app
COPY oss/src/systems/origin/apps/code-bucket/cmd ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-bucket/gen ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-bucket/index.ts ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-bucket/internal ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-bucket/pkg ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-bucket/proto ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-bucket/scripts ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-bucket/ts-proto-gen ./oss/src/systems/origin/apps/code-bucket/
COPY oss/src/systems/origin/apps/code-workspace ./oss/src/systems/origin/apps/
COPY oss/src/systems/origin/scripts/build-code-workspace.sh ./oss/src/systems/origin/scripts/
RUN cd /app/oss/src/systems/origin/apps/code-bucket && sh ../../scripts/build-code-workspace.sh
RUN cd /app/oss/src/systems/origin/apps/code-bucket && CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /tmp/code-bucket ./cmd/server
FROM build AS workspace
WORKDIR /app/oss/src/systems/origin/apps/code-bucket
CMD ["sleep", "infinity"]
FROM alpine:latest AS runner
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata netcat-openbsd
COPY --from=build /tmp/code-bucket /app/code-bucket
EXPOSE 52091
EXPOSE 52092
EXPOSE 5050
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD nc -z localhost 52091 || exit 1
CMD ["/app/code-bucket"]
