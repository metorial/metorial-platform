{
  "name": "@metorial/origin",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "enterprise:dev": "bun --watch ./src/server.ts",
    "start": "bun run server:start",
    "check-types": "tsc --noEmit -p tsconfig.server.json",
    "server:build": "bun run check-types && ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-origin ./dist && sentry-cli sourcemaps upload --org metorial --project mte-origin ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "prisma:push": "bun prisma db push --accept-data-loss",
    "prisma:generate": "bun prisma generate",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@vercel/ncc": "^0.38.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "vitest": "^4.0.16",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@gitbeaker/rest": "^43.8.0",
    "@grpc/grpc-js": "^1.13.4",
    "@octokit/auth-app": "^8.1.2",
    "@octokit/core": "^7.0.6",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "ipaddr.js": "^2.3.0",
    "jszip": "^3.10.1",
    "long": "^5.3.2",
    "nice-grpc": "^2.1.12",
    "@metorial-platform-systems/object-storage-client": "workspace:*",
    "pg": "^8.18.0",
    "prisma": "^7.4.1",
    "prisma-json-types-generator": "^4.0.1",
    "protobufjs": "^7.5.3",
    "yaml": "^2.8.2",
    "@mtsrc/api-mux": "1.0.0",
    "@mtsrc/cache": "1.0.0",
    "@mtsrc/canonicalize": "1.0.0",
    "@mtsrc/cron": "1.0.0",
    "@mtsrc/delay": "1.0.0",
    "@mtsrc/encryption": "1.0.0",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/hash": "1.0.0",
    "@mtsrc/hono": "1.0.0",
    "@mtsrc/id": "1.0.0",
    "@mtsrc/once": "1.0.0",
    "@mtsrc/pagination": "1.0.0",
    "@mtsrc/queue": "1.0.0",
    "@mtsrc/rpc-client": "1.0.0",
    "@mtsrc/rpc-server": "1.0.0",
    "@mtsrc/sentry": "1.0.0",
    "@mtsrc/service": "1.0.0",
    "@mtsrc/slugify": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/telemetry": "1.0.0",
    "@mtsrc/validation": "1.0.0"
  }
}
