{
  "name": "origin-service",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "enterprise:dev": "bun --watch ./src/server.ts",
    "start": "bun run server:start",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-origin ./dist && sentry-cli sourcemaps upload --org metorial --project mte-origin ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "prisma:push": "bun prisma db push --accept-data-loss",
    "prisma:generate": "bun prisma generate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@vercel/ncc": "^0.38.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@gitbeaker/rest": "^43.8.0",
    "@grpc/grpc-js": "^1.13.4",
    "@lowerdeck/api-mux": "^1.0.2",
    "@lowerdeck/cache": "^1.0.1",
    "@lowerdeck/canonicalize": "^1.0.4",
    "@lowerdeck/cron": "^1.0.7",
    "@lowerdeck/delay": "^1.0.4",
    "@lowerdeck/encryption": "^1.0.7",
    "@lowerdeck/env": "^1.0.4",
    "@lowerdeck/error": "^1.1.0",
    "@lowerdeck/hash": "^1.0.4",
    "@lowerdeck/hono": "^1.0.7",
    "@lowerdeck/id": "^1.0.6",
    "@lowerdeck/once": "^1.0.4",
    "@lowerdeck/pagination": "^1.0.5",
    "@lowerdeck/queue": "^1.0.7",
    "@lowerdeck/rpc-client": "^1.1.0",
    "@lowerdeck/rpc-server": "^1.0.7",
    "@lowerdeck/sentry": "^1.0.2",
    "@lowerdeck/service": "^1.0.3",
    "@lowerdeck/slugify": "^1.0.5",
    "@lowerdeck/snowflake": "^1.0.2",
    "@lowerdeck/validation": "^1.0.4",
    "@metorial-services/forge-client": "^1.0.3",
    "@octokit/auth-app": "^8.1.2",
    "@octokit/core": "^7.0.6",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "ipaddr.js": "^2.3.0",
    "jszip": "^3.10.1",
    "long": "^5.3.2",
    "nice-grpc": "^2.1.12",
    "object-storage-client": "^0.2.5",
    "pg": "^8.18.0",
    "prisma": "^7.4.1",
    "prisma-json-types-generator": "^4.0.1",
    "protobufjs": "^7.5.3",
    "yaml": "^2.8.2"
  }
}