{
  "name": "forge",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-forge ./dist && sentry-cli sourcemaps upload --org metorial --project mte-forge ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "dev": "bun --watch ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "dev:docker": "docker compose -p forge -f ./docker-compose.dev.yml --profile infra --profile service up -d --pull always --build",
    "infra:up": "docker compose -p forge -f ./docker-compose.dev.yml --profile infra up -d --pull always",
    "infra:down": "docker compose -p forge -f ./docker-compose.dev.yml --profile infra down",
    "infra:logs": "docker compose -p forge -f ./docker-compose.dev.yml --profile infra logs -f",
    "db:generate": "bun prisma generate",
    "db:push:dev": "sh -c 'set -a; . .env; set +a; bun prisma db push --accept-data-loss'",
    "db:push:test": "sh -c 'set -a; . .env.test; set +a; bun prisma db push --accept-data-loss'",
    "db:push": "bun run db:push:dev && bun run db:push:test",
    "test": "bunx vitest run --passWithNoTests",
    "test:watch": "bunx vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vercel/ncc": "^0.38.1",
    "vitest": "^4.0.17",
    "@lowerdeck/testing-tools": "^1.0.1",
    "lodash": "^4.17.21",
    "@types/lodash": "^4.17.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-codebuild": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@lowerdeck/api-mux": "^1.0.2",
    "@lowerdeck/cron": "^1.0.7",
    "@lowerdeck/delay": "^1.0.4",
    "@lowerdeck/encryption": "^1.0.7",
    "@lowerdeck/env": "^1.0.4",
    "@lowerdeck/error": "^1.2.0",
    "@lowerdeck/hash": "^1.0.4",
    "@lowerdeck/id": "^1.0.6",
    "@lowerdeck/lock": "^1.0.5",
    "@lowerdeck/once": "^1.0.4",
    "@lowerdeck/pagination": "^1.0.5",
    "@lowerdeck/queue": "^1.0.7",
    "@lowerdeck/rpc-client": "^1.1.0",
    "@lowerdeck/rpc-server": "^1.0.9",
    "@lowerdeck/sentry": "^1.0.2",
    "@lowerdeck/service": "^1.0.3",
    "@lowerdeck/slugify": "^1.0.5",
    "@lowerdeck/snowflake": "^1.0.2",
    "@lowerdeck/validation": "1.0.6",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "@types/mongoose": "^5.11.97",
    "date-fns": "^4.1.0",
    "jszip": "^3.10.1",
    "mongoose": "^9.0.2",
    "object-storage-client": "^0.2.5",
    "prisma": "^7.2.0",
    "yaml": "^2.8.2"
  }
}