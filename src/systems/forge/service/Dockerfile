# syntax=docker/dockerfile:1.7
# generated by control bootstrap
FROM oven/bun:1.2.22 AS deps
WORKDIR /app
ARG NX_SELF_HOSTED_REMOTE_CACHE_SERVER
ENV NX_CACHE_DIRECTORY=/app/.nx/cache
ENV NX_SELF_HOSTED_REMOTE_CACHE_SERVER=${NX_SELF_HOSTED_REMOTE_CACHE_SERVER}
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/base/ ./
RUN --mount=type=cache,id=control-bun-install-forge-base,target=/root/.bun/install/cache bun install
FROM deps AS build
WORKDIR /app
COPY _inputs/shared/ ./
COPY _inputs/clients/ ./
COPY _inputs/service/ ./
RUN --mount=type=cache,id=control-nx-cache-forge,target=/app/.nx/cache cd /app && { attempt=1; until bun x nx run-many --target=prisma:generate --projects=@metorial/forge; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done; }
RUN --mount=type=cache,id=control-nx-cache-forge,target=/app/.nx/cache cd /app && bun x nx run @metorial/forge:server:build
FROM build AS workspace
WORKDIR /app/src/systems/forge/service
CMD ["sleep", "infinity"]
FROM oven/bun:1.2.22-alpine AS skeleton
WORKDIR /app
COPY _runtime_skeleton/ ./
RUN --mount=type=cache,id=control-bun-runtime-forge,target=/root/.bun/install/cache bun install --production --no-frozen-lockfile
FROM oven/bun:1.2.22-alpine AS runner
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked sh -c 'attempt=1; until apk add --cache-dir /var/cache/apk curl; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done'
COPY --from=skeleton /app ./
COPY --from=build /app/src/systems/forge/service/dist /app/dist
COPY --from=build /app/src/systems/forge/service/prisma /app/prisma
COPY --from=build /app/src/systems/forge/service/prisma.config.ts /app/prisma.config.ts
ENV NODE_ENV="development"
EXPOSE 52020
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:52020/ping || exit 1
CMD ["sh", "-c", "bun prisma db push --accept-data-loss && bun /app/dist/index.js"]
