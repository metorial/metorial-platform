# syntax=docker/dockerfile:1.7
# generated by control bootstrap
FROM oven/bun:1.2.22 AS deps
WORKDIR /app
ENV NX_CACHE_DIRECTORY=/app/.nx/cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/base/ ./
RUN --mount=type=cache,id=control-bun-install,target=/root/.bun/install/cache,sharing=locked bun install
FROM deps AS build
WORKDIR /app
COPY _inputs/shared/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=build --projects=@function-bay/types
COPY _inputs/clients/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=build --projects=@metorial-platform-systems/forge-client,@metorial-platform-systems/function-bay-client,@metorial-platform-systems/object-storage-client
COPY _inputs/service/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && { attempt=1; until bun x nx run-many --target=prisma:generate --projects=@metorial/forge,@metorial/function-bay; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done; }
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run @metorial/function-bay:server:build
FROM build AS workspace
WORKDIR /app/src/systems/function-bay/service
CMD ["sleep", "infinity"]
FROM oven/bun:1.2.22-alpine AS runner
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked sh -c 'attempt=1; until apk add --cache-dir /var/cache/apk curl; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done'
COPY --from=build /app/src/systems/function-bay/service/dist /app/dist
COPY --from=build /app/src/systems/function-bay/service/prisma /app/prisma
COPY --from=build /app/src/systems/function-bay/service/prisma.config.ts /app/prisma.config.ts
COPY --from=build /app/node_modules /app/node_modules
ENV NODE_ENV="development"
EXPOSE 52030
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:52030/ping && curl -f http://localhost:12121/ || exit 1
CMD ["sh", "-c", "bun prisma db push --accept-data-loss && bun /app/dist/index.js"]
