# generated by control bootstrap
FROM golang:1.24-alpine AS deps
WORKDIR /app
RUN apk add --no-cache git ca-certificates
COPY src/systems/function-bay/deflector/go.mod ./src/systems/function-bay/deflector/
COPY src/systems/function-bay/deflector/go.sum ./src/systems/function-bay/deflector/
RUN go mod download
FROM deps AS build
WORKDIR /app
COPY src/systems/function-bay/deflector/cmd ./src/systems/function-bay/deflector/
COPY src/systems/function-bay/deflector/internal ./src/systems/function-bay/deflector/
RUN cd /app/src/systems/function-bay/deflector && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /tmp/deflector ./cmd/deflector
FROM build AS workspace
WORKDIR /app/src/systems/function-bay/deflector
CMD ["sleep", "infinity"]
FROM alpine:3.22 AS runner
WORKDIR /app
RUN apk add --no-cache ca-certificates wget
COPY --from=build /tmp/deflector /usr/local/bin/deflector
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/healthz >/dev/null || exit 1
CMD ["/usr/local/bin/deflector"]
