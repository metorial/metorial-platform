{
  "name": "@metorial/relay",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "dev": "bun --watch ./src/server.ts",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only",
    "server:start": "bun ./dist/index.js",
    "infra:up": "docker compose -p relay -f ./docker-compose.dev.yml --profile infra up -d --pull always",
    "infra:down": "docker compose -p relay -f ./docker-compose.dev.yml --profile infra down",
    "infra:logs": "docker compose -p relay -f ./docker-compose.dev.yml --profile infra logs -f",
    "db:generate": "bun prisma generate",
    "db:push:dev": "sh -c 'set -a; . .env; set +a; bun prisma db push --accept-data-loss'",
    "db:push:test": "sh -c 'set -a; . .env.test; set +a; bun prisma db push --accept-data-loss'",
    "db:push": "bun run db:push:dev && bun run db:push:test",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts",
    "test:watch": "bunx vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@vercel/ncc": "^0.38.1",
    "vitest": "4.0.17",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@aws-sdk/client-ses": "^3.985.0",
    "@metorial-services/forge-client": "^1.0.3",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sentry/bun": "^10.38.0",
    "@types/nodemailer": "^7.0.9",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "ipaddr.js": "^2.3.0",
    "jszip": "^3.10.1",
    "nodemailer": "^8.0.1",
    "@metorial-platform-systems/object-storage-client": "workspace:*",
    "prisma": "7.8.0",
    "prisma-json-types-generator": "^4.0.1",
    "yaml": "^2.8.2",
    "@mtsrc/api-mux": "1.0.0",
    "@mtsrc/cache": "1.0.0",
    "@mtsrc/canonicalize": "1.0.0",
    "@mtsrc/cron": "1.0.0",
    "@mtsrc/encryption": "1.0.0",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/hash": "1.0.0",
    "@mtsrc/id": "1.0.0",
    "@mtsrc/once": "1.0.0",
    "@mtsrc/pagination": "1.0.0",
    "@mtsrc/queue": "1.0.0",
    "@mtsrc/rpc-client": "1.0.0",
    "@mtsrc/rpc-server": "1.0.0",
    "@mtsrc/sentry": "1.0.0",
    "@mtsrc/service": "1.0.0",
    "@mtsrc/slugify": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/validation": "1.0.0"
  }
}
