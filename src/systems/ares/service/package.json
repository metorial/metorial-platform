{
  "name": "@metorial/ares",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "dev": "bun --watch ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-hrzn-ares ./dist && sentry-cli sourcemaps upload --org metorial --project mte-hrzn-ares ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "frontend:build": "bun run frontend:build:auth && bun run frontend:build:admin",
    "frontend:build:auth": "cd frontend/auth && vite build",
    "frontend:build:admin": "cd frontend/admin && vite build",
    "frontend:dev": "cd frontend/auth && vite",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "bun prisma generate",
    "db:push:dev": "sh -c 'set -a; . .env; set +a; bun prisma db push --accept-data-loss'",
    "db:push:test": "sh -c 'set -a; . .env.test; set +a; bun prisma db push --accept-data-loss'",
    "db:push": "bun run db:push:dev && bun run db:push:test",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts",
    "test:watch": "bunx vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@vercel/ncc": "^0.38.1",
    "@vitejs/plugin-react": "4.3.1",
    "vitest": "4.0.17",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@boxyhq/saml-jackson": "^1.52.2",
    "@looped/hooks": "^0.1.3",
    "@marsidev/react-turnstile": "^1.4.2",
    "@metorial-io/data-hooks": "^1.0.1",
    "@metorial-io/layout": "^1.0.1",
    "@metorial-io/pages": "^1.0.0",
    "@metorial-io/ui": "^1.0.0",
    "@metorial-io/ui-product": "^1.0.0",
    "@metorial-platform-systems/relay-client": "workspace:*",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "ipaddr.js": "^2.3.0",
    "jszip": "^3.10.1",
    "@metorial-platform-systems/object-storage-client": "workspace:*",
    "prisma": "^7.4.1",
    "prisma-json-types-generator": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.26.1",
    "sonner": "^2.0.7",
    "styled-components": "^6.1.13",
    "ua-parser-js": "1",
    "vite": "5.4.21",
    "yaml": "^2.8.2",
    "@mtsrc/api-mux": "1.0.0",
    "@mtsrc/cache": "1.0.0",
    "@mtsrc/canonicalize": "1.0.0",
    "@mtsrc/cron": "1.0.0",
    "@mtsrc/encryption": "1.0.0",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/event": "1.0.0",
    "@mtsrc/forwarded-for": "1.0.0",
    "@mtsrc/hash": "1.0.0",
    "@mtsrc/hono": "1.0.0",
    "@mtsrc/id": "1.0.0",
    "@mtsrc/ip-info": "1.0.0",
    "@mtsrc/once": "1.0.0",
    "@mtsrc/pagination": "1.0.0",
    "@mtsrc/programmable-promise": "1.0.0",
    "@mtsrc/queue": "1.0.0",
    "@mtsrc/rpc-client": "1.0.0",
    "@mtsrc/rpc-server": "1.0.0",
    "@mtsrc/sentry": "1.0.0",
    "@mtsrc/service": "1.0.0",
    "@mtsrc/slugify": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/tokens": "1.0.0",
    "@mtsrc/validation": "1.0.0"
  },
  "overrides": {
    "@react-email/components": "1.0.8"
  }
}