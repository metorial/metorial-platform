# syntax=docker/dockerfile:1.7
# generated by control bootstrap
FROM oven/bun:1.2 AS deps
WORKDIR /app
ENV NX_CACHE_DIRECTORY=/app/.nx/cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/base/ ./
RUN --mount=type=cache,id=control-bun-install,target=/root/.bun/install/cache,sharing=locked bun install --linker=hoisted
FROM deps AS build
WORKDIR /app
COPY _inputs/shared/ ./
COPY _inputs/clients/ ./
COPY _inputs/dependencies/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=build --projects=@metorial-platform-systems/object-storage-client,@metorial-platform-systems/relay-client
COPY _inputs/service/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=prisma:generate --projects=@metorial/ares
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=frontend:build --projects=@metorial/ares
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run @metorial/ares:server:build
FROM build AS workspace
WORKDIR /app/src/systems/ares/service
CMD ["sleep", "infinity"]
FROM oven/bun:1.2-alpine AS runner
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apk apk add --cache-dir /var/cache/apk curl
COPY --from=build /app/src/systems/ares/service/dist /app/dist
COPY --from=build /app/src/systems/ares/service/prisma /app/prisma
COPY --from=build /app/src/systems/ares/service/prisma.config.ts /app/prisma.config.ts
COPY --from=build /app/src/systems/ares/service/frontend/auth/dist /app/frontend/auth/dist
COPY --from=build /app/src/systems/ares/service/frontend/admin/dist /app/frontend/admin/dist
COPY --from=build /app/node_modules /app/node_modules
ENV NODE_ENV="production"
EXPOSE 52120
EXPOSE 52121
EXPOSE 52122
EXPOSE 52123
EXPOSE 12121
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:52120/ping && curl -f http://localhost:12121/ || exit 1
CMD ["sh", "-c", "bun prisma db push --accept-data-loss && bun /app/dist/index.js"]
