model AssistantConversation {
  oid BigInt @id
  id  String @unique

  title String?

  assistantInstanceOid BigInt
  assistantInstance    AssistantInstance @relation(fields: [assistantInstanceOid], references: [oid], onDelete: Cascade)

  assistantOid BigInt
  assistant    Assistant @relation(fields: [assistantOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  createdByTenantActorOid BigInt
  createdByTenantActor    TenantActor @relation("AssistantConversationCreator", fields: [createdByTenantActorOid], references: [oid], onDelete: Cascade)

  rootMessageOid BigInt
  rootMessage    AssistantMessage @relation(fields: [rootMessageOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  runs                              ModelRun[]
  items                             AssistantConversationItem[]
  assistantRequests                 AssistantRequest[]
  assistantConversationParticipants AssistantConversationParticipant[]

  @@index([tenantOid, environmentOid])
  @@index([assistantOid, assistantInstanceOid])
  @@index([createdByTenantActorOid])
}

model AssistantConversationParticipant {
  oid BigInt @id
  id  String @unique

  conversationOid BigInt
  conversation    AssistantConversation @relation(fields: [conversationOid], references: [oid], onDelete: Cascade)

  tenantActorOid BigInt
  tenantActor    TenantActor @relation(fields: [tenantActorOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conversationOid, tenantActorOid])
  @@index([conversationOid])
  @@index([tenantActorOid])
}

enum AssistantRequestStatus {
  pending
  completed
  cancelled
  failed
}

model AssistantRequest {
  oid BigInt @id
  id  String @unique

  status AssistantRequestStatus

  conversationOid BigInt
  conversation    AssistantConversation @relation(fields: [conversationOid], references: [oid], onDelete: Cascade)

  assistantInstanceOid BigInt
  assistantInstance    AssistantInstance @relation(fields: [assistantInstanceOid], references: [oid], onDelete: Cascade)

  assistantOid BigInt
  assistant    Assistant @relation(fields: [assistantOid], references: [oid], onDelete: Cascade)

  modelOid BigInt
  model    Model  @relation(fields: [modelOid], references: [oid], onDelete: Cascade)

  messageOid BigInt
  message    AssistantMessage @relation("AssistantRequestParentMessage", fields: [messageOid], references: [oid], onDelete: Cascade)

  historySize Int?

  tenantActorOid BigInt?
  tenantActor    TenantActor? @relation(fields: [tenantActorOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  messages AssistantMessage[]
  runs     ModelRun[]

  @@index([conversationOid, status])
  @@index([assistantInstanceOid])
  @@index([tenantActorOid])
}

enum AssistantMessageType {
  root
  user
  assistant
}

model AssistantMessage {
  oid BigInt @id
  id  String @unique

  type AssistantMessageType

  runOid BigInt?
  run    ModelRun? @relation(fields: [runOid], references: [oid], onDelete: Cascade)

  requestOid BigInt?
  request    AssistantRequest? @relation(fields: [requestOid], references: [oid], onDelete: Cascade)

  assistantInstanceOid BigInt?
  assistantInstance    AssistantInstance? @relation(fields: [assistantInstanceOid], references: [oid], onDelete: Cascade)

  assistantOid BigInt?
  assistant    Assistant? @relation(fields: [assistantOid], references: [oid], onDelete: Cascade)

  parentMessageOid BigInt?
  parentMessage    AssistantMessage? @relation("ParentMessage", fields: [parentMessageOid], references: [oid], onDelete: Cascade)

  modelOid BigInt?
  model    Model?  @relation(fields: [modelOid], references: [oid], onDelete: Cascade)

  /// [AssistantMessageStateContent]
  state Json

  /// [AssistantMessageSerializedContent]
  serialized Json

  createdAt DateTime @default(now())

  childMessages  AssistantMessage[]          @relation("ParentMessage")
  childRequests  AssistantRequest[]          @relation("AssistantRequestParentMessage")
  conversations  AssistantConversationItem[]
  rootMessageFor AssistantConversation[]

  @@index([runOid])
  @@index([requestOid])
  @@index([assistantInstanceOid])
  @@index([assistantOid])
  @@index([parentMessageOid])
}

model AssistantConversationItem {
  oid BigInt @id
  id  String @unique

  conversationOid BigInt
  conversation    AssistantConversation @relation(fields: [conversationOid], references: [oid], onDelete: Cascade)

  messageOid BigInt
  message    AssistantMessage @relation(fields: [messageOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationOid])
  @@index([messageOid])
}
