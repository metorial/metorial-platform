{
  "name": "@metorial/synthesis",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "dev": "bun --watch ./src/server.ts",
    "worker:dev": "bun --watch ./src/worker.ts",
    "enterprise:dev": "bun run dev",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "worker:build": "ncc build ./src/worker.ts -o ./dist-worker --source-map --transpile-only",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-synthesis ./dist && sentry-cli sourcemaps upload --org metorial --project mte-synthesis ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "worker:start": "bun ./dist-worker/index.js",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "bun prisma generate --config ./prisma.config.ts",
    "db:push:dev": "sh -c 'set -a; [ -f .env ] && . .env; set +a; bun prisma db push --config ./prisma.config.ts --accept-data-loss'",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts",
    "test:watch": "bunx vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@vercel/ncc": "^0.38.1",
    "vitest": "^4.0.17",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@metorial-services/scout-client": "^1.0.0",
    "@openharness/core": "^0.6.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "ai": "^6.0.175",
    "hono": "^4.9.6",
    "just-bash": "^2.14.4",
    "prisma": "7.8.0",
    "prisma-json-types-generator": "^4.0.1",
    "zod": "^4.4.3",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/execution-context": "1.0.0",
    "@mtsrc/api-mux": "1.0.0",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/hono": "1.0.0",
    "@mtsrc/pagination": "1.0.0",
    "@mtsrc/queue": "1.0.0",
    "@mtsrc/redis": "1.0.0",
    "@mtsrc/rpc-server": "1.0.0",
    "@mtsrc/sentry": "1.0.0",
    "@mtsrc/service": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/telemetry": "1.0.0",
    "@mtsrc/validation": "1.0.0",
    "@mtsrc/id": "1.0.0"
  }
}
