{
  "name": "@metorial/synthesis",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "dev": "bun --watch ./src/server.ts",
    "worker:dev": "bun --watch ./src/worker.ts",
    "enterprise:dev": "bun run dev",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "worker:build": "ncc build ./src/worker.ts -o ./dist-worker --source-map --transpile-only",
    "sentry:sourcemaps": "(sentry-cli sourcemaps inject --org metorial --project mte-synthesis ./dist && sentry-cli sourcemaps upload --org metorial --project mte-synthesis ./dist) || true",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "worker:start": "bun ./dist-worker/index.js",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "bun prisma generate --config ./prisma.config.ts",
    "db:push:dev": "sh -c 'set -a; [ -f .env ] && . .env; set +a; bun prisma db push --config ./prisma.config.ts --accept-data-loss'",
    "test": "bunx vitest run --passWithNoTests",
    "test:watch": "bunx vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@vercel/ncc": "^0.38.1",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@lowerdeck/error": "^1.2.3",
    "@lowerdeck/execution-context": "^1.1.1",
    "@lowerdeck/api-mux": "^1.0.4",
    "@lowerdeck/env": "^1.0.6",
    "@lowerdeck/hono": "^1.0.10",
    "@lowerdeck/pagination": "^1.0.8",
    "@lowerdeck/queue": "^1.0.11",
    "@lowerdeck/redis": "^1.0.6",
    "@lowerdeck/rpc-server": "^1.0.11",
    "@lowerdeck/sentry": "^1.0.2",
    "@lowerdeck/service": "^1.0.7",
    "@lowerdeck/snowflake": "^1.0.2",
    "@lowerdeck/telemetry": "^1.1.1",
    "@lowerdeck/validation": "1.0.10",
    "@lowerdeck/id": "^1.0.8",
    "@metorial-services/scout-client": "^1.0.0",
    "@openharness/core": "^0.6.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "ai": "^6.0.175",
    "hono": "^4.9.6",
    "just-bash": "^2.14.4",
    "prisma": "^7.2.0",
    "prisma-json-types-generator": "^4.0.1",
    "zod": "^4.4.3"
  }
}