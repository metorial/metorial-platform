{
  "name": "@metorial-subspace/db",
  "module": "index.ts",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prisma:generate": "bun prisma generate --schema prisma/schema --config ../prisma.config.ts",
    "prisma:push": "sh -c 'set -a; . .env; set +a; bun prisma db push --accept-data-loss --schema prisma/schema --config ../prisma.config.ts'"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@metorial-subspace/tsconfig": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "@prisma/extension-read-replicas": "^0.5.0",
    "dotenv": "^17.2.3",
    "p-queue": "^9.1.0",
    "prisma": "7.4.2",
    "prisma-json-types-generator": "^4.0.1",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/execution-context": "1.0.0",
    "@mtsrc/id": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/telemetry": "1.0.0",
    "@mtsrc/validation": "1.0.0"
  }
}
