model Network {
  oid BigInt @id
  id  String @unique

  name        String
  description String?

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  enclaves           Enclave[]
  firewalls          Firewall[]
  firewallBindings   FirewallBinding[]

  @@unique([tenantOid, environmentOid])
}

enum FirewallBindingTargetType {
  enclave
  provider
  network
}

model Firewall {
  oid BigInt @id
  id  String @unique

  name        String
  description String?
  slug        String

  networkOid BigInt
  network    Network @relation(fields: [networkOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  bindings           FirewallBinding[]
  networkPolicyLinks FirewallNetworkPolicy[]

  @@unique([tenantOid, environmentOid, slug])
}

model FirewallBinding {
  oid BigInt @id
  id  String @unique

  firewallOid BigInt
  firewall    Firewall @relation(fields: [firewallOid], references: [oid], onDelete: Cascade)

  targetType FirewallBindingTargetType

  enclaveOid BigInt?
  enclave    Enclave? @relation(fields: [enclaveOid], references: [oid], onDelete: Cascade)

  providerOid BigInt?
  provider    Provider? @relation(fields: [providerOid], references: [oid], onDelete: Cascade)

  networkOid BigInt?
  network    Network? @relation(fields: [networkOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([firewallOid, enclaveOid])
  @@unique([firewallOid, providerOid])
  @@unique([firewallOid, networkOid])
}

model NetworkPolicy {
  oid BigInt @id
  id  String @unique

  name        String
  description String?

  currentVersionOid BigInt?
  currentVersion    NetworkPolicyVersion? @relation("currentVersion", fields: [currentVersionOid], references: [oid])

  currentVersionNumber Int @default(0)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  versions      NetworkPolicyVersion[]
  firewallLinks FirewallNetworkPolicy[]
}

model NetworkPolicyVersion {
  oid BigInt @id
  id  String @unique

  version Int

  /// [NetworkPolicyRules]
  rules Json

  networkPolicyOid BigInt
  networkPolicy    NetworkPolicy @relation(fields: [networkPolicyOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  currentVersionFor NetworkPolicy[] @relation("currentVersion")

  @@unique([networkPolicyOid, version])
}

model FirewallNetworkPolicy {
  oid BigInt @id
  id  String @unique

  firewallOid BigInt
  firewall    Firewall @relation(fields: [firewallOid], references: [oid], onDelete: Cascade)

  networkPolicyOid BigInt
  networkPolicy    NetworkPolicy @relation(fields: [networkPolicyOid], references: [oid], onDelete: Cascade)

  position Int @default(0)

  createdAt DateTime @default(now())

  @@unique([firewallOid, networkPolicyOid])
}
