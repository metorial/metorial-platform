enum SkillTemplateStatus {
  active
  archived
  deleted
}

enum SkillTemplateOwner {
  system
  tenant
}

model SkillTemplate {
  oid BigInt @id
  id  String @unique

  status SkillTemplateStatus
  owner  SkillTemplateOwner

  slug            String  @unique
  name            String
  description     String?
  metadata        Json?
  privateMetadata Json?

  systemIdentifier String? @unique

  storeId         String?
  storeTemplateId String

  tenantOid BigInt?
  tenant    Tenant? @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt?
  environment    Environment? @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  solutionOid Int?
  solution    Solution? @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  skillTemplateItems SkillTemplateItem[]
  skills             Skill[]
}

model SkillTemplateItem {
  oid BigInt @id
  id  String @unique

  skillTemplateOid BigInt
  skillTemplate    SkillTemplate @relation(fields: [skillTemplateOid], references: [oid], onDelete: Cascade)

  providerOid BigInt?
  provider    Provider? @relation(fields: [providerOid], references: [oid], onDelete: Cascade)

  integrationOid BigInt?
  integration    Integration? @relation(fields: [integrationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
