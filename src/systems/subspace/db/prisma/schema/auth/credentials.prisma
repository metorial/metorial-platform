enum ProviderAuthCredentialsStatus {
  active
  archived
  deleted
}

enum ProviderAuthCredentialsType {
  oauth
}

enum ProviderAuthCredentialsOrigin {
  tenant_created
  managed_public
  managed_backing
}

enum ManagedProviderAuthCredentialsStatus {
  active
  archived
}

model ProviderAuthCredentials {
  oid BigInt @id
  id  String @unique

  type   ProviderAuthCredentialsType
  status ProviderAuthCredentialsStatus
  origin ProviderAuthCredentialsOrigin @default(tenant_created)

  isEphemeral        Boolean
  isDefault          Boolean
  isAutoRegistration Boolean

  name            String?
  description     String?
  metadata        Json?
  privateMetadata Json?

  /// [ProviderAuthScopes]
  scopes Json @default("[]")

  needsScopeSync Boolean @default(true)

  tenantOid BigInt?
  tenant    Tenant? @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt?
  environment    Environment? @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  solutionOid Int?
  solution    Solution? @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  providerOid BigInt
  provider    Provider @relation(fields: [providerOid], references: [oid])

  backendOid BigInt
  backend    Backend @relation(fields: [backendOid], references: [oid])

  slateCredentialsOid BigInt?                @unique
  slateCredentials    SlateOAuthCredentials? @relation(fields: [slateCredentialsOid], references: [oid])

  shuttleCredentialsOid BigInt?                  @unique
  shuttleCredentials    ShuttleOAuthCredentials? @relation(fields: [shuttleCredentialsOid], references: [oid])

  managedCredentialsOid BigInt?                         @unique
  managedCredentials    ManagedProviderAuthCredentials? @relation("ManagedProviderAuthCredentialsPublic", fields: [managedCredentialsOid], references: [oid])

  managedCredentialsBacking ManagedProviderAuthCredentialsBacking? @relation("ManagedProviderAuthCredentialsBackingCredential")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?

  providerOAuthSetups        ProviderOAuthSetup[]
  providerSetupSessions      ProviderSetupSession[]
  providerAuthConfigVersions ProviderAuthConfigVersion[]
  providerAuthConfigs        ProviderAuthConfig[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([isDefault])
  @@index([isEphemeral])
  @@index([origin])
  @@index([status])
  @@index([archivedAt])
  @@index([status, archivedAt])
  @@index([type])
  @@index([needsScopeSync])
}

model ManagedProviderAuthCredentials {
  oid BigInt @id
  id  String @unique

  status ManagedProviderAuthCredentialsStatus

  name        String?
  description String?
  metadata    Json?

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  initialProviderAuthMethodOid BigInt             @map("providerAuthMethodOid")
  initialProviderAuthMethod    ProviderAuthMethod @relation(fields: [initialProviderAuthMethodOid], references: [oid])

  providerOid BigInt?
  provider    Provider? @relation(fields: [providerOid], references: [oid])

  providerAuthMethodGlobalOid BigInt?
  providerAuthMethodGlobal    ProviderAuthMethodGlobal? @relation(fields: [providerAuthMethodGlobalOid], references: [oid])

  oauthClientId     String
  oauthClientSecret String

  /// [ProviderAuthScopes]
  oauthScopes Json @default("[]")

  providerAuthCredentials ProviderAuthCredentials?                @relation("ManagedProviderAuthCredentialsPublic")
  backings                ManagedProviderAuthCredentialsBacking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
}

model ManagedProviderAuthCredentialsBacking {
  oid BigInt @id

  managedCredentialsOid BigInt
  managedCredentials    ManagedProviderAuthCredentials @relation(fields: [managedCredentialsOid], references: [oid], onDelete: Cascade)

  providerAuthCredentialsOid BigInt                  @unique
  providerAuthCredentials    ProviderAuthCredentials @relation("ManagedProviderAuthCredentialsBackingCredential", fields: [providerAuthCredentialsOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([managedCredentialsOid, tenantOid])
}
