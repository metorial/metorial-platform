enum EphemeralManagedSessionStatus {
  active
  archived
  deleted
}

model EphemeralManagedSession {
  oid BigInt @id
  id  String @unique

  status     EphemeralManagedSessionStatus
  archivedAt DateTime?

  maxSessionDurationInMinutes Int
  templateHash                String?
  willRotateAt                DateTime?

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  sessionTemplateOid BigInt
  sessionTemplate    SessionTemplate @relation(fields: [sessionTemplateOid], references: [oid])

  currentSessionOid BigInt?  @unique
  currentSession    Session? @relation("EphemeralManagedSessionCurrentSession", fields: [currentSessionOid], references: [oid])

  actorOid BigInt?
  actor    IdentityActor? @relation(fields: [actorOid], references: [oid], onDelete: SetNull)

  identityOid BigInt?
  identity    Identity? @relation(fields: [identityOid], references: [oid], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sessions                 Session[]                 @relation("EphemeralManagedSessionSessions")
  magicMcpServerBackings   MagicMcpServerBacking[]
  magicMcpEndpointBackings MagicMcpEndpointBacking[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
  @@index([archivedAt])
  @@index([status, archivedAt])
  @@index([sessionTemplateOid])
  @@index([identityOid])
  @@index([currentSessionOid, status])
}
