enum SessionTemplateStatus {
  active
  archived
  deleted
}

model SessionTemplate {
  oid BigInt @id
  id  String @unique

  status     SessionTemplateStatus
  archivedAt DateTime?
  isInternal Boolean               @default(false)

  name            String?
  description     String?
  metadata        Json?
  privateMetadata Json?

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  integrationInstanceOid BigInt?
  integrationInstance    IntegrationInstance? @relation(fields: [integrationInstanceOid], references: [oid], onDelete: Cascade)

  delegatedIntegrationInstanceOid BigInt?
  delegatedIntegrationInstance    DelegatedIntegrationInstance? @relation(fields: [delegatedIntegrationInstanceOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  providers        SessionTemplateProvider[]
  sessionProviders SessionProvider[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
  @@index([archivedAt])
  @@index([status, archivedAt])
  @@index([integrationInstanceOid, status])
  @@index([delegatedIntegrationInstanceOid, status])
}

enum SessionTemplateProviderStatus {
  active
  archived
  deleted
}

model SessionTemplateProvider {
  oid BigInt @id
  id  String @unique

  status SessionTemplateProviderStatus

  /// [ToolFilter]
  toolFilter Json

  sessionTemplateOid BigInt
  sessionTemplate    SessionTemplate @relation(fields: [sessionTemplateOid], references: [oid])

  providerOid BigInt
  provider    Provider @relation(fields: [providerOid], references: [oid])

  deploymentOid BigInt
  deployment    ProviderDeployment @relation(fields: [deploymentOid], references: [oid])

  configOid BigInt
  config    ProviderConfig @relation(fields: [configOid], references: [oid])

  authConfigOid BigInt?
  authConfig    ProviderAuthConfig? @relation(fields: [authConfigOid], references: [oid])

  integrationInstanceProviderOid BigInt?
  integrationInstanceProvider    IntegrationInstanceProvider? @relation(fields: [integrationInstanceProviderOid], references: [oid], onDelete: Cascade)

  delegatedIntegrationInstanceProviderOid BigInt?
  delegatedIntegrationInstanceProvider    DelegatedIntegrationInstanceProvider? @relation(fields: [delegatedIntegrationInstanceProviderOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sessionProviders SessionProvider[]

  @@unique([sessionTemplateOid, integrationInstanceProviderOid])
  @@unique([sessionTemplateOid, delegatedIntegrationInstanceProviderOid])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
  @@index([integrationInstanceProviderOid, status])
  @@index([delegatedIntegrationInstanceProviderOid, status])
}
