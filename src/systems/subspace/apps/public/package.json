{
  "name": "@metorial-subspace/app-public",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start:dev:server": "bun --watch ./src/server.ts",
    "start:dev:vite": "bun run dev",
    "start:dev": "bun run start:dev:server",
    "dev": "vite build --watch ./frontend",
    "dev:hmr": "vite ./frontend",
    "start": "bun ./src/server.ts",
    "build": "vite build ./frontend",
    "frontend:build": "vite build ./frontend",
    "server:build": "sh -c 'mv tsconfig.json tsconfig.json.bak && mv tsconfig.build.json tsconfig.json && ncc build ./src/server.ts -o ./dist --source-map --transpile-only --external bun:sqlite --external bun && bun run sentry:sourcemaps:if-token; BUILD_EXIT_CODE=$?; mv tsconfig.json tsconfig.build.json && mv tsconfig.json.bak tsconfig.json; exit $BUILD_EXIT_CODE'",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-subspace-frontend ./dist && sentry-cli sourcemaps upload --org metorial --project mte-subspace-frontend ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vitest": "^4.0.17",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@hono/zod-validator": "^0.7.6",
    "@hookform/resolvers": "^5.2.2",
    "@metorial-io/data-hooks": "^1.0.1",
    "@metorial-io/pages": "^1.0.0",
    "@metorial-subspace/app-controller": "workspace:*",
    "@metorial-subspace/module-auth": "^1.0.0",
    "@metorial-subspace/module-integration": "^1.0.0",
    "@metorial-subspace/module-tenant": "^1.0.0",
    "@metorial-subspace/presenters": "^1.0.0",
    "@metorial-subspace/provider-native": "^1.0.0",
    "@sentry/bun": "^10.34.0",
    "@sentry/cli": "^3.2.0",
    "@types/react-dom": "^19.2.3",
    "@vercel/ncc": "^0.38.3",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "framer-motion": "^12.9.4",
    "react-router-dom": "^6.26.1",
    "semver": "^7.7.3",
    "snowflake-uuid": "^1.0.0",
    "styled-components": "^6.1.13",
    "unzipper": "^0.12.3",
    "vite": "^5.4.1",
    "yaml": "^2.8.2",
    "yup": "^1.7.1",
    "@mtsrc/api-key": "1.0.0",
    "@mtsrc/api-mux": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/hono": "1.0.0",
    "@mtsrc/rpc-server": "1.0.0",
    "@mtsrc/validation": "1.0.0",
    "@mtsrc/telemetry": "1.0.0"
  }
}
