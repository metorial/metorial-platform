FROM oven/bun:1.2.22 AS deps
WORKDIR /app
ARG NX_SELF_HOSTED_REMOTE_CACHE_SERVER
ENV NX_CACHE_DIRECTORY=/app/.nx/cache
ENV NX_SELF_HOSTED_REMOTE_CACHE_SERVER=${NX_SELF_HOSTED_REMOTE_CACHE_SERVER}
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/base/ ./
RUN --mount=type=cache,id=control-bun-install-subspace-worker-base,target=/root/.bun/install/cache bun install
COPY _manifests/dependencies/ ./
RUN --mount=type=cache,id=control-bun-install-subspace-worker-dependencies,target=/root/.bun/install/cache bun install
COPY _manifests/service/ ./
RUN --mount=type=cache,id=control-bun-install-subspace-worker-service,target=/root/.bun/install/cache bun install
FROM deps AS build
WORKDIR /app
COPY _inputs/shared/ ./
RUN --mount=type=cache,id=control-nx-cache-subspace-worker,target=/app/.nx/cache cd /app && bun x nx run-many --target=build --projects=@function-bay/types,@metorial/mcp,@metorial/mcp-server,@metorial/mcp-transport-memory
COPY _inputs/clients/ ./
COPY _inputs/dependencies/ ./
RUN --mount=type=cache,id=control-nx-cache-subspace-worker,target=/app/.nx/cache cd /app && bun x nx run-many --target=build --projects=@function-bay/types,@metorial/mcp,@metorial/mcp-server,@metorial/mcp-transport-memory
RUN --mount=type=cache,id=control-nx-cache-subspace-worker,target=/app/.nx/cache cd /app && { attempt=1; until bun x nx run-many --target=prisma:generate --projects=@metorial-cargo/db,@metorial-cargo/service,@metorial/ares,@metorial/forge,@metorial/function-bay,@metorial/origin,@metorial/shuttle,@metorial/signal,@metorial/slates,@metorial/voyager; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done; }
COPY _inputs/service/ ./
RUN --mount=type=cache,id=control-nx-cache-subspace-worker,target=/app/.nx/cache cd /app && { attempt=1; until bun x nx run-many --target=prisma:generate --projects=@metorial-cargo/service,@metorial-subspace/db,@metorial/forge,@metorial/function-bay,@metorial/signal,@metorial/slates,@metorial/synthesis; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done; }
RUN --mount=type=cache,id=control-nx-cache-subspace-worker,target=/app/.nx/cache cd /app && bun x nx run @metorial-subspace/app-worker:server:build
FROM build AS workspace
WORKDIR /app/src/systems/subspace/apps/worker
CMD ["sleep", "infinity"]
FROM oven/bun:1.2.22-alpine AS skeleton
WORKDIR /app
COPY _runtime_skeleton/ ./
RUN --mount=type=cache,id=control-bun-runtime-subspace-worker,target=/root/.bun/install/cache bun install --production --no-frozen-lockfile
FROM oven/bun:1.2.22-alpine AS runner
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked sh -c 'attempt=1; until apk add --cache-dir /var/cache/apk curl; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done'
COPY --from=skeleton /app ./
COPY --from=build /app/src/systems/subspace/apps/worker/dist /app/dist
COPY --from=build /app/src/systems/subspace/db /app/db
ENV NODE_ENV="production"
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:12121/ || exit 1
CMD ["sh", "-c", "cd db && bun prisma db push --accept-data-loss && cd /app && bun dist/index.js"]
