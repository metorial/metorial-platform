{
  "name": "@metorial-subspace/app-worker",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start:dev": "bun --watch ./src/server.ts",
    "start": "bun ./src/server.ts",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --external bun:sqlite --external bun && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-subspace-worker ./dist && sentry-cli sourcemaps upload --org metorial --project mte-subspace-worker ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vitest": "^4.0.17",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@metorial-subspace/app-controller": "workspace:*",
    "@metorial-subspace/module-auth": "^1.0.0",
    "@metorial-subspace/module-catalog": "^1.0.0",
    "@metorial-subspace/module-connection": "^1.0.0",
    "@metorial-subspace/module-deployment": "^1.0.0",
    "@metorial-subspace/module-integration": "^1.0.0",
    "@metorial-subspace/module-provider-internal": "^1.0.0",
    "@metorial-subspace/module-skills": "^1.0.0",
    "@metorial-subspace/module-tenant": "^1.0.0",
    "@metorial-subspace/provider-native": "^1.0.0",
    "@metorial-subspace/provider-slates": "^1.0.0",
    "@sentry/bun": "^10.34.0",
    "@vercel/ncc": "^0.38.3",
    "@sentry/cli": "^3.2.0",
    "@metorial-subspace/module-callback": "^1.0.0",
    "@mtsrc/queue": "1.0.0",
    "@mtsrc/telemetry": "1.0.0"
  }
}
