# generated by control bootstrap
FROM oven/bun:1.2 AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/ ./
RUN bun install --linker=hoisted
FROM deps AS build
WORKDIR /app
COPY _inputs/ ./
RUN cd /app && bun x nx run-many --target=prisma:generate --projects=@metorial-cargo/service,@metorial-subspace/db,@metorial/forge,@metorial/function-bay,@metorial/signal,@metorial/slates,@metorial/synthesis
RUN cd /app && bun x nx run @metorial-subspace/app-controller:server:build
FROM build AS workspace
WORKDIR /app/src/systems/subspace/apps/controller
CMD ["sleep", "infinity"]
FROM oven/bun:1.2-alpine AS runner
WORKDIR /app
RUN apk add --no-cache curl
COPY --from=build /app/src/systems/subspace/apps/controller/dist /app/dist
COPY --from=build /app/src/systems/subspace/db /app/db
COPY --from=build /app/node_modules /app/node_modules
ENV NODE_ENV="production"
EXPOSE 52070
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:52070/ping && curl -f http://localhost:12121/ || exit 1
CMD ["sh", "-c", "cd db && bun prisma db push --accept-data-loss && cd /app && bun dist/index.js"]
