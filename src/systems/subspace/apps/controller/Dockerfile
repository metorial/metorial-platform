FROM oven/bun:1.2.22 AS deps
WORKDIR /app
ENV NX_CACHE_DIRECTORY=/app/.nx/cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/base/ ./
RUN --mount=type=cache,id=control-bun-install,target=/root/.bun/install/cache,sharing=locked bun install
COPY _manifests/service/ ./
RUN --mount=type=cache,id=control-bun-install,target=/root/.bun/install/cache,sharing=locked bun install
FROM deps AS build
WORKDIR /app
COPY _inputs/shared/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=build --projects=@function-bay/types,@metorial/mcp,@metorial/mcp-server,@metorial/mcp-transport-memory
COPY _inputs/clients/ ./
COPY _inputs/dependencies/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && { attempt=1; until bun x nx run-many --target=prisma:generate --projects=@metorial-cargo/db,@metorial/ares,@metorial/origin,@metorial/shuttle,@metorial/voyager; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done; }
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=build --projects=@metorial-platform-systems/ares-client,@metorial-platform-systems/cargo-client,@metorial-platform-systems/forge-client,@metorial-platform-systems/function-bay-client,@metorial-platform-systems/object-storage-client,@metorial-platform-systems/origin-client,@metorial-platform-systems/relay-client,@metorial-platform-systems/shuttle-client,@metorial-platform-systems/signal-client,@metorial-platform-systems/slates-client,@metorial-platform-systems/voyager-client
COPY _inputs/service/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && { attempt=1; until bun x nx run-many --target=prisma:generate --projects=@metorial-cargo/service,@metorial-subspace/db,@metorial/forge,@metorial/function-bay,@metorial/signal,@metorial/slates,@metorial/synthesis; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done; }
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run @metorial-subspace/app-controller:server:build
FROM build AS workspace
WORKDIR /app/src/systems/subspace/apps/controller
CMD ["sleep", "infinity"]
FROM oven/bun:1.2.22-alpine AS runner
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked sh -c 'attempt=1; until apk add --cache-dir /var/cache/apk curl; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done'
COPY --from=build /app/src/systems/subspace/apps/controller/dist /app/dist
COPY --from=build /app/src/systems/subspace/db /app/db
COPY --from=build /app/node_modules /app/node_modules
ENV NODE_ENV="production"
EXPOSE 52070
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:52070/ping && curl -f http://localhost:12121/ || exit 1
CMD ["sh", "-c", "cd db && bun prisma db push --accept-data-loss && cd /app && bun dist/index.js"]
