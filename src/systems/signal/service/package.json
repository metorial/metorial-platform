{
  "name": "@metorial/signal",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "dev": "bun --watch ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-signal ./dist && sentry-cli sourcemaps upload --org metorial --project mte-signal ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "bun prisma generate",
    "db:push:dev": "sh -c 'set -a; . .env; set +a; bun prisma db push --accept-data-loss'",
    "db:push:test": "sh -c 'set -a; . .env.test; set +a; bun prisma db push --accept-data-loss'",
    "db:push": "bun run db:push:dev && bun run db:push:test",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts",
    "test:e2e:ci": "sh -c 'attempt=1; until bun run test:e2e; do code=$?; if [ \"$attempt\" -ge 3 ]; then exit \"$code\"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done'",
    "test:watch": "bunx vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@vercel/ncc": "^0.38.1",
    "vitest": "4.0.17",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "ipaddr.js": "^2.3.0",
    "jszip": "^3.10.1",
    "@metorial-platform-systems/object-storage-client": "workspace:*",
    "prisma": "^7.2.0",
    "prisma-json-types-generator": "^4.0.1",
    "yaml": "^2.8.2",
    "@mtsrc/api-mux": "1.0.0",
    "@mtsrc/cache": "1.0.0",
    "@mtsrc/canonicalize": "1.0.0",
    "@mtsrc/cron": "1.0.0",
    "@mtsrc/encryption": "1.0.0",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/hash": "1.0.0",
    "@mtsrc/id": "1.0.0",
    "@mtsrc/once": "1.0.0",
    "@mtsrc/pagination": "1.0.0",
    "@mtsrc/queue": "1.0.0",
    "@mtsrc/rpc-client": "1.0.0",
    "@mtsrc/rpc-server": "1.0.0",
    "@mtsrc/sentry": "1.0.0",
    "@mtsrc/service": "1.0.0",
    "@mtsrc/slugify": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/telemetry": "1.0.0",
    "@mtsrc/validation": "1.0.0"
  }
}