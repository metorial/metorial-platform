enum ServerDeploymentStatus {
  queued
  deploying
  succeeded
  failed
}

model ServerDeployment {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status ServerDeploymentStatus

  serverOid BigInt
  server    Server @relation(fields: [serverOid], references: [oid])

  tenantOid BigInt?
  tenant    Tenant? @relation(fields: [tenantOid], references: [oid])

  functionServerOid BigInt?
  functionServer    FunctionServer? @relation(fields: [functionServerOid], references: [oid])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  startedAt DateTime?
  endedAt   DateTime?

  steps         ServerDeploymentStep[]
  serverVersion ServerVersion?
}

enum ServerDeploymentStepType {
  started
  discovering
  deploying
  publishing
}

enum ServerDeploymentStepStatus {
  running
  succeeded
  failed
}

model ServerDeploymentStep {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status ServerDeploymentStepStatus
  type   ServerDeploymentStepType

  deploymentOid BigInt
  deployment    ServerDeployment @relation(fields: [deploymentOid], references: [oid])

  /// [ServerDeploymentStepLogs]
  logs Json[]

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?
}
