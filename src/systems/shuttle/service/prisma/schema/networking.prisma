enum NetworkingRuleStatus {
  active
  inactive
}

model NetworkingRuleset {
  oid BigInt @id
  id  String @unique

  isDefault Boolean

  name        String
  description String?

  status NetworkingRuleStatus

  /// [NetworkingRulesetList]
  rules Json

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  connections ServerConnectionNetworkRule[]
}

model GlobalNetworkingRuleset {
  oid BigInt @id
  id  String @unique

  status NetworkingRuleStatus

  /// [NetworkingRulesetList]
  rules Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
