# Service configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:25432/shuttle
REDIS_URL=redis://localhost:26379/0
PROVIDER_OAUTH_URL=http://localhost:52081

ENCRYPTION_KEY=local-dev-encryption-key

HOLOPOD_HTTP_ENDPOINT=http://holopod:3000
SHUTTLE_ALLOW_PRIVATE_URLS=true
SHUTTLE_UNSAFE_SSRF_BYPASS=true

OBJECT_STORAGE_URL=http://services:52010
LOGS_BUCKET_NAME=shuttle-logs

FUNCTION_BAY_API_URL=http://services:52030/metorial-function-bay
FUNCTION_BAY_TENANT_IDENTIFIER=dev-tenant
FUNCTION_BAY_DEFAULT_MEMORY_MB=512
FUNCTION_BAY_DEFAULT_TIMEOUT_SECONDS=15
