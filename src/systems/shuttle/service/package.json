{
  "name": "@metorial/shuttle",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-shuttle ./dist && sentry-cli sourcemaps upload --org metorial --project mte-shuttle ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "dev": "bun --watch ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "infra:up": "docker compose -p shuttle -f ./docker-compose.dev.yml --profile infra up -d --pull always",
    "infra:down": "docker compose -p shuttle -f ./docker-compose.dev.yml --profile infra down",
    "infra:logs": "docker compose -p shuttle -f ./docker-compose.dev.yml --profile infra logs -f",
    "db:generate": "bun prisma generate",
    "db:push:dev": "sh -c 'set -a; . .env; set +a; bun prisma db push --accept-data-loss'",
    "db:push:test": "sh -c 'set -a; . .env.test; set +a; bun prisma db push --accept-data-loss'",
    "db:push": "bun run db:push:dev && bun run db:push:test",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --passWithNoTests",
    "test:watch": "bunx vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@lowerdeck/testing-tools": "^1.0.1",
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "@vercel/ncc": "^0.38.1",
    "vitest": "4.0.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@bufbuild/protobuf": "^2.10.2",
    "@hono/zod-validator": "^0.7.6",
    "@lowerdeck/api-mux": "^1.0.4",
    "@lowerdeck/cache": "^1.0.1",
    "@lowerdeck/canonicalize": "^1.0.4",
    "@lowerdeck/cron": "^1.1.0",
    "@lowerdeck/delay": "^1.0.4",
    "@lowerdeck/encryption": "^1.0.7",
    "@lowerdeck/env": "^1.0.5",
    "@lowerdeck/error": "^1.2.2",
    "@lowerdeck/execution-context": "^1.1.0",
    "@lowerdeck/hash": "^1.0.4",
    "@lowerdeck/hono": "^1.0.9",
    "@lowerdeck/id": "^1.0.8",
    "@lowerdeck/lock": "^1.0.5",
    "@lowerdeck/once": "^1.0.4",
    "@lowerdeck/pagination": "^1.0.7",
    "@lowerdeck/programmable-promise": "^1.0.6",
    "@lowerdeck/queue": "^1.0.8",
    "@lowerdeck/rpc-client": "^1.1.3",
    "@lowerdeck/rpc-server": "^1.0.10",
    "@lowerdeck/sentry": "^1.0.2",
    "@lowerdeck/service": "^1.0.7",
    "@lowerdeck/slugify": "^1.0.5",
    "@lowerdeck/snowflake": "^1.0.2",
    "@lowerdeck/tokens": "^1.0.5",
    "@lowerdeck/validation": "^1.0.9",
    "@metorial-platform-systems/forge-client": "workspace:*",
    "@metorial-platform-systems/function-bay-client": "workspace:*",
    "@metorial/mcp-server": "^1.0.0-rc.7",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "@types/pg": "^8.16.0",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "hono": "4.10.6",
    "ipaddr.js": "^2.3.0",
    "jsonata": "^2.1.0",
    "jszip": "^3.10.1",
    "object-storage-client": "^0.2.5",
    "p-queue": "^9.1.0",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "prisma-json-types-generator": "^4.0.1",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}