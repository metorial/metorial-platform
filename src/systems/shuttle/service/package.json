{
  "name": "@metorial/shuttle",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "check-types": "tsc --noEmit -p tsconfig.server.json",
    "server:build": "bun run check-types && ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-shuttle ./dist && sentry-cli sourcemaps upload --org metorial --project mte-shuttle ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "dev": "bun --watch ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "bun prisma generate",
    "db:push:dev": "sh -c 'set -a; . .env; set +a; bun prisma db push --accept-data-loss'",
    "db:push:test": "sh -c 'set -a; . .env.test; set +a; bun prisma db push --accept-data-loss'",
    "db:push": "bun run db:push:dev && bun run db:push:test",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts",
    "test:watch": "bunx vitest watch",
    "typecheck": "bun run check-types"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "@vercel/ncc": "^0.38.1",
    "vitest": "4.0.17",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@bufbuild/protobuf": "^2.10.2",
    "@hono/zod-validator": "^0.7.6",
    "@metorial-platform-systems/function-bay-client": "workspace:*",
    "@metorial/mcp-server": "^1.0.0-rc.11",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "@types/pg": "^8.16.0",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.3",
    "ipaddr.js": "^2.3.0",
    "jsonata": "^2.1.0",
    "jszip": "^3.10.1",
    "@metorial-platform-systems/object-storage-client": "workspace:*",
    "p-queue": "^9.1.0",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "prisma-json-types-generator": "^4.0.1",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6",
    "@mtsrc/api-mux": "1.0.0",
    "@mtsrc/cache": "1.0.0",
    "@mtsrc/canonicalize": "1.0.0",
    "@mtsrc/cron": "1.0.0",
    "@mtsrc/delay": "1.0.0",
    "@mtsrc/encryption": "1.0.0",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/execution-context": "1.0.0",
    "@mtsrc/hash": "1.0.0",
    "@mtsrc/hono": "1.0.0",
    "@mtsrc/id": "1.0.0",
    "@mtsrc/lock": "1.0.0",
    "@mtsrc/once": "1.0.0",
    "@mtsrc/pagination": "1.0.0",
    "@mtsrc/programmable-promise": "1.0.0",
    "@mtsrc/queue": "1.0.0",
    "@mtsrc/rpc-client": "1.0.0",
    "@mtsrc/rpc-server": "1.0.0",
    "@mtsrc/sentry": "1.0.0",
    "@mtsrc/service": "1.0.0",
    "@mtsrc/slugify": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/telemetry": "1.0.0",
    "@mtsrc/tokens": "1.0.0",
    "@mtsrc/validation": "1.0.0"
  }
}