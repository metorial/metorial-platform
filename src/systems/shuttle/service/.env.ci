DATABASE_URL=postgresql://postgres:postgres@postgres:5432/shuttle-test
REDIS_URL=redis://redis:6379/0
PROVIDER_OAUTH_URL=http://shuttle-service:52081
ENCRYPTION_KEY=ci-encryption-key-32-bytes!!!!
HOLOPOD_HTTP_ENDPOINT=test.local:50051
OBJECT_STORAGE_URL=http://object-storage:52010
LOGS_BUCKET_NAME=shuttle-logs
FUNCTION_BAY_API_URL=http://function-bay:52030/metorial-function-bay
FUNCTION_BAY_TENANT_IDENTIFIER=shuttle-ci
FUNCTION_BAY_DEFAULT_MEMORY_MB=512
FUNCTION_BAY_DEFAULT_TIMEOUT_SECONDS=15

# Function Bay + Forge (infra dependencies)
FORGE_API_URL=http://forge:52020/metorial-forge
DEFAULT_PROVIDER=aws.lambda
BUNDLE_BUCKET_NAME=bundles

# AWS Lambda credentials (mock values for CI)
LAMBDA_AWS_REGION=us-east-1
# LAMBDA_AWS_ACCESS_KEY_ID=
# LAMBDA_AWS_SECRET_ACCESS_KEY=
# LAMBDA_ROLE_ARN=

# Object storage overrides (optional)
OBJECT_STORAGE_BACKEND_TYPE=local
OBJECT_STORAGE_BACKEND_ROOT_PATH=/app/data
OBJECT_STORAGE_AWS_REGION=us-east-1
OBJECT_STORAGE_AWS_S3_BUCKET=shuttle-ci
OBJECT_STORAGE_AWS_ACCESS_KEY_ID=test
OBJECT_STORAGE_AWS_SECRET_ACCESS_KEY=test

# Forge/CodeBuild overrides (optional)
CODE_BUILD_AWS_REGION=us-east-1
# CODE_BUILD_AWS_ACCESS_KEY_ID=
# CODE_BUILD_AWS_SECRET_ACCESS_KEY=
# CODE_BUILD_PROJECT_NAME=
# CODE_BUILD_ROLE_ARN=
