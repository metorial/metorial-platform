enum FilePurposeOwnerType {
  user
  organization
  instance
}

enum FileStatus {
  active
  deleted
}

model FilePurpose {
  oid BigInt @id
  id  String @unique

  ownerType    FilePurposeOwnerType
  canHaveLinks Boolean              @default(false)

  slug String @unique
  name String

  createdAt DateTime @default(now())

  files File[]
}

model File {
  oid    BigInt     @id
  id     String     @unique
  status FileStatus @default(active)

  storeId String

  isInternal Boolean @default(false)

  fileName          String
  fileSize          Int
  fileType          String
  isReadOnly        Boolean @default(false)
  isTemplateBacking Boolean @default(false)

  purposeOid BigInt
  purpose    FilePurpose @relation(fields: [purposeOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  createdByTenantActorOid BigInt?
  createdByTenantActor    TenantActor? @relation("FileCreator", fields: [createdByTenantActorOid], references: [oid], onDelete: SetNull)

  title String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  expiresAt DateTime?

  links             FileLink[]
  document          Document?
  storeItems        StoreItem[]
  storeVersionItems StoreVersionItem[]
  skillExports      SkillExport[]
  skillExportRefs   SkillExportRef[]

  @@index([storeId, status])
  @@index([status, expiresAt, oid])
}

model FileLink {
  oid BigInt @id
  id  String @unique

  key String @unique

  fileOid BigInt
  file    File   @relation(fields: [fileOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  createdByTenantActorOid BigInt?
  createdByTenantActor    TenantActor? @relation("FileLinkCreator", fields: [createdByTenantActorOid], references: [oid], onDelete: SetNull)

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  references      FileReference[]
  skillExportRefs SkillExportRef[]
  skillExports    SkillExport[]
}

model FileReference {
  oid BigInt @id
  id  String @unique

  fileLinkOid BigInt
  fileLink    FileLink @relation(fields: [fileLinkOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  entityType String
  entityId   String

  createdAt DateTime @default(now())

  storeItems      StoreItem[]
  skillExports    SkillExport[]
  skillExportRefs SkillExportRef[]
}
