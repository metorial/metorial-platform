{
  "name": "@metorial-cargo/db",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prisma:generate": "bun prisma generate --schema prisma/schema --config prisma.config.ts",
    "prisma:push": "sh -c 'set -a; . ../service/.env; set +a; bun prisma db push --accept-data-loss --schema prisma/schema --config prisma.config.ts'",
    "db:push:test": "sh -c 'set -a; . ../service/.env.test; set +a; bun prisma db push --accept-data-loss --schema prisma/schema --config prisma.config.ts'"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "p-queue": "^9.1.0",
    "prisma": "^7.2.0",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/execution-context": "1.0.0",
    "@mtsrc/id": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/validation": "1.0.0"
  },
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  }
}
