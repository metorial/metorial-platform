{
  "name": "@metorial-cargo/service",
  "module": "src/index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only --external bun && bun run sentry:sourcemaps:if-token",
    "worker:build": "ncc build ./src/worker.ts -o ./dist-worker --source-map --transpile-only --external bun",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-cargo ./dist && sentry-cli sourcemaps upload --org metorial --project mte-cargo ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "worker:start": "bun ./dist-worker/index.js",
    "dev": "bun --watch ./src/server.ts",
    "worker:dev": "bun --watch ./src/worker.ts",
    "enterprise:dev": "bun run dev",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "cd ../db && bun run prisma:generate",
    "db:push:dev": "cd ../db && bun run prisma:push",
    "db:push:test": "cd ../db && bun run db:push:test",
    "db:push": "bun run db:push:dev && bun run db:push:test",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts",
    "test:e2e:ci": "sh -c 'attempt=1; until bun run test:e2e; do code=$?; if [ \"$attempt\" -ge 3 ]; then exit \"$code\"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done'",
    "test:watch": "bunx vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@vercel/ncc": "^0.38.1",
    "vitest": "^4.0.17",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@sentry/bun": "^10.38.0",
    "@sentry/cli": "^3.2.0",
    "@metorial-platform-systems/object-storage-client": "workspace:*",
    "prisma": "7.4.2",
    "@metorial-cargo/db": "^1.0.0",
    "@metorial-cargo/module-file": "^1.0.0",
    "@metorial-cargo/module-doc": "^1.0.0",
    "@metorial-cargo/module-store": "^1.0.0",
    "@metorial-cargo/module-skill": "^1.0.0",
    "@mtsrc/api-mux": "1.0.0",
    "@mtsrc/canonicalize": "1.0.0",
    "@mtsrc/cron": "1.0.0",
    "@mtsrc/delay": "1.0.0",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/execution-context": "1.0.0",
    "@mtsrc/forwarded-for": "1.0.0",
    "@mtsrc/hash": "1.0.0",
    "@mtsrc/hono": "1.0.0",
    "@mtsrc/id": "1.0.0",
    "@mtsrc/pagination": "1.0.0",
    "@mtsrc/queue": "1.0.0",
    "@mtsrc/redis": "1.0.0",
    "@mtsrc/rpc-client": "1.0.0",
    "@mtsrc/rpc-server": "1.0.0",
    "@mtsrc/sentry": "1.0.0",
    "@mtsrc/serialize": "1.0.0",
    "@mtsrc/service": "1.0.0",
    "@mtsrc/slugify": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/tokens": "1.0.0",
    "@mtsrc/validation": "1.0.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  }
}
