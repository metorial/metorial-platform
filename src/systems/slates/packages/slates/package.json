{
  "name": "slates",
  "version": "1.0.0-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "author": "Tobias Herber",
  "license": "FSL 1.1",
  "type": "module",
  "source": "src/index.ts",
  "files": [
    "src/**",
    "dist/**",
    "README.md",
    "package.json"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "require": "./dist/index.cjs",
    "import": "./dist/index.js",
    "default": "./dist/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "prettier src/**/*.ts --check",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slates/provider": "^1.0.0-rc.6"
  },
  "devDependencies": {
    "@slates/tsconfig": "^1.0.0",
    "tsup": "^7.1.0",
    "typescript": "^5.5.3",
    "vitest": "4.0.17"
  }
}
