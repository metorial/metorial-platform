{
  "name": "@metorial/slates",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-slates-hub ./dist && sentry-cli sourcemaps upload --org metorial --project mte-slates-hub ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "dev": "bun --watch ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "infra:up": "docker compose -p slates-hub -f ./docker-compose.dev.yml --profile infra up -d",
    "infra:down": "docker compose -p slates-hub -f ./docker-compose.dev.yml --profile infra down",
    "infra:logs": "docker compose -p slates-hub -f ./docker-compose.dev.yml --profile infra logs -f",
    "infra:restart": "docker compose -p slates-hub -f ./docker-compose.dev.yml --profile infra restart",
    "db:generate": "bun prisma generate --schema prisma/schema",
    "db:push:dev": "sh -c 'set -a; . .env; set +a; bun prisma db push --schema prisma/schema'",
    "db:push:test": "sh -c 'set -a; . .env.test; set +a; bun prisma db push --schema prisma/schema'",
    "db:push": "bun run db:push:dev && bun run db:push:test",
    "test": "bunx vitest run --passWithNoTests",
    "test:watch": "bunx vitest watch",
    "typecheck": "tsc --noEmit && bun run admin:typecheck",
    "admin:typecheck": "tsc --noEmit --project admin/tsconfig.json",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:dev": "vite --config admin/vite.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/lodash": "^4.17.23",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/ncc": "^0.38.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/minimatch": "^6.0.0",
    "vite": "^5.4.0",
    "@lowerdeck/testing-tools": "^1.0.1",
    "vitest": "4.0.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@hono/zod-validator": "^0.7.6",
    "@lowerdeck/api-key": "^1.0.2",
    "@lowerdeck/api-mux": "^1.0.2",
    "@lowerdeck/cache": "^1.0.1",
    "@lowerdeck/canonicalize": "^1.0.4",
    "@lowerdeck/cron": "^1.0.7",
    "@lowerdeck/delay": "^1.0.4",
    "@lowerdeck/encryption": "^1.0.7",
    "@lowerdeck/env": "^1.0.4",
    "@lowerdeck/error": "^1.2.0",
    "@lowerdeck/hash": "^1.0.4",
    "@lowerdeck/hono": "^1.0.7",
    "@lowerdeck/id": "^1.0.6",
    "@lowerdeck/lock": "^1.0.5",
    "@lowerdeck/once": "^1.0.4",
    "@lowerdeck/pagination": "^1.0.5",
    "@lowerdeck/programmable-promise": "^1.0.6",
    "@lowerdeck/queue": "^1.0.7",
    "@lowerdeck/rpc-client": "^1.1.2",
    "@lowerdeck/rpc-server": "^1.0.9",
    "@lowerdeck/sentry": "^1.0.2",
    "@lowerdeck/serialize": "^1.0.4",
    "@lowerdeck/service": "^1.0.3",
    "@lowerdeck/shadow-id": "^1.0.7",
    "@lowerdeck/slugify": "^1.0.5",
    "@lowerdeck/snowflake": "^1.0.2",
    "@lowerdeck/validation": "^1.0.4",
    "@metorial-io/data-hooks": "^1.0.1",
    "@metorial-io/layout": "^1.0.1",
    "@metorial-io/ui": "^1.0.0",
    "@metorial-io/ui-product": "^1.0.0",
    "@metorial-services/ares-client": "^1.0.9",
    "@metorial-services/function-bay-client": "^1.0.4",
    "@metorial-services/signal-client": "^1.0.0",
    "@metorial-services/slates-registry-client": "latest",
    "@metorial-services/slates-registry-internal-client": "^1.0.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@remixicon/react": "^4.0.0",
    "@sentry/bun": "^10.36.0",
    "@sentry/cli": "^3.2.0",
    "@slates/proto": "^1.0.0-rc.5",
    "@types/semver": "^7.7.1",
    "@types/unzipper": "^0.10.11",
    "date-fns": "^4.1.0",
    "hono": "^4.11.3",
    "jszip": "^3.10.1",
    "lodash": "4.17.21",
    "object-storage-client": "^0.2.5",
    "p-queue": "^9.0.1",
    "prisma": "^7.2.0",
    "prisma-json-types-generator": "^4.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "semver": "^7.7.3",
    "sonner": "^1.5.0",
    "styled-components": "^6.1.13",
    "unzipper": "^0.12.3",
    "yaml": "^2.8.2",
    "zod": "^4.2.1"
  }
}