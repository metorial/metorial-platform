{
  "name": "@metorial/slates",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "check-types": "tsc --noEmit -p tsconfig.server.json",
    "server:build": "bun run check-types && ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-slates-hub ./dist && sentry-cli sourcemaps upload --org metorial --project mte-slates-hub ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "dev": "bun --watch ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "bun prisma generate --schema prisma/schema",
    "db:push:dev": "sh -c 'set -a; . .env; set +a; bun prisma db push --schema prisma/schema --accept-data-loss'",
    "db:push:test": "sh -c 'set -a; . .env.test; set +a; bun prisma db push --schema prisma/schema'",
    "db:push": "bun run db:push:dev && bun run db:push:test",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts",
    "test:e2e:ci": "sh -c 'attempt=1; until bun run test:e2e; do code=$?; if [ \"$attempt\" -ge 3 ]; then exit \"$code\"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done'",
    "test:watch": "bunx vitest watch",
    "typecheck": "bun run check-types && bun run admin:typecheck",
    "admin:typecheck": "tsc --noEmit --project admin/tsconfig.json",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:dev": "vite --config admin/vite.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/lodash": "^4.17.23",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/ncc": "^0.38.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/minimatch": "^6.0.0",
    "vite": "^5.4.0",
    "vitest": "4.0.17",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@hono/zod-validator": "^0.7.6",
    "@metorial/data-hooks": "workspace:*",
    "@metorial/layout": "workspace:*",
    "@metorial/ui": "workspace:*",
    "@metorial/ui-product": "workspace:*",
    "@metorial-platform-systems/ares-client": "^1.0.0",
    "@metorial-platform-systems/function-bay-client": "workspace:*",
    "@metorial-platform-systems/signal-client": "workspace:*",
    "@metorial-services/slates-registry-client": "latest",
    "@metorial-services/slates-registry-internal-client": "^1.0.0",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@remixicon/react": "^4.0.0",
    "@sentry/bun": "^10.36.0",
    "@sentry/cli": "^3.2.0",
    "@slates/proto": "^1.0.0-rc.8",
    "@types/semver": "^7.7.1",
    "@types/unzipper": "^0.10.11",
    "date-fns": "^4.1.0",
    "hono": "^4.11.3",
    "jszip": "^3.10.1",
    "lodash": "4.17.21",
    "@metorial-platform-systems/object-storage-client": "workspace:*",
    "p-queue": "^9.0.1",
    "prisma": "7.4.2",
    "prisma-json-types-generator": "^4.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^6.26.1",
    "semver": "^7.7.3",
    "sonner": "^1.5.0",
    "styled-components": "^6.1.13",
    "unzipper": "^0.12.3",
    "yaml": "^2.8.2",
    "zod": "^4.2.1",
    "@mtsrc/api-key": "1.0.0",
    "@mtsrc/api-mux": "1.0.0",
    "@mtsrc/cache": "1.0.0",
    "@mtsrc/canonicalize": "1.0.0",
    "@mtsrc/cron": "1.0.0",
    "@mtsrc/delay": "1.0.0",
    "@mtsrc/encryption": "1.0.0",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/hash": "1.0.0",
    "@mtsrc/hono": "1.0.0",
    "@mtsrc/id": "1.0.0",
    "@mtsrc/lock": "1.0.0",
    "@mtsrc/once": "1.0.0",
    "@mtsrc/pagination": "1.0.0",
    "@mtsrc/programmable-promise": "1.0.0",
    "@mtsrc/queue": "1.0.0",
    "@mtsrc/rpc-client": "1.0.0",
    "@mtsrc/rpc-server": "1.0.0",
    "@mtsrc/sentry": "1.0.0",
    "@mtsrc/serialize": "1.0.0",
    "@mtsrc/service": "1.0.0",
    "@mtsrc/shadow-id": "1.0.0",
    "@mtsrc/slugify": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/telemetry": "1.0.0",
    "@mtsrc/validation": "1.0.0"
  }
}
