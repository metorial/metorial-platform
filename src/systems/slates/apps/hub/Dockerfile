FROM oven/bun:1.2 AS deps
WORKDIR /app
ENV NX_CACHE_DIRECTORY=/app/.nx/cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/base/ ./
RUN --mount=type=cache,id=control-bun-install,target=/root/.bun/install/cache,sharing=locked bun install --linker=hoisted
FROM deps AS build
WORKDIR /app
COPY _inputs/shared/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=build --projects=@function-bay/types
COPY _inputs/clients/ ./
COPY _inputs/dependencies/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=build --projects=@metorial-platform-systems/ares-client,@metorial-platform-systems/forge-client,@metorial-platform-systems/function-bay-client,@metorial-platform-systems/object-storage-client,@metorial-platform-systems/relay-client,@metorial-platform-systems/signal-client
COPY _inputs/service/ ./
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=prisma:generate --projects=@metorial/ares,@metorial/forge,@metorial/function-bay,@metorial/signal,@metorial/slates
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run-many --target=admin:build --projects=@metorial/slates
RUN --mount=type=cache,id=control-nx-cache,target=/app/.nx/cache,sharing=locked cd /app && bun x nx run @metorial/slates:server:build
FROM build AS workspace
WORKDIR /app/src/systems/slates/apps/hub
CMD ["sleep", "infinity"]
FROM oven/bun:1.2-alpine AS runner
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apk apk add --cache-dir /var/cache/apk curl
COPY --from=build /app/src/systems/slates/apps/hub/dist /app/dist
COPY --from=build /app/src/systems/slates/apps/hub/dist/admin /app/dist/admin
COPY --from=build /app/src/systems/slates/apps/hub/prisma /app/prisma
COPY --from=build /app/src/systems/slates/apps/hub/prisma.config.ts /app/prisma.config.ts
COPY --from=build /app/node_modules /app/node_modules
ENV NODE_ENV="production"
EXPOSE 52045
EXPOSE 52046
EXPOSE 52047
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:52045/ping && curl -f http://localhost:52046/ping && curl -f http://localhost:12121/ || exit 1
CMD ["sh", "-c", "bun prisma db push --accept-data-loss && bun /app/dist/index.js"]
