FROM oven/bun:1.2.22 AS deps
WORKDIR /app
ARG NX_SELF_HOSTED_REMOTE_CACHE_SERVER
ENV NX_CACHE_DIRECTORY=/app/.nx/cache
ENV NX_SELF_HOSTED_REMOTE_CACHE_SERVER=${NX_SELF_HOSTED_REMOTE_CACHE_SERVER}
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/base/ ./
RUN --mount=type=cache,id=control-bun-install-slates-hub-base,target=/root/.bun/install/cache bun install
FROM deps AS build
WORKDIR /app
COPY _inputs/shared/ ./
RUN --mount=type=cache,id=control-nx-cache-slates-hub,target=/app/.nx/cache cd /app && bun x nx run-many --target=build --projects=@function-bay/types
COPY _inputs/clients/ ./
COPY _inputs/dependencies/ ./
COPY _inputs/service/ ./
RUN --mount=type=cache,id=control-nx-cache-slates-hub,target=/app/.nx/cache cd /app && { attempt=1; until bun x nx run-many --target=prisma:generate --projects=@metorial/ares,@metorial/forge,@metorial/function-bay,@metorial/signal,@metorial/slates; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done; }
RUN --mount=type=cache,id=control-nx-cache-slates-hub,target=/app/.nx/cache cd /app && bun x nx run-many --target=admin:build --projects=@metorial/slates
RUN --mount=type=cache,id=control-nx-cache-slates-hub,target=/app/.nx/cache cd /app && bun x nx run @metorial/slates:server:build
FROM build AS workspace
WORKDIR /app/src/systems/slates/apps/hub
CMD ["sleep", "infinity"]
FROM oven/bun:1.2.22-alpine AS skeleton
WORKDIR /app
COPY _runtime_skeleton/ ./
RUN --mount=type=cache,id=control-bun-runtime-slates-hub,target=/root/.bun/install/cache bun install --production --no-frozen-lockfile
FROM oven/bun:1.2.22-alpine AS runner
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked sh -c 'attempt=1; until apk add --cache-dir /var/cache/apk curl; do code=$?; if [ "$attempt" -ge 3 ]; then exit "$code"; fi; sleep $((attempt * 2)); attempt=$((attempt + 1)); done'
COPY --from=skeleton /app ./
COPY --from=build /app/src/systems/slates/apps/hub/dist /app/dist
COPY --from=build /app/src/systems/slates/apps/hub/dist/admin /app/dist/admin
COPY --from=build /app/src/systems/slates/apps/hub/prisma /app/prisma
COPY --from=build /app/src/systems/slates/apps/hub/prisma.config.ts /app/prisma.config.ts
ENV NODE_ENV="production"
EXPOSE 52045
EXPOSE 52046
EXPOSE 52047
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:52045/ping && curl -f http://localhost:52046/ping && curl -f http://localhost:12121/ || exit 1
CMD ["sh", "-c", "bun prisma db push --accept-data-loss && bun /app/dist/index.js"]
