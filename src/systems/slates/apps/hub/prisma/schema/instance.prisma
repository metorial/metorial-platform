model SlateInstance {
  oid BigInt @id
  id  String @unique

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  lockedSlateVersionOid BigInt?
  lockedSlateVersion    SlateVersion? @relation(fields: [lockedSlateVersionOid], references: [oid], onDelete: Cascade)

  currentConfigOid BigInt?
  currentConfig    SlateInstanceConfig? @relation(fields: [currentConfigOid], references: [oid], name: "currentConfig")

  defaultAuthConfigOid BigInt?
  defaultAuthConfig    SlateAuthConfig? @relation(fields: [defaultAuthConfigOid], references: [oid], name: "defaultAuthConfig")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  configs                 SlateInstanceConfig[]
  authConfigs             SlateAuthConfig[]
  events                  SlateInstanceEvent[]
  oAuthSetups             SlateInstanceOAuthSetup[]
  usedAuthConfig          SlateAuthConfigUsedForInstance[]
  slateSessions           SlateSession[]
  slateTriggerReceivers   SlateTriggerReceiver[]
  slateTriggerEvents      SlateTriggerEvent[]
  slateTriggerEventInputs SlateTriggerEventInput[]
}

enum SlateInstanceEventType {
  slate_instance_created
  slate_config_set
  slate_auth_config_set_default
  slate_auth_credentials_updated
  slate_version_locked
  slate_version_changed
}

model SlateInstanceEvent {
  oid  BigInt                 @id
  id   String                 @unique
  type SlateInstanceEventType

  payload Json

  instanceOid BigInt
  instance    SlateInstance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model SlateInstanceConfig {
  oid BigInt @id
  id  String @unique

  instanceOid BigInt
  instance    SlateInstance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  schemaOid BigInt
  schema    SlateConfigSchema @relation(fields: [schemaOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  errorCode    String?
  errorMessage String?

  /// [AnyRecord]
  value Json

  createdAt DateTime @default(now())

  currentConfigForInstances SlateInstance[] @relation(name: "currentConfig")
}

model SlateOAuthCredentials {
  oid BigInt @id
  id  String @unique

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  clientId String
  scopes   String[]

  secretOid BigInt
  secret    Secret @relation(fields: [secretOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  authConfigs SlateAuthConfig[]
  oAuthSetups SlateInstanceOAuthSetup[]
}

enum SlateAuthConfigType {
  manual
  oauth_automated
  oauth_manual
}

model SlateAuthConfig {
  oid  BigInt              @id
  id   String              @unique
  type SlateAuthConfigType

  isProcessing Boolean

  errorCode    String?
  errorMessage String?

  tokenExpiresAt DateTime?

  /// [AuthProfile]
  profile      Json?
  profileUid   String?
  profileEmail String?
  profileName  String?

  instanceOid BigInt?
  instance    SlateInstance? @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid], onDelete: Cascade)

  authMethodOid BigInt
  authMethod    SlateAuthMethod @relation(fields: [authMethodOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  oauthCredentialsOid BigInt?
  oauthCredentials    SlateOAuthCredentials? @relation(fields: [oauthCredentialsOid], references: [oid])

  secretOid BigInt
  secret    Secret @relation(fields: [secretOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  defaultForInstances           SlateInstance[]                  @relation(name: "defaultAuthConfig")
  slateInstanceOAuthSetups      SlateInstanceOAuthSetup[]
  usingInstances                SlateAuthConfigUsedForInstance[]
  slateAuthConfigEvents         SlateAuthConfigEvent[]
  slateAuthConfigManualDecrypts SlateAuthConfigManualDecrypt[]
  slateTriggerReceivers         SlateTriggerReceiver[]
}

model SlateAuthConfigManualDecrypt {
  oid BigInt @id

  configOid BigInt
  config    SlateAuthConfig @relation(fields: [configOid], references: [oid], onDelete: Cascade)

  note String

  createdAt DateTime @default(now())
}

model SlateAuthConfigUsedForInstance {
  oid BigInt @id

  configOid BigInt
  config    SlateAuthConfig @relation(fields: [configOid], references: [oid])

  instanceOid BigInt
  instance    SlateInstance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([configOid, instanceOid])
}

enum SlateAuthConfigEventType {
  oauth_token_refresh_completed
  oauth_token_refresh_failed
}

model SlateAuthConfigEvent {
  oid  BigInt                   @id
  type SlateAuthConfigEventType

  configOid BigInt
  config    SlateAuthConfig @relation(fields: [configOid], references: [oid], onDelete: Cascade)

  invocationOid BigInt?
  invocation    SlateInvocation? @relation(fields: [invocationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum SlateInstanceOAuthSetupStatus {
  unused
  opened
  completed
  failed
}

model SlateInstanceOAuthSetup {
  oid    BigInt                        @id
  id     String                        @unique
  status SlateInstanceOAuthSetupStatus @default(unused)

  redirectUrl         String
  callbackUrlOverride String?

  errorCode    String?
  errorMessage String?

  oauthCredentialsOid BigInt
  oauthCredentials    SlateOAuthCredentials @relation(fields: [oauthCredentialsOid], references: [oid])

  authMethodOid BigInt
  authMethod    SlateAuthMethod @relation(fields: [authMethodOid], references: [oid])

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  slateVersionOid BigInt
  slateVersion    SlateVersion @relation(fields: [slateVersionOid], references: [oid])

  slateInstanceOid BigInt?
  slateInstance    SlateInstance? @relation(fields: [slateInstanceOid], references: [oid])

  slateAuthConfigOid BigInt?
  slateAuthConfig    SlateAuthConfig? @relation(fields: [slateAuthConfigOid], references: [oid])

  secretOid BigInt
  secret    Secret @relation(fields: [secretOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  events SlateInstanceOAuthSetupEvent[]
}

enum SlateInstanceOAuthSetupEventType {
  setup_link_opened
  get_authorization_url
  exchange_authorization_code
  access_token_received
  oauth_setup_completed
  oauth_setup_failed
}

model SlateInstanceOAuthSetupEvent {
  oid  BigInt                           @id
  type SlateInstanceOAuthSetupEventType

  setupOid BigInt
  setup    SlateInstanceOAuthSetup @relation(fields: [setupOid], references: [oid], onDelete: Cascade)

  invocationOid BigInt?
  invocation    SlateInvocation? @relation(fields: [invocationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
}
