# generated by control bootstrap
FROM oven/bun:1.2 AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/ ./
RUN bun install --linker=hoisted
FROM deps AS build
WORKDIR /app
COPY _inputs/ ./
RUN cd /app && bun x nx run-many --target=prisma:generate --projects=@metorial/ares,@metorial/forge,@metorial/function-bay,@metorial/signal,@metorial/slates
RUN cd /app && bun x nx run-many --target=admin:build --projects=@metorial/slates
RUN cd /app && bun x nx run @metorial/slates:server:build
FROM build AS workspace
WORKDIR /app/src/systems/slates/apps/hub
CMD ["sleep", "infinity"]
FROM oven/bun:1.2-alpine AS runner
WORKDIR /app
RUN apk add --no-cache curl
COPY --from=build /app/src/systems/slates/apps/hub/dist /app/dist
COPY --from=build /app/src/systems/slates/apps/hub/admin/dist /app/admin/dist
COPY --from=build /app/src/systems/slates/apps/hub/prisma /app/prisma
COPY --from=build /app/node_modules /app/node_modules
ENV NODE_ENV="production"
EXPOSE 52045
EXPOSE 52046
EXPOSE 52047
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:52045/ping && curl -f http://localhost:52046/ping && curl -f http://localhost:12121/ || exit 1
CMD ["sh", "-c", "bun prisma db push --accept-data-loss && bun /app/dist/index.js"]
