# generated by control bootstrap
FROM oven/bun:1.2 AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates && rm -rf /var/lib/apt/lists/*
COPY _manifests/ ./
RUN bun install --linker=hoisted
FROM deps AS build
WORKDIR /app
COPY _inputs/ ./
RUN cd /app && bun x nx run-many --target=prisma:generate --projects=@metorial/slates-registry
RUN cd /app && bun x nx run-many --target=admin:build --projects=@metorial/slates-registry
RUN cd /app && bun x nx run @metorial/slates-registry:server:build
FROM build AS workspace
WORKDIR /app/src/systems/slates/apps/registry
CMD ["sleep", "infinity"]
FROM oven/bun:1.2-alpine AS runner
WORKDIR /app
RUN apk add --no-cache curl
COPY --from=build /app/src/systems/slates/apps/registry/dist /app/dist
COPY --from=build /app/src/systems/slates/apps/registry/admin/dist /app/admin/dist
COPY --from=build /app/src/systems/slates/apps/registry/prisma /app/prisma
COPY --from=build /app/node_modules /app/node_modules
ENV NODE_ENV="production"
EXPOSE 52040
EXPOSE 52041
EXPOSE 52042
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:52040/ping && curl -f http://localhost:52041/ping && curl -f http://localhost:12121/ || exit 1
CMD ["sh", "-c", "bun prisma db push --schema prisma/schema.prisma --accept-data-loss && bun /app/dist/index.js"]
