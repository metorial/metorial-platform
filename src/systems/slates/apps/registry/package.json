{
  "name": "@metorial/slates-registry",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "check-types": "tsc --noEmit -p tsconfig.server.json",
    "server:build": "bun run check-types && ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps:if-token",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-slates-registry ./dist && sentry-cli sourcemaps upload --org metorial --project mte-slates-registry ./dist",
    "sentry:sourcemaps:if-token": "sh -c 'if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps; else echo \"Skipping Sentry sourcemap upload\"; fi'",
    "server:start": "bun ./dist/index.js",
    "dev": "bun --watch ./src/server.ts",
    "enterprise:dev": "bun run dev",
    "prisma:generate": "bun run db:generate",
    "prisma:push": "bun run db:push:dev",
    "db:generate": "bun prisma generate --schema prisma/schema.prisma",
    "db:push:dev": "bun prisma db push --schema prisma/schema.prisma --accept-data-loss",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:dev": "vite --config admin/vite.config.ts",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts",
    "typecheck": "bun run check-types && bun run admin:typecheck",
    "admin:typecheck": "tsc --noEmit --project admin/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/minimatch": "^6.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/tar-stream": "^3.1.4",
    "@vercel/ncc": "^0.38.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.0.17",
    "@mtsrc/testing-tools": "1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@hono/zod-validator": "^0.7.6",
    "@metorial-io/data-hooks": "^1.0.1",
    "@metorial-io/layout": "^1.0.1",
    "@metorial-io/ui": "^1.0.0",
    "@metorial-io/ui-product": "^1.0.0",
    "@metorial-platform-systems/ares-client": "^1.0.0",
    "@metorial/util-endpoint": "^1.0.1",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "@remixicon/react": "^4.0.0",
    "@sentry/bun": "^10.36.0",
    "@sentry/cli": "^3.2.0",
    "@types/semver": "^7.7.1",
    "@types/unzipper": "^0.10.11",
    "date-fns": "^4.1.0",
    "hono": "^4.11.3",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.22",
    "@metorial-platform-systems/object-storage-client": "workspace:*",
    "prisma": "7.4.2",
    "prisma-json-types-generator": "^4.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^6.26.1",
    "semver": "^7.7.3",
    "styled-components": "^6.1.13",
    "tar-stream": "^3.1.8",
    "unzipper": "^0.12.3",
    "yaml": "^2.8.2",
    "@mtsrc/api-key": "1.0.0",
    "@mtsrc/api-mux": "1.0.0",
    "@mtsrc/cache": "1.0.0",
    "@mtsrc/canonicalize": "1.0.0",
    "@mtsrc/cron": "1.0.0",
    "@mtsrc/encryption": "1.0.0",
    "@mtsrc/env": "1.0.0",
    "@mtsrc/error": "1.0.0",
    "@mtsrc/hash": "1.0.0",
    "@mtsrc/hono": "1.0.0",
    "@mtsrc/id": "1.0.0",
    "@mtsrc/lock": "1.0.0",
    "@mtsrc/once": "1.0.0",
    "@mtsrc/pagination": "1.0.0",
    "@mtsrc/queue": "1.0.0",
    "@mtsrc/rpc-client": "1.0.0",
    "@mtsrc/rpc-server": "1.0.0",
    "@mtsrc/sentry": "1.0.0",
    "@mtsrc/service": "1.0.0",
    "@mtsrc/shadow-id": "1.0.0",
    "@mtsrc/slugify": "1.0.0",
    "@mtsrc/snowflake": "1.0.0",
    "@mtsrc/validation": "1.0.0"
  }
}
