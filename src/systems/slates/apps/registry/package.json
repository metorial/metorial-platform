{
  "name": "slates-registry",
  "module": "index.ts",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run server:start",
    "server:build": "ncc build ./src/server.ts -o ./dist --source-map --transpile-only && bun run sentry:sourcemaps",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org metorial --project mte-slates-registry ./dist && sentry-cli sourcemaps upload --org metorial --project mte-slates-registry ./dist",
    "server:start": "bun ./dist/index.js",
    "dev": "docker compose -p slates-registry -f ./docker-compose.dev.yml up --pull always --build slates-registry object-storage",
    "infra:up": "docker compose -p slates-registry -f ./docker-compose.dev.yml up --pull always --build slates-registry object-storage",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:dev": "vite --config admin/vite.config.ts",
    "typecheck": "tsc --noEmit && bun run admin:typecheck",
    "admin:typecheck": "tsc --noEmit --project admin/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/ncc": "^0.38.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "@types/minimatch": "^6.0.0",
    "vite": "^5.4.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@hono/zod-validator": "^0.7.6",
    "@lowerdeck/api-key": "^1.0.2",
    "@lowerdeck/api-mux": "^1.0.2",
    "@lowerdeck/cache": "^1.0.1",
    "@lowerdeck/canonicalize": "^1.0.4",
    "@lowerdeck/cron": "^1.0.7",
    "@lowerdeck/encryption": "^1.0.7",
    "@lowerdeck/env": "^1.0.4",
    "@lowerdeck/error": "^1.1.0",
    "@lowerdeck/hash": "^1.0.4",
    "@lowerdeck/hono": "^1.0.7",
    "@lowerdeck/id": "^1.0.6",
    "@lowerdeck/lock": "^1.0.5",
    "@lowerdeck/once": "^1.0.4",
    "@lowerdeck/pagination": "^1.0.5",
    "@lowerdeck/queue": "^1.0.7",
    "@lowerdeck/rpc-client": "^1.1.0",
    "@lowerdeck/rpc-server": "^1.0.7",
    "@lowerdeck/sentry": "^1.0.2",
    "@lowerdeck/service": "^1.0.3",
    "@lowerdeck/shadow-id": "^1.0.7",
    "@lowerdeck/slugify": "^1.0.5",
    "@lowerdeck/snowflake": "^1.0.2",
    "@lowerdeck/validation": "^1.0.4",
    "@metorial-io/data-hooks": "^1.0.1",
    "@metorial-io/layout": "^1.0.1",
    "@metorial-io/ui": "^1.0.0",
    "@metorial-io/ui-product": "^1.0.0",
    "@metorial-services/ares-client": "^1.0.6",
    "@metorial/util-endpoint": "^1.0.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@remixicon/react": "^4.0.0",
    "@sentry/bun": "^10.36.0",
