enum CustomServerVersionStatus {
  available

  deploying
  deployment_failed
}

enum CustomServerVersionOAuthCredentialProvider {
  none
  manual
  auto_registration
}

model CustomServerVersion {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status CustomServerVersionStatus

  oauthCredentialProvider CustomServerVersionOAuthCredentialProvider @default(none)

  versionIndex Int
  versionHash  String

  customServerOid BigInt
  customServer    CustomServer @relation(fields: [customServerOid], references: [oid])

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  serverVersionOid BigInt?        @unique
  serverVersion    ServerVersion? @relation(fields: [serverVersionOid], references: [oid])

  deploymentOid BigInt?                 @unique
  deployment    CustomServerDeployment? @relation(fields: [deploymentOid], references: [oid])

  currentVersionForServer CustomServer? @relation(name: "CurrentCustomServerVersion")

  remoteServerInstanceOid BigInt?               @unique
  remoteServerInstance    RemoteServerInstance? @relation(fields: [remoteServerInstanceOid], references: [oid])

  lambdaServerInstanceOid BigInt?               @unique
  lambdaServerInstance    LambdaServerInstance? @relation(fields: [lambdaServerInstanceOid], references: [oid])

  dockerServerInstanceOid BigInt?               @unique
  dockerServerInstance    DockerServerInstance? @relation(fields: [dockerServerInstanceOid], references: [oid])

  pushOid BigInt?      @unique
  push    ScmRepoPush? @relation(fields: [pushOid], references: [oid], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  events CustomServerEvent[]
}
