enum MagicMcpServerStatus {
  active
  archived
  deleted
}

enum MagicMcpServerSource {
  manual
  consumer_provider_template
}

enum MagicMcpServerOwnerType {
  server_owned
  provider_template
  integration
}

model MagicMcpServer {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status               MagicMcpServerStatus
  source               MagicMcpServerSource    @default(manual)
  ownerType            MagicMcpServerOwnerType @default(server_owned)
  isConsumerReconciled Boolean                 @default(false)
  hasSubspaceBacking   Boolean                 @default(false)
  isSubspaceBackingReconciling Boolean         @default(false)

  providerTemplateId                String?
  legacySubspaceSessionTemplateId   String? @map("subspaceSessionTemplateId")
  subspaceIntegrationInstanceId     String?
  subspaceEphemeralManagedSessionId String?

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  name        String?
  description String?
  metadata    Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  aliases         MagicMcpServerAlias[]
  subspaceSession MagicMcpSession?
  endpoints       MagicMcpEndpointServer[]

  tokens                 MagicMcpToken[]
  uses                   MagicMcpTokenUse[]
  groups                 MagicMcpGroupServer[]
  accessTagEntities      AccessTagEntity[]
  consumerAccesses       ConsumerAccess[]        @relation("ConsumerAccessMagicMcpServer")
  accessRequests         ConsumerAccessRequest[] @relation("ConsumerAccessRequestMagicMcpServer")
  consumerAuthClients    ConsumerAuthClient[]
  consumerAccessListings ConsumerAccessListing[]
  consumerIntegrations   ConsumerIntegration[]
}

model MagicMcpServerAlias {
  oid  BigInt @id @default(autoincrement())
  slug String @unique

  serverOid BigInt
  server    MagicMcpServer @relation(fields: [serverOid], references: [oid], onDelete: Cascade)
}
