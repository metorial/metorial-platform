enum MagicMcpTokenStatus {
  active
  deleted
}

enum MagicMcpTokenType {
  default
  consumer
}

model MagicMcpToken {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status MagicMcpTokenStatus
  type   MagicMcpTokenType   @default(default)

  isGroupLocked Boolean @default(false)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  secret String @unique

  name        String?
  description String?

  metadata Json

  consumerProfileOid BigInt?
  consumerProfile    ConsumerProfile? @relation(fields: [consumerProfileOid], references: [oid])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  magicMcpSessions MagicMcpSession[]
  groups           MagicMcpGroupToken[]
  accessTags       AccessTagEntity[]
}
