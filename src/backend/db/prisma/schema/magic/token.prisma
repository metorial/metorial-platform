enum MagicMcpTokenStatus {
  active
  deleted
}

model MagicMcpToken {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status MagicMcpTokenStatus

  isGroupLocked Boolean @default(false)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  magicMcpServerOid BigInt?
  magicMcpServer    MagicMcpServer? @relation(fields: [magicMcpServerOid], references: [oid], onDelete: Cascade)

  secret String @unique

  name        String?
  description String?
  metadata    Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  groups            MagicMcpGroupToken[]
  accessTagEntities AccessTagEntity[]
}
