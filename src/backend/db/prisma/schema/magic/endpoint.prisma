enum MagicMcpEndpointStatus {
  active
  archived
  deleted
}

model MagicMcpEndpoint {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status               MagicMcpEndpointStatus
  isConsumerReconciled Boolean                @default(false)
  hasSubspaceBacking   Boolean                @default(false)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  consumerProfileOid BigInt?
  consumerProfile    ConsumerProfile? @relation(fields: [consumerProfileOid], references: [oid], onDelete: SetNull)

  legacySubspaceSessionTemplateId   String? @map("subspaceSessionTemplateId")
  subspaceEphemeralManagedSessionId String?
  configurationHash                 String?

  name        String?
  description String?
  slug        String  @unique
  metadata    Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  servers                      MagicMcpEndpointServer[]
  subspaceSession              MagicMcpSession[]
  tokens                       MagicMcpToken[]
  uses                         MagicMcpTokenUse[]
  accessTagEntities            AccessTagEntity[]
  consumerAuthClients          ConsumerAuthClient[]
  consumerAuthAttempts         ConsumerAuthAttempt[]
  consumerIntegrationEndpoints ConsumerIntegrationEndpoint[]
}

model MagicMcpEndpointServer {
  oid BigInt  @id @default(autoincrement())
  id  String? @unique

  magicMcpEndpointOid BigInt
  magicMcpEndpoint    MagicMcpEndpoint @relation(fields: [magicMcpEndpointOid], references: [oid], onDelete: Cascade)

  magicMcpServerOid BigInt
  magicMcpServer    MagicMcpServer @relation(fields: [magicMcpServerOid], references: [oid], onDelete: Cascade)

  toolFilters Json?

  createdAt DateTime @default(now())

  @@unique([magicMcpEndpointOid, magicMcpServerOid])
}
