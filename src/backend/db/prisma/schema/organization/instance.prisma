enum InstanceType {
  development
  production
}

enum InstanceStatus {
  active
  deleted
}

model Instance {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type   InstanceType
  status InstanceStatus

  slug String @unique
  name String

  defaultCallbackPollingIntervalSeconds Int @default(1800)

  projectOid BigInt
  project    Project @relation(fields: [projectOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  internalTenantIdentifier      String?
  internalEnvironmentIdentifier String?

  subspaceTenantId  String?
  cargoTenantId     String?
  synthesisTenantId String?

  subspaceEnvironmentId  String?
  cargoEnvironmentId     String?
  synthesisEnvironmentId String?
  lastSubspaceSyncAt     DateTime?

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  machineAccesses                      MachineAccess[]
  fineGrainedKeys                      FineGrainedKey[]
  sessionClientSecretReferences        SessionClientSecretReference[]
  files                                File[]
  secrets                              Secret[]
  uploads                              Upload[]
  accessTags                           AccessTag[]
  magicMcpGroups                       MagicMcpGroup[]
  magicMcpEndpoints                    MagicMcpEndpoint[]
  magicMcpServers                      MagicMcpServer[]
  magicMcpTokens                       MagicMcpToken[]
  consumerSurfaces                     ConsumerSurface[]
  consumerProviderSetupSessionBindings ConsumerProviderSetupSessionBinding[]
  consumers                            ConsumerProfile[]
  portals                              Portal[]
  providerTemplates                    ProviderTemplate[]
  skills                               Skill[]
  skillTemplates                       SkillTemplate[]
  skillGroups                          SkillGroup[]
  consumerSkills                       ConsumerSkill[]
  accessPolicyInstances                AccessPolicyInstance[]
  instanceConsumers                    InstanceConsumer[]
  consumerInvites                      ConsumerInvite[]
  consumerActors                       ConsumerActor[]
  consumerTokens                       ConsumerToken[]
  consumerIntegrations                 ConsumerIntegration[]
  consumerIntegrationEndpoints         ConsumerIntegrationEndpoint[]
  consumerIntegrationSessions          ConsumerIntegrationSession[]
  magicMcpSessions                     MagicMcpSession[]
}
