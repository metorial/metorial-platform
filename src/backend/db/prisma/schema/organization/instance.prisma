enum InstanceType {
  development
  production
}

enum InstanceStatus {
  active
  deleted
}

model Instance {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type   InstanceType
  status InstanceStatus

  slug String @unique
  name String

  defaultCallbackPollingIntervalSeconds Int @default(1800)

  projectOid BigInt
  project    Project @relation(fields: [projectOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  subspaceTenantId         String?
  subspaceTenantIdentifier String?

  subspaceEnvironmentId         String?
  subspaceEnvironmentIdentifier String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  machineAccesses MachineAccess[]
  files           File[]
  secrets         Secret[]
  uploads         Upload[]
  accessTags      AccessTag[]

  subspaceReferenceDeployments     SubspaceReferenceDeployment[]
  subspaceReferenceConfigs         SubspaceReferenceConfig[]
  subspaceReferenceConfigVaults    SubspaceReferenceConfigVault[]
  subspaceReferenceAuthConfigs     SubspaceReferenceAuthConfig[]
  subspaceReferenceAuthCredentials SubspaceReferenceAuthCredentials[]
  subspaceReferenceGroups          SubspaceReferenceGroup[]
  subspaceReferenceSetupSessions   SubspaceReferenceSetupSession[]
  subspaceReferenceAuthImports     SubspaceReferenceAuthImport[]
  subspaceReferenceAuthExports     SubspaceReferenceAuthExport[]
}
