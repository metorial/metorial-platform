enum EnvironmentType {
  development
  production
}

enum EnvironmentStatus {
  active
  deleted
}

model Environment {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type   EnvironmentType
  status EnvironmentStatus

  name String

  instanceOid BigInt   @unique
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  creatorActorOid BigInt
  creatorActor    OrganizationActor @relation(fields: [creatorActorOid], references: [oid], onDelete: Cascade)

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt
}

enum SandboxStatus {
  active
  deleted
}

model Sandbox {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status SandboxStatus

  name String

  instanceOid BigInt   @unique
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  creatorActorOid BigInt
  creatorActor    OrganizationActor @relation(fields: [creatorActorOid], references: [oid], onDelete: Cascade)

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt
}

enum InstanceType {
  development
  production
}

enum InstanceStatus {
  active
  deleted
}

model Instance {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type   InstanceType
  status InstanceStatus

  slug          String   @unique
  previousSlugs String[]
  name          String

  hasBeenReconciled Boolean @default(false)

  projectOid BigInt
  project    Project @relation(fields: [projectOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  internalTenantIdentifier      String? @map("subspaceTenantIdentifier")
  internalEnvironmentIdentifier String? @map("subspaceEnvironmentIdentifier")

  subspaceTenantId  String?
  cargoTenantId     String?
  synthesisTenantId String?

  subspaceEnvironmentId  String?
  cargoEnvironmentId     String?
  synthesisEnvironmentId String?
  lastSubspaceSyncAt     DateTime?

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  machineAccesses                      MachineAccess[]
  fineGrainedKeys                      FineGrainedKey[]
  sessionClientSecretReferences        SessionClientSecretReference[]
  files                                File[]
  secrets                              Secret[]
  uploads                              Upload[]
  accessTags                           AccessTag[]
  magicMcpGroups                       MagicMcpGroup[]
  magicMcpEndpoints                    MagicMcpEndpoint[]
  magicMcpServers                      MagicMcpServer[]
  magicMcpTokens                       MagicMcpToken[]
  consumerSurfaces                     ConsumerSurface[]
  consumerProviderSetupSessionBindings ConsumerProviderSetupSessionBinding[]
  consumers                            ConsumerProfile[]
  portals                              Portal[]
  providerTemplates                    ProviderTemplate[]
  skills                               Skill[]
  skillTemplates                       SkillTemplate[]
  skillGroups                          SkillGroup[]
  skillMarketplaces                    SkillMarketplace[]
  skillPlugins                         SkillPlugin[]
  consumerSkills                       ConsumerSkill[]
  accessPolicyInstances                AccessPolicyInstance[]
  instanceConsumers                    InstanceConsumer[]
  consumerInvites                      ConsumerInvite[]
  consumerActors                       ConsumerActor[]
  consumerTokens                       ConsumerToken[]
  consumerIntegrations                 ConsumerIntegration[]
  consumerIntegrationEndpoints         ConsumerIntegrationEndpoint[]
  consumerIntegrationSessions          ConsumerIntegrationSession[]
  magicMcpSessions                     MagicMcpSession[]
  consumerClients                      ConsumerClient[]
  consumerAuthClients                  ConsumerAuthClient[]
  consumerAuthTestAuthorizations       ConsumerAuthTestAuthorization[]
  environment                          Environment?
  sandbox                              Sandbox?

  @@index([previousSlugs])
}
