enum ProjectStatus {
  active
  deleted
}

model Project {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status ProjectStatus

  slug String @unique
  name String

  onlyAllowTrustedProviders      Boolean @default(false)
  magicMcpSessionDurationMinutes Int     @default(1440)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  internalTenantIdentifier String?

  subspaceTenantId  String?
  cargoTenantId     String?
  synthesisTenantId String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  instances            Instance[]
  accessPolicyProjects AccessPolicyProject[]
  brand                ProjectBrand?
  teams                TeamProject[]
}
