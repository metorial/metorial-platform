// ************************************************************
// Organization
// ************************************************************

enum OrganizationType {
  default
  user
}

enum OrganizationStatus {
  active
  deleted
}

enum OrganizationAuthVersion {
  v1
  v2
}

model Organization {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type        OrganizationType
  status      OrganizationStatus
  authVersion OrganizationAuthVersion @default(v1)

  enforceTeamAccess Boolean @default(false)

  ignoreAndDoNotUse_canCreateGlobalOauthApps Boolean @default(false) @map("canCreateGlobalOauthApps")

  slug          String   @unique
  previousSlugs String[]
  name          String

  /// [EntityImage]
  image Json

  internalTenantIdentifier String?

  subspaceTenantIds  String[]
  cargoTenantId      String?
  cargoEnvironmentId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  invites                        OrganizationInvite[]
  members                        OrganizationMember[]
  actors                         OrganizationActor[]
  instances                      Instance[]
  userConfigs                    OrganizationUserConfig[]
  projects                       Project[]
  machineAccesses                MachineAccess[]
  files                          File[]
  secrets                        Secret[]
  profile                        Profile?
  uploads                        Upload[]
  accessLimiters                 AccessLimiter[]
  team                           Team[]
  accessTagPolicies              AccessTagPolicy[]
  consumerSurfaces               ConsumerSurface[]
  consumerAuthTenants            ConsumerAuthTenant[]
  consumers                      Consumer[]
  consumerProfiles               ConsumerProfile[]
  consumerInvites                ConsumerInvite[]
  portals                        Portal[]
  providerTemplates              ProviderTemplate[]
  skills                         Skill[]
  skillTemplates                 SkillTemplate[]
  skillGroups                    SkillGroup[]
  skillMarketplaces              SkillMarketplace[]
  skillPlugins                   SkillPlugin[]
  consumerSkills                 ConsumerSkill[]
  oauthApplications              OAuthApplication[]
  oauthInstallations             OAuthInstallation[]
  oauthAuthorizations            OAuthAuthorization[]
  cliDevices                     CliDevice[]
  serviceAccounts                ServiceAccount[]
  oauthAuthorizationFlows        OAuthAuthorizationFlow[]
  accessRoles                    AccessRole[]
  accessPolicies                 AccessPolicy[]
  apiKeyCreatedEmailSends        ApiKeyCreatedEmailSend[]
  apiKeyExpiredEmailSends        ApiKeyExpiredEmailSend[]
  consumerActors                 ConsumerActor[]
  consumerClients                ConsumerClient[]
  consumerAuthClients            ConsumerAuthClient[]
  consumerAuthTestAuthorizations ConsumerAuthTestAuthorization[]

  @@index([authVersion])
  @@index([previousSlugs])
}
