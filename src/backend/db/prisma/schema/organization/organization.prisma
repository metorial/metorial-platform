// ************************************************************
// Organization
// ************************************************************

enum OrganizationType {
  default
  user
}

enum OrganizationStatus {
  active
  deleted
}

model Organization {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type   OrganizationType
  status OrganizationStatus

  enforceTeamAccess Boolean @default(false)

  slug String @unique
  name String

  /// [EntityImage]
  image Json

  subspaceTenantIds String[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  invites           OrganizationInvite[]
  members           OrganizationMember[]
  actors            OrganizationActor[]
  instances         Instance[]
  userConfigs       OrganizationUserConfig[]
  projects          Project[]
  machineAccesses   MachineAccess[]
  files             File[]
  secrets           Secret[]
  profile           Profile?
  uploads           Upload[]
  accessLimiters    AccessLimiter[]
  team              Team[]
  teamRole          TeamRole[]
  accessTagPolicies AccessTagPolicy[]
}
