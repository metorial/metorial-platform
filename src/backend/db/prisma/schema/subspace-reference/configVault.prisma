model SubspaceReferenceConfigVault {
  oid BigInt @id @default(autoincrement())
  id  String // Subspace-generated ID

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  providerId           String
  providerDeploymentId String?
  name                 String?
  isEphemeral          Boolean @default(false)

  subspaceCreatedAt DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([instanceOid, id])
}
