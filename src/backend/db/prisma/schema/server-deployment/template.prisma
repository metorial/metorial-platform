model ServerDeploymentTemplate {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name        String
  description String?

  serverOid BigInt
  server    Server @relation(fields: [serverOid], references: [oid])

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  oauthConfigClientId     String?
  oauthConfigClientSecret String?

  configSecretOid BigInt?
  configSecret    Secret? @relation(fields: [configSecretOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  consumerAccesses ConsumerAccess[]
  accessTags       AccessTagEntity[]
}
