model ServerListingCollection {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name        String
  slug        String @unique
  description String

  isPublic Boolean @default(true)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  listings ServerListing[]
  portals  Portal[]
}

model ServerListingCategory {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name        String
  slug        String @unique
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  listings ServerListing[]
}
