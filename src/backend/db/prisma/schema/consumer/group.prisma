enum ConsumerGroupStatus {
  active
  inactive
}

model ConsumerGroup {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status ConsumerGroupStatus

  isDefault   Boolean  @default(false)
  ssoGroupIds String[]

  name        String
  description String?

  surfaceOid BigInt
  surface    ConsumerSurface @relation(fields: [surfaceOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  profiles         ConsumerProfileGroup[]
  consumerAccesses ConsumerAccess[]
}
