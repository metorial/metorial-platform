enum ProviderTemplateStatus {
  active
  archived
  deleted
}

model ProviderTemplate {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status ProviderTemplateStatus

  name        String
  description String?
  metadata    Json

  legacyProviderDeploymentId String? @map("providerDeploymentId")
  hasSubspaceBacking         Boolean @default(false)
  subspaceIntegrationId      String?

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  accessTagEntities            AccessTagEntity[]
  consumerAccesses             ConsumerAccess[]                      @relation("ConsumerAccessProviderTemplate")
  accessRequests               ConsumerAccessRequest[]               @relation("ConsumerAccessRequestProviderTemplate")
  providerSetupSessionBindings ConsumerProviderSetupSessionBinding[]
  consumerAccessListings       ConsumerAccessListing[]

  @@unique([instanceOid, legacyProviderDeploymentId])
}
