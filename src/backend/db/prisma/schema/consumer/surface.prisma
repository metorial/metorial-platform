enum ConsumerSurfaceStatus {
  active
  inactive
}

model ConsumerSurface {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status ConsumerSurfaceStatus

  name        String
  description String?

  sessionExpiryTimeInSeconds Int

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  consumerProfiles           ConsumerProfile[]
  consumerSurfaceAuthFactors ConsumerSurfaceAuthFactor[]
  portals                    Portal[]
  consumerGroups             ConsumerGroup[]
  consumerAccesses           ConsumerAccess[]
}

enum ConsumerAccessType {
  magic_mcp_group
}

model ConsumerAccess {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type ConsumerAccessType

  surfaceOid BigInt
  surface    ConsumerSurface @relation(fields: [surfaceOid], references: [oid])

  magicMcpGroupOid BigInt?
  magicMcpGroup    MagicMcpGroup? @relation(fields: [magicMcpGroupOid], references: [oid])

  consumerGroupOid BigInt
  consumerGroup    ConsumerGroup @relation(fields: [consumerGroupOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
