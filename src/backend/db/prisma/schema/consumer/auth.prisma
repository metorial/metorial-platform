enum ConsumerSurfaceAuthFactorType {
  email_code
  sso
}

enum ConsumerSurfaceAuthFactorStatus {
  active
  inactive
}

model ConsumerSurfaceAuthFactor {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type   ConsumerSurfaceAuthFactorType
  status ConsumerSurfaceAuthFactorStatus

  emailSlug String? @unique

  name       String
  publicName String

  consumerSurfaceOid BigInt
  consumerSurface    ConsumerSurface @relation(fields: [consumerSurfaceOid], references: [oid])

  ssoTenantOid BigInt?
  ssoTenant    SsoTenant? @relation(fields: [ssoTenantOid], references: [oid])

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  consumerAuthCodes ConsumerAuthCode[]
}

enum ConsumerAuthCodeStatus {
  sent
  verified
}

enum ConsumerAuthCodeDeliveryMethod {
  email
}

model ConsumerAuthCode {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status         ConsumerAuthCodeStatus
  deliveryMethod ConsumerAuthCodeDeliveryMethod

  code      String
  expiresAt DateTime

  email String

  factorOid BigInt
  factor    ConsumerSurfaceAuthFactor @relation(fields: [factorOid], references: [oid])

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  consumedAt DateTime?
}

model ConsumerSession {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  tokenNonce String @unique

  consumerProfileOid BigInt
  consumerProfile    ConsumerProfile @relation(fields: [consumerProfileOid], references: [oid])

  ua String
  ip String

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now()) @updatedAt
}
