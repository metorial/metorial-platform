enum ConsumerAccessTargetType {
  provider_template
  magic_mcp_server
}

model ConsumerAccess {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type ConsumerAccessTargetType

  surfaceOid BigInt
  surface    ConsumerSurface @relation(fields: [surfaceOid], references: [oid], onDelete: Cascade)

  consumerGroupOid BigInt
  consumerGroup    ConsumerGroup @relation(fields: [consumerGroupOid], references: [oid], onDelete: Cascade)

  providerTemplateOid BigInt?
  providerTemplate    ProviderTemplate? @relation("ConsumerAccessProviderTemplate", fields: [providerTemplateOid], references: [oid], onDelete: Cascade)

  magicMcpServerOid BigInt?
  magicMcpServer    MagicMcpServer? @relation("ConsumerAccessMagicMcpServer", fields: [magicMcpServerOid], references: [oid], onDelete: Cascade)

  listingOid BigInt?
  listing    ConsumerAccessListing? @relation(fields: [listingOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([consumerGroupOid, providerTemplateOid])
  @@unique([consumerGroupOid, magicMcpServerOid])
}

model ConsumerAccessListing {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name        String
  description String?
  readme      String?

  surfaceOid BigInt
  surface    ConsumerSurface @relation(fields: [surfaceOid], references: [oid], onDelete: Cascade)

  providerTemplateOid BigInt?
  providerTemplate    ProviderTemplate? @relation(fields: [providerTemplateOid], references: [oid], onDelete: Cascade)

  magicMcpServerOid BigInt?
  magicMcpServer    MagicMcpServer? @relation(fields: [magicMcpServerOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  consumerAccesses              ConsumerAccess[]
  consumerSurfaceProviderGroups ConsumerSurfaceProviderGroupListing[]

  @@unique([surfaceOid, providerTemplateOid])
  @@unique([surfaceOid, magicMcpServerOid])
}
