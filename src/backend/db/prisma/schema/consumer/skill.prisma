enum SkillStatus {
  active
  archived
  deleted
}

enum SkillTemplateStatus {
  active
  archived
  deleted
}

enum SkillTemplateOwner {
  system
  tenant
}

enum SkillGroupStatus {
  active
  archived
  deleted
}

enum SkillGroupItemStatus {
  active
  archived
  deleted
}

enum SkillOwnerType {
  instance
  consumer
}

enum ConsumerSkillPermission {
  read
  write
}

enum ConsumerSkillSource {
  access
  owner
}

model Skill {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status SkillStatus @default(active)

  name String

  /// [EntityImage]
  image Json?

  storeId       String
  skillEntityId String

  ownerType SkillOwnerType @default(instance)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  createdByOrganizationActorOid BigInt?
  createdByOrganizationActor    OrganizationActor? @relation(fields: [createdByOrganizationActorOid], references: [oid], onDelete: SetNull)

  createdByConsumerOid BigInt?
  createdByConsumer    Consumer? @relation(fields: [createdByConsumerOid], references: [oid], onDelete: SetNull)

  createdByConsumerProfileOid BigInt?
  createdByConsumerProfile    ConsumerProfile? @relation(fields: [createdByConsumerProfileOid], references: [oid], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  accessTagEntities      AccessTagEntity[]
  consumerAccesses       ConsumerAccess[]        @relation("ConsumerAccessSkill")
  consumerAccessListings ConsumerAccessListing[]
  consumerSkills         ConsumerSkill[]
  skillGroupItems        SkillGroupItem[]

  @@index([instanceOid, status])
  @@index([instanceOid, storeId])
  @@index([createdByConsumerProfileOid])
}

model SkillTemplate {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status SkillTemplateStatus @default(active)
  owner  SkillTemplateOwner

  slug        String
  name        String
  description String?
  metadata    Json?

  storeId         String?
  storeTemplateId String

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  accessTagEntities      AccessTagEntity[]
  consumerAccesses       ConsumerAccess[]        @relation("ConsumerAccessSkillTemplate")
  consumerAccessListings ConsumerAccessListing[]

  @@index([instanceOid, status])
  @@index([instanceOid, storeTemplateId])
}

model SkillGroup {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status SkillGroupStatus @default(active)

  name        String
  description String?
  metadata    Json?

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  items                  SkillGroupItem[]
  accessTagEntities      AccessTagEntity[]
  consumerAccesses       ConsumerAccess[]        @relation("ConsumerAccessSkillGroup")
  consumerAccessListings ConsumerAccessListing[]

  @@index([instanceOid, status])
}

model SkillGroupItem {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status SkillGroupItemStatus @default(active)

  skillGroupOid BigInt
  skillGroup    SkillGroup @relation(fields: [skillGroupOid], references: [oid], onDelete: Cascade)

  skillOid BigInt
  skill    Skill  @relation(fields: [skillOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([skillGroupOid, skillOid])
  @@index([skillOid, status])
}

model ConsumerSkill {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  source      ConsumerSkillSource
  permissions ConsumerSkillPermission[]

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  surfaceOid BigInt
  surface    ConsumerSurface @relation(fields: [surfaceOid], references: [oid], onDelete: Cascade)

  consumerProfileOid BigInt
  consumerProfile    ConsumerProfile @relation(fields: [consumerProfileOid], references: [oid], onDelete: Cascade)

  consumerOid BigInt
  consumer    Consumer @relation(fields: [consumerOid], references: [oid], onDelete: Cascade)

  skillOid BigInt
  skill    Skill  @relation(fields: [skillOid], references: [oid], onDelete: Cascade)

  cargoStoreParticipantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([consumerProfileOid, skillOid])
  @@index([skillOid])
  @@index([instanceOid, consumerOid])
}
