model SsoUser {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  ssoUserId String @unique

  ssoTenantOid BigInt
  ssoTenant    SsoTenant @relation(fields: [ssoTenantOid], references: [oid], onDelete: Cascade)

  email     String
  firstName String
  lastName  String

  allRoles  String[]
  allGroups String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  profiles                SsoUserProfile[]
  consumerProfileSsoUsers ConsumerProfileSsoUser[]
}

model SsoUserProfile {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  ssoUserOid BigInt
  ssoUser    SsoUser @relation(fields: [ssoUserOid], references: [oid], onDelete: Cascade)

  ssoConnectionId String
  email           String
  uid             String
  sub             String?
  firstName       String?
  lastName        String?
  roles           String[]
  groups          String[]

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  consumerProfileSsoUsers ConsumerProfileSsoUser[]
}
