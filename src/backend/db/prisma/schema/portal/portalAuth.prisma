enum PortalAuthClientTokenEndpointAuthMethod {
  client_secret_basic
  client_secret_post
  none
}

enum PortalAuthAttemptStatus {
  pending
  authorized
  active
  denied
  revoked
}

enum PortalAuthAttemptCodeChallengeMethod {
  none
  s256
}

model PortalAuthClient {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name String

  clientId     String  @unique
  clientSecret String?

  tokenEndpointAuthMethod PortalAuthClientTokenEndpointAuthMethod @default(client_secret_basic)

  redirectUris String[]

  portalOid BigInt
  portal    Portal @relation(fields: [portalOid], references: [oid], onDelete: Cascade)

  magicMcpServerOid BigInt?
  magicMcpServer    MagicMcpServer? @relation(fields: [magicMcpServerOid], references: [oid], onDelete: Cascade)

  magicMcpEndpointOid BigInt?
  magicMcpEndpoint    MagicMcpEndpoint? @relation(fields: [magicMcpEndpointOid], references: [oid], onDelete: Cascade)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  expiresAt          DateTime
  portalAuthAttempts PortalAuthAttempt[]
}

model PortalAuthAttempt {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status PortalAuthAttemptStatus @default(pending)

  portalAuthClientOid BigInt
  portalAuthClient    PortalAuthClient @relation(fields: [portalAuthClientOid], references: [oid], onDelete: Cascade)

  redirectUri String
  state       String?

  authorizationCode          String?   @unique
  authorizationCodeExpiresAt DateTime?
  authorizationCodeUsedAt    DateTime?

  refreshToken String? @unique

  codeChallengeMethod PortalAuthAttemptCodeChallengeMethod @default(none)
  codeChallenge       String?

  consumerProfileOid BigInt?
  consumerProfile    ConsumerProfile? @relation(fields: [consumerProfileOid], references: [oid], onDelete: SetNull)

  magicMcpTokenOid BigInt?
  magicMcpToken    MagicMcpToken? @relation(fields: [magicMcpTokenOid], references: [oid], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  authorizedAt DateTime?
  deniedAt     DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime
}
