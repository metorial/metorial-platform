enum ConsumerAuthClientTokenEndpointAuthMethod {
  client_secret_basic
  client_secret_post
  none
}

enum ConsumerAuthAttemptStatus {
  pending
  authorized
  active
  denied
  revoked
}

enum ConsumerAuthAttemptCodeChallengeMethod {
  none
  s256
}

model ConsumerClient {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  hash String
  name String

  redirectUris String[]

  consumerSurfaceOid BigInt
  consumerSurface    ConsumerSurface @relation(fields: [consumerSurfaceOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  consumerAuthClients ConsumerAuthClient[]

  @@unique([consumerSurfaceOid, hash])
  @@index([hash])
}

model ConsumerAuthClient {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name String

  clientId       String  @unique
  clientSecret   String?
  registrationIp String?

  tokenEndpointAuthMethod ConsumerAuthClientTokenEndpointAuthMethod @default(client_secret_basic)

  redirectUris String[]

  consumerSurfaceOid BigInt
  consumerSurface    ConsumerSurface @relation(fields: [consumerSurfaceOid], references: [oid], onDelete: Cascade)

  magicMcpServerOid BigInt?
  magicMcpServer    MagicMcpServer? @relation(fields: [magicMcpServerOid], references: [oid], onDelete: Cascade)

  magicMcpEndpointOid BigInt?
  magicMcpEndpoint    MagicMcpEndpoint? @relation(fields: [magicMcpEndpointOid], references: [oid], onDelete: Cascade)

  consumerClientOid BigInt?
  consumerClient    ConsumerClient? @relation(fields: [consumerClientOid], references: [oid], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  expiresAt DateTime

  consumerAuthAttempts ConsumerAuthAttempt[]

  @@index([registrationIp, createdAt])
}

model ConsumerAuthAttempt {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status ConsumerAuthAttemptStatus @default(pending)

  consumerAuthClientOid BigInt
  consumerAuthClient    ConsumerAuthClient @relation(fields: [consumerAuthClientOid], references: [oid], onDelete: Cascade)

  redirectUri String
  state       String?

  authorizationCode          String?   @unique
  authorizationCodeExpiresAt DateTime?
  authorizationCodeUsedAt    DateTime?

  refreshToken String? @unique

  codeChallengeMethod ConsumerAuthAttemptCodeChallengeMethod @default(none)
  codeChallenge       String?

  consumerProfileOid BigInt?
  consumerProfile    ConsumerProfile? @relation(fields: [consumerProfileOid], references: [oid], onDelete: SetNull)

  magicMcpEndpointOid BigInt?
  magicMcpEndpoint    MagicMcpEndpoint? @relation(fields: [magicMcpEndpointOid], references: [oid], onDelete: SetNull)

  consumerIntegrationEndpointOid BigInt?
  consumerIntegrationEndpoint    ConsumerIntegrationEndpoint? @relation(fields: [consumerIntegrationEndpointOid], references: [oid], onDelete: SetNull)

  magicMcpTokenOid BigInt?
  magicMcpToken    MagicMcpToken? @relation(fields: [magicMcpTokenOid], references: [oid], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  authorizedAt DateTime?
  deniedAt     DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime

  @@index([consumerIntegrationEndpointOid])
}
