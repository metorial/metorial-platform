model AssistantImplementation {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  assistants Assistant[]
}

enum AssistantOwner {
  metorial
  organization
}

model Assistant {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  ownerType AssistantOwner

  organizationOid BigInt?
  organization    Organization? @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  implementationOid BigInt
  implementation    AssistantImplementation @relation(fields: [implementationOid], references: [oid], onDelete: Cascade)

  name             String
  slug             String  @unique
  systemIdentifier String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  assistantInstances     AssistantInstance[]
  assistantConversations AssistantConversation[]
  assistantRuns          AssistantRun[]
  assistantMessages      AssistantMessage[]
}

model AssistantConfig {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  organizationOid BigInt       @unique
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AssistantInstance {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  assistantOid BigInt
  assistant    Assistant @relation(fields: [assistantOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  // Only assistants owned by metorial have an actor
  organizationActorOid BigInt?
  organizationActor    OrganizationActor? @relation(fields: [organizationActorOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  assistantConversations AssistantConversation[]
  assistantRuns          AssistantRun[]
  assistantMessages      AssistantMessage[]

  @@unique([assistantOid, organizationOid])
}

model AssistantModel {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name String
  slug String

  contextWindow              Int
  inputCostPerMillionTokens  Float
  outputCostPerMillionTokens Float

  providerOid BigInt
  provider    AssistantModelProvider @relation(fields: [providerOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  messages AssistantMessage[]

  @@unique([slug, providerOid])
}

model AssistantModelProvider {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  slug     String @unique
  name     String
  imageUrl String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  models AssistantModel[]
}
