# syntax=docker/dockerfile:1.7
# Generated by `control docker generate` from the build spec in control/index.ts.
# Do not edit by hand: changes are overwritten on the next generation.

FROM oven/bun:1.4.2 AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 python3-setuptools make g++ && rm -rf /var/lib/apt/lists/*

FROM base AS pruner
COPY . .
RUN bun ./src/tooling/docker-build/prune.ts prisma:generate server:build --filter=@metorial/origin

FROM scratch AS pruned
COPY --from=pruner /app/out/ /

FROM base AS dependencies
COPY --from=pruned /json/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --linker=hoisted

FROM dependencies AS builder
ARG TURBO_API
ARG TURBO_TEAM
ENV TURBO_API=${TURBO_API}
ENV TURBO_TEAM=${TURBO_TEAM}
COPY --from=pruned /full/ ./
RUN --mount=type=secret,id=turbo_token,required=false --mount=type=secret,id=turbo_signature,required=false sh ./src/tooling/warp-cache/run-turbo.sh prisma:generate server:build --filter=@metorial/origin

FROM base AS control-runtime
WORKDIR /runtime
COPY src/control/runtime/package.json src/control/runtime/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile
COPY src/control/runtime/src ./src
RUN bun build ./src/cli.ts --target=bun --outfile=./control-runtime.js

FROM base AS prisma-cli
WORKDIR /opt/prisma
RUN --mount=type=cache,target=/root/.bun/install/cache bun add prisma@7.10.1 && ./node_modules/.bin/prisma --version

FROM oven/bun:1.4.2-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tini && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 metorial \
 && useradd --system --uid 10001 --gid metorial --create-home --shell /usr/sbin/nologin metorial
WORKDIR /app
ENV NODE_ENV=production
ENV TZ=UTC
COPY --from=builder --link --chown=metorial:metorial /app/src/origin/apps/service/dist ./dist
COPY --from=control-runtime --link --chown=metorial:metorial /runtime/control-runtime.js ./control/control-runtime.js
COPY --from=prisma-cli --link --chown=metorial:metorial /opt/prisma /opt/prisma
COPY --from=builder --link --chown=metorial:metorial /app/src/origin/apps/service/prisma/schema/ ./prisma/origin/schema/
COPY --link --chown=metorial:metorial <<'EOF' ./.control/runtime.json
{
  "databases": [
    {
      "name": "origin",
      "env": [
        "ORIGIN_DATABASE_URL",
        "DATABASE_URL"
      ],
      "parts": "DATABASE",
      "query": "schema=public&sslmode=no-verify&connection_limit=20",
      "precedence": "parts",
      "schema": "prisma/origin/schema"
    }
  ]
}
EOF
ENV PRISMA_BIN=/opt/prisma/node_modules/.bin/prisma
USER metorial
EXPOSE 52090 52093
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://127.0.0.1:52090/ping && curl -fsS http://127.0.0.1:12121/ || exit 1
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "bun ./control/control-runtime.js migrate origin && exec bun ./dist/index.js"]
