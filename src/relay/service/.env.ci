# CI environment
# Points to Docker container hostnames

DATABASE_URL=postgresql://relay:relay@postgres:5432/relay
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_URL=http://object-storage:52010
LOGS_BUCKET_NAME=relay-logs-test

OBJECT_STORAGE_BACKEND_TYPE=local
OBJECT_STORAGE_BACKEND_ROOT_PATH=/app/data
OBJECT_STORAGE_AWS_REGION=us-east-1
OBJECT_STORAGE_AWS_S3_BUCKET=relay-ci
OBJECT_STORAGE_AWS_ACCESS_KEY_ID=test
OBJECT_STORAGE_AWS_SECRET_ACCESS_KEY=test
