# Service configuration
DATABASE_URL=postgresql://nebula:nebula@postgres:5432/nebula
REDIS_URL=redis://redis:6379

# Provider defaults
DEFAULT_PROVIDER=local

# Local adapter
LOCAL_MASTER_SECRET=please-change-this-local-development-secret-with-32-bytes

# AWS KMS adapter
KMS_AWS_REGION=us-east-1
# KMS_AWS_ACCESS_KEY_ID=
# KMS_AWS_SECRET_ACCESS_KEY=
# KMS_DEFAULT_KEY_ID=
# KMS_CREATE_DEFAULT_KEY=false
# Customer BYOK principal (set by CDK, e.g. metorial-us1-secret-manager / metorial-us1-secret-manager-staging).
# Metorial-managed keys use the ECS task role; Nebula assumes this role for cross-account customer keys.
# KMS_EXTERNAL_KEY_ROLE_ARN=

# Consumer instance auth
CONSUMER_INSTANCE_TOKEN_SECRET=please-change-this-consumer-token-signing-secret
CONSUMER_INSTANCE_TOKEN_TTL_SECONDS=3600
CONSUMER_REGISTRATION_worker=please-change-this-worker-registration-secret

# Providers enabled for per-tenant keys (cloud only), e.g. aws_kms,gcp_kms,azure_key_vault
# TENANT_PROVIDER_TYPES=

# GCP Cloud KMS adapter (DEFAULT_PROVIDER=gcp.kms)
# GCP_KMS_DEFAULT_KEY=projects/<project>/locations/<location>/keyRings/<ring>/cryptoKeys/<key>
# GCP_KMS_CREDENTIALS_JSON=
# GCP_KMS_EXTERNAL_PRINCIPAL=

# Azure Key Vault adapter (DEFAULT_PROVIDER=azure.keyvault)
# AZURE_KMS_DEFAULT_VAULT_URL=https://<vault>.vault.azure.net
# AZURE_KMS_DEFAULT_KEY_NAME=
# AZURE_KMS_TENANT_ID=
# AZURE_KMS_CLIENT_ID=
# AZURE_KMS_CLIENT_SECRET=
# AZURE_KMS_CLIENT_CERTIFICATE_PEM=
# AZURE_KMS_CLIENT_CERTIFICATE_PATH=
