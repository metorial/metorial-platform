enum AgentTrackingViewStatus {
  active
  deleted
}

model AgentTrackingView {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status AgentTrackingViewStatus @default(active)

  page String
  kind String

  name    String
  nameKey String?

  /// [AgentTrackingViewParams]
  params Json

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  creatorActorOid BigInt?
  creatorActor    OrganizationActor? @relation(fields: [creatorActorOid], references: [oid], onDelete: SetNull)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([instanceOid, page, nameKey])
  @@index([instanceOid, page, status])
  @@index([creatorActorOid])
}
