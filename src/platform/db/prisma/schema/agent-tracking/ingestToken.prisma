enum AgentTrackingIngestTokenStatus {
  active
  revoked
}

enum AgentTrackingIngestTokenDeviceMode {
  bound
  ephemeral
}

model AgentTrackingIngestToken {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status     AgentTrackingIngestTokenStatus     @default(active)
  deviceMode AgentTrackingIngestTokenDeviceMode

  serviceIngestTokenId String @unique

  name String

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  consumerOid BigInt
  consumer    Consumer @relation(fields: [consumerOid], references: [oid], onDelete: Cascade)

  consumerDeviceOid BigInt?
  consumerDevice    ConsumerDevice? @relation(fields: [consumerDeviceOid], references: [oid], onDelete: SetNull)

  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([consumerDeviceOid, status])
  @@index([consumerOid, status])
  @@index([instanceOid])
}
