{
  "extends": "./tsconfig.loader.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "../../control/index.ts",
    "../../src/**/control/index.ts",
    "../../../control/index.ts",
    "../../../src/**/control/index.ts"
  ],
  "exclude": ["**/node_modules/**"]
}
