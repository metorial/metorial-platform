enum EventDeliveryRetryStrategy {
  exponential
  linear
  fixed
}

enum EventDeliveryIntentStatus {
  pending
  retrying
  delivered
  failed
  cancelled
}

model EventDeliveryIntent {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status EventDeliveryIntentStatus @default(pending)

  type EventDestinationType

  attemptCount Int @default(0)

  errorCode    String?
  errorMessage String?

  retryStrategy         EventDeliveryRetryStrategy
  retryMaxAttempts      Int
  retryBaseDelaySeconds Int
  retryMaxDelaySeconds  Int

  systemEventOid BigInt
  systemEvent    SystemEvent @relation(fields: [systemEventOid], references: [oid], onDelete: Cascade)

  eventDestinationOid BigInt
  eventDestination    EventDestination @relation(fields: [eventDestinationOid], references: [oid], onDelete: Cascade)

  eventDestinationListenerOid BigInt?
  eventDestinationListener    EventDestinationListener? @relation(fields: [eventDestinationListenerOid], references: [oid], onDelete: SetNull)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid], onDelete: SetNull)

  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  attempts EventDeliveryAttempt[]

  @@unique([systemEventOid, eventDestinationOid])
  @@index([organizationOid, createdAt])
  @@index([instanceOid, createdAt])
  @@index([eventDestinationOid, createdAt])
  @@index([status, nextAttemptAt])
}

enum EventDeliveryAttemptStatus {
  succeeded
  failed
}

model EventDeliveryAttempt {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status EventDeliveryAttemptStatus

  attemptNumber Int
  durationMs    Int

  isRetryable Boolean @default(false)

  errorCode    String?
  errorMessage String?

  responseStatusCode Int?

  intentOid BigInt
  intent    EventDeliveryIntent @relation(fields: [intentOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  /// [EventDeliveryAttemptDetails]
  detailsJson       Json?
  detailsStorageKey String?

  startedAt   DateTime
  completedAt DateTime
  createdAt   DateTime @default(now())

  @@index([intentOid, attemptNumber])
  @@index([organizationOid, createdAt])
  @@index([status, createdAt])
  @@index([detailsStorageKey])
}

enum EventDestinationType {
  webhook
}

enum EventDestinationStatus {
  active
  archived
}

model EventDestination {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name        String
  description String?

  status EventDestinationStatus @default(active)
  type   EventDestinationType

  retryStrategy         EventDeliveryRetryStrategy @default(exponential)
  retryMaxAttempts      Int                        @default(25)
  retryBaseDelaySeconds Int                        @default(10)
  retryMaxDelaySeconds  Int                        @default(10800)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  webhookDestinationOid BigInt?             @unique
  webhookDestination    WebhookDestination? @relation(fields: [webhookDestinationOid], references: [oid], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?

  listeners       EventDestinationListener[]
  deliveryIntents EventDeliveryIntent[]

  @@index([organizationOid, status])
}

enum EventDestinationListenerType {
  event
  callback
  chat
}

model EventDestinationListener {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type EventDestinationListenerType

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  // populated when type = event and type = chat
  eventTypes String[]

  // populated when type = callback
  callbackId String?
  triggers   String[]

  // populated when type = chat
  chatConnectionId String?

  // populated when type = callback or chat, no callback or chat identifier, then optionally
  // the user can choose to match all chat or callback instances for the given provider
  providerId String?

  eventDestinationOid BigInt
  eventDestination    EventDestination @relation(fields: [eventDestinationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deliveryIntents EventDeliveryIntent[]

  @@index([eventDestinationOid])
  @@index([instanceOid])
  @@index([instanceOid, type])
  @@index([type, callbackId])
  @@index([type, chatConnectionId])
  @@index([type, providerId])
  @@index([eventTypes], type: Gin)
  @@index([triggers], type: Gin)
}

enum SystemEventSource {
  resource
  callback
  chat
  ping
}

model SystemEvent {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  source SystemEventSource

  // source = resource -> "<resource>.<action>"
  // source = callback -> "callback.<triggerKey>"
  // source = chat -> "chat.<event>"
  // source = ping -> "ping"
  eventType String

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid], onDelete: SetNull)

  /// [SystemEventPayload]
  payloadJson       Json?
  payloadStorageKey String?

  callbackEventId    String? @unique
  callbackId         String?
  callbackTriggerKey String?

  chatEventId      String? @unique
  chatConnectionId String?
  providerId       String? // Denormalized for event delivery matching

  createdAt DateTime @default(now())

  deliveryIntents EventDeliveryIntent[]

  @@index([organizationOid, createdAt])
  @@index([instanceOid, createdAt])
  @@index([createdAt, id])
  @@index([eventType])
  @@index([callbackId, callbackTriggerKey])
  @@index([chatConnectionId, eventType])
  @@index([providerId, eventType])
  @@index([payloadStorageKey])
}

enum WebhookMethod {
  POST
}

model WebhookDestination {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  url    String
  method WebhookMethod @default(POST)

  signingSecret String

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  eventDestination EventDestination?
}
