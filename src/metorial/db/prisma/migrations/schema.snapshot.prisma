  skillDestinationDeletedFiles SkillDestinationDeletedFile[]
  manifests                    SkillDestinationManifest[]    @relation("SkillDestinationManifests")

  @@index([syncRecoveryVersion])
  @@index([isDirty])
  @@index([shouldFlushAt])
  @@index([mustFlushAt])
}

