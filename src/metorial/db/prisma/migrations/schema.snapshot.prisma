enum OAuthApplicationStatus {
  active
  archived
}

enum OAuthApplicationType {
  user_facing
  cli_auth
  server_side
  internal
}

enum OAuthAuthorizationAccessLevel {
  organization
  global
}

enum OAuthApplicationSubjectType {
  organization_member
  consumer
  consumer_or_organization_member
}

model OAuthApplication {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status      OAuthApplicationStatus
