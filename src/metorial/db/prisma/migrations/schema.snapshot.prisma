  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  createdByResourceActorOid BigInt?
  createdByResourceActor    ResourceActor? @relation("FileUploadCreator", fields: [createdByResourceActorOid], references: [oid], onDelete: SetNull)

  attachStoreId String?
  attachPath    String?
  attachReplace Boolean @default(false)

  fileOid BigInt? @unique
  file    File?   @relation(fields: [fileOid], references: [oid], onDelete: SetNull)

