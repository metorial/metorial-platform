datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "../generated"
  previewFeatures = ["relationJoins"]
}

generator json {
  provider = "prisma-json-types-generator"
}

model AccessTag {
  oid BigInt @id @default(autoincrement())

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  accessTagEntities AccessTagEntity[]
  fineGrainedKeys   FineGrainedKey[]
  consumerProfile   ConsumerProfile?
  consumerGroup     ConsumerGroup?
}

model AccessTagPolicy {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name             String
  roles            String[]
  systemIdentifier String?

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  accessTagEntities AccessTagEntity[]

  createdAt DateTime @default(now())

  @@unique([organizationOid, systemIdentifier])
}

model AccessTagEntity {
  oid BigInt @id @default(autoincrement())

  subspaceSessionId String?

  accessTagOid BigInt
  accessTag    AccessTag @relation(fields: [accessTagOid], references: [oid], onDelete: Cascade)

  accessTagPolicyOid BigInt
  accessTagPolicy    AccessTagPolicy @relation(fields: [accessTagPolicyOid], references: [oid], onDelete: Cascade)

  magicMcpTokenOid BigInt?
  magicMcpToken    MagicMcpToken? @relation(fields: [magicMcpTokenOid], references: [oid], onDelete: Cascade)

  magicMcpServerOid BigInt?
  magicMcpServer    MagicMcpServer? @relation(fields: [magicMcpServerOid], references: [oid], onDelete: Cascade)

  magicMcpEndpointOid BigInt?
  magicMcpEndpoint    MagicMcpEndpoint? @relation(fields: [magicMcpEndpointOid], references: [oid], onDelete: Cascade)

  // magicMcpGroupOid BigInt?
  // magicMcpGroup    MagicMcpGroup? @relation(fields: [magicMcpGroupOid], references: [oid], onDelete: Cascade)

  providerTemplateOid BigInt?
  providerTemplate    ProviderTemplate? @relation(fields: [providerTemplateOid], references: [oid], onDelete: Cascade)

  skillOid BigInt?
  skill    Skill?  @relation(fields: [skillOid], references: [oid], onDelete: Cascade)

  skillTemplateOid BigInt?
  skillTemplate    SkillTemplate? @relation(fields: [skillTemplateOid], references: [oid], onDelete: Cascade)

  skillGroupOid BigInt?
  skillGroup    SkillGroup? @relation(fields: [skillGroupOid], references: [oid], onDelete: Cascade)

  skillMarketplaceOid BigInt?
  skillMarketplace    SkillMarketplace? @relation(fields: [skillMarketplaceOid], references: [oid], onDelete: Cascade)

  skillPluginOid BigInt?
  skillPlugin    SkillPlugin? @relation(fields: [skillPluginOid], references: [oid], onDelete: Cascade)

  storeOid BigInt?
  store    Store?  @relation(fields: [storeOid], references: [oid], onDelete: Cascade)

  // serverOAuthSession    ServerOAuthSession? @relation(fields: [serverOAuthSessionOid], references: [oid])
  // serverOAuthSessionOid BigInt?

  @@unique([accessTagOid, accessTagPolicyOid, skillOid])
  @@unique([accessTagOid, accessTagPolicyOid, skillTemplateOid])
  @@unique([accessTagOid, accessTagPolicyOid, skillGroupOid])
  @@unique([accessTagOid, accessTagPolicyOid, skillMarketplaceOid])
  @@unique([accessTagOid, accessTagPolicyOid, skillPluginOid])
  @@unique([accessTagOid, accessTagPolicyOid, storeOid])
  @@index([storeOid])
  @@index([skillMarketplaceOid])
  @@index([skillPluginOid])
  @@index([magicMcpTokenOid])
  @@index([magicMcpServerOid])
  @@index([magicMcpEndpointOid])
}

enum FineGrainedKeyStatus {
  active
  deleted
  expired
}

model FineGrainedKey {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status FineGrainedKeyStatus

  secret         String @unique
  secretRedacted String
  secretLength   Int

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  accessTagOid BigInt
  accessTag    AccessTag @relation(fields: [accessTagOid], references: [oid], onDelete: Cascade)

  deletedAt  DateTime?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  sessionClientSecretReferences SessionClientSecretReference[]

  @@index([instanceOid])
  @@index([accessTagOid])
  @@index([expiresAt])
  @@index([status])
}

model SessionClientSecretReference {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  sessionId String @unique

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  fineGrainedKeyOid BigInt
  fineGrainedKey    FineGrainedKey @relation(fields: [fineGrainedKeyOid], references: [oid], onDelete: Cascade)
}

model Account {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  organizationOid BigInt?       @map("ownerOrganizationOid")
  organization    Organization? @relation("AccountOwnerOrganization", fields: [organizationOid], references: [oid], onDelete: Cascade)

  rootOwnerAccountOid BigInt?
  rootOwnerAccount    Account?  @relation("AccountRootOwnerAccount", fields: [rootOwnerAccountOid], references: [oid], onDelete: Cascade)
  allChildAccounts    Account[] @relation("AccountRootOwnerAccount")

  ownerAccountOid     BigInt?
  ownerAccount        Account?  @relation("AccountOwnerAccount", fields: [ownerAccountOid], references: [oid], onDelete: Cascade)
  directChildAccounts Account[] @relation("AccountOwnerAccount")

  cellOid Int?
  cell    Cell? @relation(fields: [cellOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  workspaces           Workspace[]
  namespaces           Namespace[]
  workspaceProfiles    WorkspaceProfile[]
  workspaceInvites     WorkspaceInvite[]
  workspaceGroups      WorkspaceGroup[]
  workspacePolicies    WorkspacePolicy[]
  accountDomains       AccountDomain[]
  namespaceProperties  NamespaceProperty[]
  outposts             Outpost[]
  outpostTokenKeyPairs OutpostTokenKeyPair[]
}

enum AccountDomainStatus {
  active
  inactive
}

enum AccountDomainVerificationStatus {
  unverified
  verified_basic
  verified_full
}

model AccountDomain {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  domain String @unique

  status             AccountDomainStatus
  verificationStatus AccountDomainVerificationStatus

  accountOid BigInt
  account    Account @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  verifications AccountDomainVerification[]
  statusChanges AccountDomainVerificationStatusChange[]

  @@index([accountOid, status, id])
  @@index([status, domain])
}

enum AccountDomainVerificationType {
  dns
  email
}

enum AccountDomainVerificationInnerStatus {
  unverified
  verified
}

model AccountDomainVerification {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type   AccountDomainVerificationType
  status AccountDomainVerificationInnerStatus

  verificationCode String

  accountDomainOid BigInt
  accountDomain    AccountDomain @relation(fields: [accountDomainOid], references: [oid], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  lastCheckedAt DateTime?

  statusChanges AccountDomainVerificationStatusChange[]

  @@unique([accountDomainOid, type])
  @@index([accountDomainOid, type, status])
}

model AccountDomainVerificationStatusChange {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  accountDomainVerificationOid BigInt
  accountDomainVerification    AccountDomainVerification @relation(fields: [accountDomainVerificationOid], references: [oid], onDelete: Cascade)

  accountDomainOid BigInt
  accountDomain    AccountDomain @relation(fields: [accountDomainOid], references: [oid], onDelete: Cascade)

  oldStatus AccountDomainVerificationInnerStatus
  newStatus AccountDomainVerificationInnerStatus

  createdAt DateTime @default(now())

  @@index([accountDomainVerificationOid, createdAt(sort: Desc)])
  @@index([accountDomainOid, createdAt(sort: Desc)])
}

model GlobalProfile {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  workspaceProfiles WorkspaceProfile[]
  emails            GlobalProfileEmail[]
  workspaceInvites  WorkspaceInvite[]
  users             User[]
  consumers         Consumer[]
}

model GlobalProfileEmail {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  email String @unique

  globalProfileOid BigInt
  globalProfile    GlobalProfile @relation(fields: [globalProfileOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum NamespaceCompartmentType {
  managed
}

model NamespaceCompartment {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type NamespaceCompartmentType @default(managed)

  priority Int

  systemIdentifier String? @unique
  value            String  @unique

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
  namespaces Namespace[]
}

enum NamespacePurpose {
  metorial_platform
  metorial_portal
  metorial_portal_single
  metorial_public_mcp
}

model Namespace {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  value    String
  purposes NamespacePurpose[]

  compartmentOid BigInt
  compartment    NamespaceCompartment @relation(fields: [compartmentOid], references: [oid])

  accountOid BigInt
  account    Account @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  namespaceProperties NamespaceProperty[]
  portalsSpecificTo   Portal[]            @relation("PortalSpecificNamespace")

  @@unique([value, compartmentOid])
}

enum NamespacePropertyType {
  portal
  organization
}

model NamespaceProperty {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type NamespacePropertyType

  namespaceOid BigInt
  namespace    Namespace @relation(fields: [namespaceOid], references: [oid], onDelete: Cascade)

  workspaceOid BigInt?
  workspace    Workspace? @relation(fields: [workspaceOid], references: [oid], onDelete: Cascade)

  accountOid BigInt
  account    Account @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt?
  organization    Organization? @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  portalOid BigInt?
  portal    Portal? @relation(fields: [portalOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([namespaceOid, workspaceOid])
  @@unique([namespaceOid, organizationOid])
  @@unique([namespaceOid, portalOid])
}

enum WorkspaceType {
  organization
  portal
  enterprise
}

enum WorkspaceStatus {
  active
  archived
  deleted
}

model Workspace {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type   WorkspaceType
  status WorkspaceStatus @default(active)

  name String

  accountOid BigInt
  account    Account @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt?       @unique
  organization    Organization? @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  portalOid BigInt? @unique
  portal    Portal? @relation(fields: [portalOid], references: [oid], onDelete: Cascade)

  enterpriseId String? @unique

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  profiles            WorkspaceProfile[]
  invites             WorkspaceInvite[]
  workspaceGroups     WorkspaceGroup[]
  workspacePolicies   WorkspacePolicy[]
  namespaceProperties NamespaceProperty[]
}

enum WorkspaceProfileStatus {
  active
  deleted
}

model WorkspaceProfile {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status WorkspaceProfileStatus @default(active)

  name  String
  email String

  accountOid BigInt
  account    Account @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  workspaceOid BigInt
  workspace    Workspace @relation(fields: [workspaceOid], references: [oid], onDelete: Cascade)

  globalProfileOid BigInt
  globalProfile    GlobalProfile @relation(fields: [globalProfileOid], references: [oid], onDelete: Cascade)

  userOid BigInt?
  user    User?   @relation(fields: [userOid], references: [oid], onDelete: Cascade)

  organizationMemberOid BigInt?             @unique
  organizationMember    OrganizationMember? @relation(fields: [organizationMemberOid], references: [oid], onDelete: Cascade)

  enterpriseMemberId String? @unique

  consumerOid BigInt?
  consumer    Consumer? @relation(fields: [consumerOid], references: [oid], onDelete: Cascade)

  instanceConsumerOid BigInt?
  instanceConsumer    InstanceConsumer? @relation(fields: [instanceConsumerOid], references: [oid], onDelete: Cascade)

  consumerProfileOid BigInt?          @unique
  consumerProfile    ConsumerProfile? @relation(fields: [consumerProfileOid], references: [oid], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  policies WorkspacePolicyAssignment[]
  groups   WorkspaceGroupAssignment[]

  @@unique([workspaceOid, globalProfileOid])
}

enum WorkspaceInviteStatus {
  pending
  accepted
  rejected
  deleted
}

model WorkspaceInvite {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status WorkspaceInviteStatus @default(pending)

  email String

  accountOid BigInt
  account    Account @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  workspaceOid BigInt
  workspace    Workspace @relation(fields: [workspaceOid], references: [oid], onDelete: Cascade)

  globalProfileOid BigInt
  globalProfile    GlobalProfile @relation(fields: [globalProfileOid], references: [oid], onDelete: Cascade)

  consumerInviteOid BigInt?         @unique
  consumerInvite    ConsumerInvite? @relation(fields: [consumerInviteOid], references: [oid], onDelete: Cascade)

  organizationInviteOid BigInt?             @unique
  organizationInvite    OrganizationInvite? @relation(fields: [organizationInviteOid], references: [oid], onDelete: Cascade)

  enterpriseInviteId String? @unique

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  expiresAt DateTime

  @@unique([workspaceOid, globalProfileOid])
}

enum WorkspaceGroupType {
  consumer_group
  organization_team
}

enum WorkspaceGroupStatus {
  active
  archived
  deleted
}

enum WorkspaceGroupAssignmentType {
  everyone
  admin
  custom
}

model WorkspaceGroup {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type           WorkspaceGroupType
  status         WorkspaceGroupStatus
  assignmentType WorkspaceGroupAssignmentType

  name        String
  description String?

  workspaceOid BigInt
  workspace    Workspace @relation(fields: [workspaceOid], references: [oid], onDelete: Cascade)

  accountOid BigInt
  account    Account @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  policies                  WorkspacePolicyAssignment[]
  workspaceGroupAssignments WorkspaceGroupAssignment[]
}

enum WorkspacePolicyType {
  organization_policy
  enterprise_role
}

enum WorkspacePolicyStatus {
  active
  archived
  deleted
}

enum WorkspacePolicyAssignmentType {
  everyone
  admin
  custom
}

model WorkspacePolicy {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type           WorkspacePolicyType
  status         WorkspacePolicyStatus
  assignmentType WorkspacePolicyAssignmentType

  name        String
  description String?

  workspaceOid BigInt
  workspace    Workspace @relation(fields: [workspaceOid], references: [oid], onDelete: Cascade)

  accountOid BigInt
  account    Account @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  assignments WorkspacePolicyAssignment[]
}

model WorkspacePolicyAssignment {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  workspacePolicyOid BigInt
  workspacePolicy    WorkspacePolicy @relation(fields: [workspacePolicyOid], references: [oid], onDelete: Cascade)

  workspaceGroupOid BigInt?
  workspaceGroup    WorkspaceGroup? @relation(fields: [workspaceGroupOid], references: [oid], onDelete: Cascade)

  workspaceProfileOid BigInt?
  workspaceProfile    WorkspaceProfile? @relation(fields: [workspaceProfileOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspacePolicyOid, workspaceGroupOid])
  @@unique([workspacePolicyOid, workspaceProfileOid])
}

model WorkspaceGroupAssignment {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  workspaceGroupOid BigInt
  workspaceGroup    WorkspaceGroup @relation(fields: [workspaceGroupOid], references: [oid], onDelete: Cascade)

  workspaceProfileOid BigInt
  workspaceProfile    WorkspaceProfile @relation(fields: [workspaceProfileOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceGroupOid, workspaceProfileOid])
}

model AuditLog {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  resource String
  action   String

  ua String?
  ip String?

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid], onDelete: SetNull)

  organizationActorOid BigInt?
  organizationActor    OrganizationActor? @relation(fields: [organizationActorOid], references: [oid], onDelete: SetNull)

  actorType     String?
  actorId       String?
  actorMetadata Json?

  eventOid BigInt?
  event    AuditLogEvent? @relation(fields: [eventOid], references: [oid], onDelete: SetNull)

  /// [AuditPayload]
  payload            Json?
  /// [AuditPayload]
  previousAttributes Json?

  recordedAt DateTime @default(now())

  @@index([actorType, actorId, recordedAt])
  @@index([resource, action, recordedAt])
  @@index([eventOid])
  @@index([organizationOid, recordedAt])
  @@index([organizationOid, oid])
  @@index([instanceOid, recordedAt])
  @@index([organizationActorOid, recordedAt])
}

model AuditLogDirtyTracker {
  organizationOid BigInt       @id
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AuditLogEvent {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  resource String
  action   String

  ua String?
  ip String?

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid], onDelete: SetNull)

  organizationActorOid BigInt?
  organizationActor    OrganizationActor? @relation(fields: [organizationActorOid], references: [oid], onDelete: SetNull)

  actorType     String?
  actorId       String?
  actorMetadata Json?

  recordedAt DateTime @default(now())

  auditLogs AuditLog[]

  @@index([actorType, actorId, recordedAt])
  @@index([resource, action, recordedAt])
  @@index([organizationOid, recordedAt])
  @@index([instanceOid, recordedAt])
  @@index([organizationActorOid, recordedAt])
  @@map("Event")
}

enum AuditLogStreamStatus {
  active
  inactive
}

enum AuditLogStreamProvider {
  datadog
  splunk
}

enum AuditLogStreamAccessStatus {
  ok
  error
}

model AuditLogStream {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  provider     AuditLogStreamProvider
  status       AuditLogStreamStatus
  accessStatus AuditLogStreamAccessStatus

  isPausedDueToError    Boolean @default(false)
  errorMessage          String?
  consecutiveErrorCount Int     @default(0)
  isStarted             Boolean @default(false)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  providerDataRedacted  Json
  encryptedProviderData String
  lastEventId           String?
  lastAuditLogOid       BigInt?

  events AuditLogStreamEvent[]
  runs   AuditLogStreamRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum AuditLogStreamEventType {
  created
  started
  error
  error_paused
  recovered
  disabled
  enabled
}

model AuditLogStreamEvent {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type         AuditLogStreamEventType
  message      String?
  errorDetails Json?

  auditLogStreamOid BigInt
  auditLogStream    AuditLogStream @relation(fields: [auditLogStreamOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum AuditLogStreamRunStatus {
  running
  success
  error
}

model AuditLogStreamRun {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status               AuditLogStreamRunStatus
  batchIdentifier      String
  batchNumber          Int
  successfulBatchCount Int
  recordsSynced        Int
  errorMessage         String?

  auditLogStreamOid BigInt
  auditLogStream    AuditLogStream @relation(fields: [auditLogStreamOid], references: [oid], onDelete: Cascade)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([auditLogStreamOid, createdAt])
  @@index([status, createdAt])
  @@index([batchIdentifier])
}

model Cell {
  oid Int @id @default(autoincrement())

  identifier String @unique

  isCurrentDeployment Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  accounts Account[]
}

model CellConsumerSurface {
  id String @id

  status ConsumerSurfaceStatus
  type   ConsumerSurfaceType

  name        String
  description String?

  isOwnedByDeployment Boolean

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?
}

model CellInstance {
  id String @id

  type   InstanceType
  status InstanceStatus

  slug String
  name String

  isOwnedByDeployment Boolean

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model CellOrganization {
  id String @id

  type   OrganizationType
  status OrganizationStatus

  slug String @unique
  name String

  isOwnedByDeployment Boolean

  /// [EntityImage]
  image Json

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model CellPortal {
  id String @id

  status PortalStatus

  name        String
  description String?
  slug        String  @unique

  isOwnedByDeployment Boolean

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?
}

model CellSkillPlugin {
  id String @id

  status SkillPluginStatus

  name String?
  slug String?

  isOwnedByDeployment Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([slug])
}

enum MetorialConfigSessionRunner {
  legacy
  engine
}

enum MetorialConfigId {
  metorial
}

model MetorialConfig {
  id MetorialConfigId @id @default(metorial)

  sessionRunner      MetorialConfigSessionRunner @default(engine)
  instanceIdentifier String                      @default(uuid())

  createdAt DateTime @default(now())
}

enum ConsumerAccessTargetType {
  provider_template
  magic_mcp_server
  skill
  skill_template
  skill_group
  skill_marketplace
  skill_plugin
}

enum ConsumerAccessLevel {
  read
  write
  manage
}

model ConsumerAccess {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type        ConsumerAccessTargetType
  accessLevel ConsumerAccessLevel?

  surfaceOid BigInt
  surface    ConsumerSurface @relation(fields: [surfaceOid], references: [oid], onDelete: Cascade)

  consumerGroupOid BigInt
  consumerGroup    ConsumerGroup @relation(fields: [consumerGroupOid], references: [oid], onDelete: Cascade)

  providerTemplateOid BigInt?
  providerTemplate    ProviderTemplate? @relation("ConsumerAccessProviderTemplate", fields: [providerTemplateOid], references: [oid], onDelete: Cascade)

  magicMcpServerOid BigInt?
  magicMcpServer    MagicMcpServer? @relation("ConsumerAccessMagicMcpServer", fields: [magicMcpServerOid], references: [oid], onDelete: Cascade)

  skillOid BigInt?
  skill    Skill?  @relation("ConsumerAccessSkill", fields: [skillOid], references: [oid], onDelete: Cascade)

  skillTemplateOid BigInt?
  skillTemplate    SkillTemplate? @relation("ConsumerAccessSkillTemplate", fields: [skillTemplateOid], references: [oid], onDelete: Cascade)

  skillGroupOid BigInt?
  skillGroup    SkillGroup? @relation("ConsumerAccessSkillGroup", fields: [skillGroupOid], references: [oid], onDelete: Cascade)

  skillMarketplaceOid BigInt?
  skillMarketplace    SkillMarketplace? @relation("ConsumerAccessSkillMarketplace", fields: [skillMarketplaceOid], references: [oid], onDelete: Cascade)

  skillPluginOid BigInt?
