  mergedTargetSkillVersion    SkillVersion? @relation("SkillMergeRequestMergedTargetVersion", fields: [mergedTargetSkillVersionOid], references: [oid], onDelete: SetNull)

  rollbackTargetSkillVersionOid BigInt?
  rollbackTargetSkillVersion    SkillVersion? @relation("SkillMergeRequestRollbackTargetVersion", fields: [rollbackTargetSkillVersionOid], references: [oid], onDelete: SetNull)

  createdByResourceActorOid BigInt?
  createdByResourceActor    ResourceActor? @relation("SkillMergeRequestCreator", fields: [createdByResourceActorOid], references: [oid], onDelete: SetNull)

  mergeStartedByResourceActorOid BigInt?
  mergeStartedByResourceActor    ResourceActor? @relation("SkillMergeRequestMergeStarter", fields: [mergeStartedByResourceActorOid], references: [oid], onDelete: SetNull)

  mergedByResourceActorOid BigInt?
  mergedByResourceActor    ResourceActor? @relation("SkillMergeRequestMerger", fields: [mergedByResourceActorOid], references: [oid], onDelete: SetNull)

  closedByResourceActorOid BigInt?
  closedByResourceActor    ResourceActor? @relation("SkillMergeRequestCloser", fields: [closedByResourceActorOid], references: [oid], onDelete: SetNull)

  rolledBackByResourceActorOid BigInt?
  rolledBackByResourceActor    ResourceActor? @relation("SkillMergeRequestRollbacker", fields: [rolledBackByResourceActorOid], references: [oid], onDelete: SetNull)

  mergeStartedAt DateTime?
  mergedAt       DateTime?
  closedAt       DateTime?
  rolledBackAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  items             SkillMergeRequestItem[]
  comments          SkillMergeRequestComment[]
  events            SkillMergeRequestEvent[]
  generatedForkSync SkillForkSync?             @relation("SkillForkSyncMergeRequest")

  @@index([resourceTenantOid, resourceGroupOid, status, createdAt])
  @@index([instanceOid, status, createdAt])
  @@index([sourceSkillOid, status, createdAt])
  @@index([targetSkillOid, status, createdAt])
  @@index([baseSourceSkillVersionOid])
  @@index([createdByResourceActorOid, createdAt])
  @@index([status, mergeStartedAt])
