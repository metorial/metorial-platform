  updatedAt DateTime @default(now()) @updatedAt

  @@unique([destinationOid, path])
  @@index([destinationOid])
  @@index([destinationOid, itemKey])
  @@index([destinationOid, pathBytes])
  @@index([sourceKey])
}

model SkillDestinationManifest {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  sha256        String
  objectKey     String
  formatVersion Int

  entryCount Int
  totalBytes BigInt

  destinationOid BigInt
  destination    SkillDestination @relation("SkillDestinationManifests", fields: [destinationOid], references: [oid], onDelete: Cascade)

