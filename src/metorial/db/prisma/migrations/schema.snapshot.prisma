  skillMarketplace    SkillMarketplace? @relation(fields: [skillMarketplaceOid], references: [oid], onDelete: Cascade)

  skillPluginOid BigInt?
  skillPlugin    SkillPlugin? @relation(fields: [skillPluginOid], references: [oid], onDelete: Cascade)

  skillOid BigInt?
  skill    Skill?  @relation(fields: [skillOid], references: [oid], onDelete: Cascade)

  hash String
}

enum SkillDestinationSyncStatus {
  pending
  completed
  failed
  processing
  waiting_for_review
  canceled
}

enum SkillDestinationSyncRepositoryPropagationStatus {
  pending
  processing
  waiting_for_review
  completed
  failed
  canceled
}

enum SkillDestinationSyncTrigger {
  automatic
  manual
  repair
  drift_check
  recovery
  migration
}

model SkillDestinationSync {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status            SkillDestinationSyncStatus
  trigger           SkillDestinationSyncTrigger @default(automatic)
  isAtRepoSyncStage Boolean                     @default(false)

  contentVersion Int @default(0)

  storageMode     SkillDestinationStorageMode @default(code_bucket)
  allowMassDelete Boolean                     @default(false)

  destinationOid BigInt
  destination    SkillDestination @relation(fields: [destinationOid], references: [oid], onDelete: Cascade)

  manifestOid BigInt?
  manifest    SkillDestinationManifest? @relation(fields: [manifestOid], references: [oid], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  prName        String?
  prDescription String?
  commitMessage String?

  /// [SyncLogEntry]
  logs Json[] @default([])

  repositoryPropagations SkillDestinationSyncRepositoryPropagation[]

  @@index([destinationOid, status])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([createdAt])
}

model SkillDestinationSyncRepositoryPropagation {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status                SkillDestinationSyncRepositoryPropagationStatus
  originSyncId          String?
  repositoryAccessMode  SkillMarketplaceRepositoryAccessMode            @default(pull_request)
  forceMergeOrPush      Boolean                                         @default(false)
  mergeBeforeChecksPass Boolean                                         @default(false)

  branchName    String
  prName        String
  prDescription String?
  commitMessage String?
  errorMessage  String?
  errorCode     String?
  endReason     String?

  /// [SkillSyncPropagationErrorDetails]
  errorDetails Json?

  waitingUntil  DateTime?
  waitingReason String?

  deletionsUpTo DateTime?

  previousManifestSha256 String?

  /// [SkillSyncResultStats]
  resultStats Json?

  manifestOid BigInt?
  manifest    SkillDestinationManifest? @relation("PropagationManifest", fields: [manifestOid], references: [oid], onDelete: SetNull)

  skillDestinationSyncOid BigInt
  skillDestinationSync    SkillDestinationSync @relation(fields: [skillDestinationSyncOid], references: [oid], onDelete: Cascade)

  skillRepositoryOid BigInt
  skillRepository    SkillRepository @relation(fields: [skillRepositoryOid], references: [oid], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([skillDestinationSyncOid, skillRepositoryOid])
  @@index([status])
  @@index([originSyncId])
  @@index([skillRepositoryOid])
}

model SkillOriginChangeNotificationCursor {
  consumer String @id

  cursor String?

  leaseId    String?
  leaseUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([leaseUntil])
}

enum SkillParticipantRole {
  creator
  editor
  viewer
  user
  forker
}

/// No longer read or written. Skill participants are store participants of the skill's store.
model SkillParticipant {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  roles SkillParticipantRole[]

  skillOid BigInt
  skill    Skill  @relation(fields: [skillOid], references: [oid], onDelete: Cascade)

  resourceActorOid BigInt
  resourceActor    ResourceActor @relation(fields: [resourceActorOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([skillOid, resourceActorOid])
  @@index([resourceActorOid])
  @@ignore
}

enum SkillTemplateStatus {
  active
  archived
  deleted
}

enum SkillTemplateOwner {
  system
  tenant
}

model SkillTemplate {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status SkillTemplateStatus @default(active)
  owner  SkillTemplateOwner

  slug        String
  name        String
  description String?
  metadata    Json?

  storeId         String?
  storeTemplateId String

  systemIdentifier String? @unique

  storeTemplateOid BigInt?        @unique
  storeTemplate    StoreTemplate? @relation(fields: [storeTemplateOid], references: [oid], onDelete: Cascade)

  resourceTenantOid BigInt?
  resourceTenant    ResourceTenant? @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  resourceGroupOid BigInt?
  resourceGroup    ResourceGroup? @relation(fields: [resourceGroupOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt?
  organization    Organization? @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

