enum OrganizationNotificationSeverity {
  alert
  notification
}

model OrganizationNotificationType {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  identifier String @unique
  name       String

  sendEmail Boolean

  severity OrganizationNotificationSeverity

  createdAt DateTime @default(now())

  organizationNotifications OrganizationNotification[]
  settings                  OrganizationNotificationSetting[]
}

enum OrganizationNotificationStatus {
  active
  read
  archived
}

model OrganizationNotification {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status OrganizationNotificationStatus @default(active)

  kind String

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  typeOid BigInt
  type    OrganizationNotificationType @relation(fields: [typeOid], references: [oid])

  onlyForMemberIds   String[]                 @default([])
  notForMemberIds    String[]                 @default([])
  onlyForMemberRoles OrganizationMemberRole[] @default([])

  message String
  title   String

  /// [OrganizationNotificationPayload]
  payload Json

  /// [OrganizationNotificationActions]
  actions Json

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  validUntil DateTime?

  destinations OrganizationNotificationDestination[]

  @@index([organizationOid, createdAt])
  @@index([typeOid])
}

enum OrganizationNotificationDestinationStatus {
  active
  read
  archived
}

enum OrganizationNotificationEmailStatus {
  disabled
  pending
  batched
  sent
}

enum OrganizationNotificationEmailDigestStatus {
  pending
  sent
  skipped
}

model OrganizationNotificationDestination {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status OrganizationNotificationDestinationStatus @default(active)

  memberOid BigInt
  member    OrganizationMember @relation(fields: [memberOid], references: [oid])

  notificationOid BigInt
  notification    OrganizationNotification @relation(fields: [notificationOid], references: [oid])

  emailStatus    OrganizationNotificationEmailStatus @default(disabled)
  emailSendAfter DateTime?
  emailId        String?
  emailSentAt    DateTime?

  emailDigestOid BigInt?
  emailDigest    OrganizationNotificationEmailDigest? @relation(fields: [emailDigestOid], references: [oid], onDelete: SetNull)

  readAt     DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([memberOid, notificationOid])
  @@index([memberOid, status, createdAt])
  @@index([notificationOid])
  @@index([emailStatus, emailSendAfter])
  @@index([emailDigestOid])
}

model OrganizationNotificationSetting {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  userOid BigInt
  user    User   @relation(fields: [userOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  typeOid BigInt
  type    OrganizationNotificationType @relation(fields: [typeOid], references: [oid], onDelete: Cascade)

  emailEnabled Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userOid, organizationOid, typeOid])
  @@index([organizationOid, userOid])
  @@index([typeOid])
}

model OrganizationNotificationDigestSetting {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  userOid BigInt
  user    User   @relation(fields: [userOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  timeMinutes Int    @default(480)
  timezone    String @default("America/Los_Angeles")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userOid, organizationOid])
  @@index([organizationOid, userOid])
}

model OrganizationNotificationEmailDigest {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status OrganizationNotificationEmailDigestStatus @default(pending)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  memberOid BigInt
  member    OrganizationMember @relation(fields: [memberOid], references: [oid], onDelete: Cascade)

  scheduledFor DateTime
  emailId      String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  destinations OrganizationNotificationDestination[]

  @@index([status, scheduledFor])
  @@index([memberOid, createdAt])
}
