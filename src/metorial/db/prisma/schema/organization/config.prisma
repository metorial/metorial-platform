enum OrganizationConfigOwnership {
  user
  organization
  user_organization
}

model OrganizationConfigType {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  identifier String                      @unique
  name       String
  ownership  OrganizationConfigOwnership

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  configs OrganizationConfig[]
}

model OrganizationConfig {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  typeOid BigInt
  type    OrganizationConfigType @relation(fields: [typeOid], references: [oid], onDelete: Cascade)

  targetHash String

  userOid BigInt?
  user    User?   @relation(fields: [userOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt?
  organization    Organization? @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  /// [OrganizationConfigValue]
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([typeOid, targetHash])
  @@index([userOid])
  @@index([organizationOid])
}
