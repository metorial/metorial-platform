enum ServiceAccountStatus {
  active
  archived
}

model ServiceAccount {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status      ServiceAccountStatus
  subjectType OAuthSubjectType     @default(organization_member)

  name        String
  description String?

  scopes String[]

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  oauthApplicationOid BigInt           @unique
  oauthApplication    OAuthApplication @relation(fields: [oauthApplicationOid], references: [oid], onDelete: Cascade)

  portalOid BigInt?
  portal    Portal? @relation(fields: [portalOid], references: [oid], onDelete: Cascade)

  consumerProfileOid BigInt?          @unique
  consumerProfile    ConsumerProfile? @relation(fields: [consumerProfileOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  serviceAccountCredentials ServiceAccountCredential[]
  policies                  AccessPolicyAssignment[]
}

model ServiceAccountCredential {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  serviceAccountOid BigInt
  serviceAccount    ServiceAccount @relation(fields: [serviceAccountOid], references: [oid], onDelete: Cascade)

  oauthAuthorizationOid BigInt             @unique
  oauthAuthorization    OAuthAuthorization @relation(fields: [oauthAuthorizationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime  @default(now())
  deletedAt DateTime?
}
