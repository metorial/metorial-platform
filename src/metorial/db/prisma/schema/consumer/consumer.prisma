model Consumer {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name  String
  email String

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  organizationMemberOid BigInt?
  organizationMember    OrganizationMember? @relation(fields: [organizationMemberOid], references: [oid], onDelete: SetNull)

  organizationActorOid BigInt?
  organizationActor    OrganizationActor? @relation(fields: [organizationActorOid], references: [oid], onDelete: SetNull)

  globalProfileOid BigInt?
  globalProfile    GlobalProfile? @relation(fields: [globalProfileOid], references: [oid], onDelete: Cascade)

  userOid BigInt?
  user    User?   @relation(fields: [userOid], references: [oid], onDelete: SetNull)

  isOrganizationMember Boolean @default(false)
  isPortalConsumer     Boolean @default(false)
  isManuallyCreated    Boolean @default(false)
  isPending            Boolean @default(false)

  internalActorIdentifier String?
  cargoActorId            String?
  subspaceActorId         String?
  synthesisActorId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  profiles             ConsumerProfile[]
  instanceConsumers    InstanceConsumer[]
  consumerActors       ConsumerActor[]
  consumerTokens       ConsumerToken[]
  integrations         ConsumerIntegration[]
  integrationEndpoints ConsumerIntegrationEndpoint[]
  integrationSessions  ConsumerIntegrationSession[]
  invites              ConsumerInvite[]
  createdSkills        Skill[]
  consumerSkills       ConsumerSkill[]
  workspaceProfiles    WorkspaceProfile[]
  resourceActors       ResourceActor[]

  @@unique([email, organizationOid])
}

model InstanceConsumer {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name  String
  email String

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  consumerOid BigInt
  consumer    Consumer @relation(fields: [consumerOid], references: [oid], onDelete: Cascade)

  organizationMemberOid BigInt?
  organizationMember    OrganizationMember? @relation(fields: [organizationMemberOid], references: [oid], onDelete: SetNull)

  organizationActorOid BigInt?
  organizationActor    OrganizationActor? @relation(fields: [organizationActorOid], references: [oid], onDelete: SetNull)

  isPending Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  consumerActors    ConsumerActor[]
  workspaceProfiles WorkspaceProfile[]

  @@unique([instanceOid, consumerOid])
}

enum ConsumerProfileInviteStatus {
  unset
  invited
  accepted
}

enum ConsumerProfileStatus {
  active
  deleted
}

model ConsumerProfile {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status ConsumerProfileStatus @default(active)

  aresUserId   String?
  ssoGroupIds  String[]                    @default([])
  ssoRoles     String[]                    @default([])
  inviteStatus ConsumerProfileInviteStatus @default(unset)

  name  String
  email String

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  surfaceOid BigInt
  surface    ConsumerSurface @relation(fields: [surfaceOid], references: [oid], onDelete: Cascade)

  consumerOid BigInt
  consumer    Consumer @relation(fields: [consumerOid], references: [oid], onDelete: Cascade)

  accessTagOid BigInt    @unique
  accessTag    AccessTag @relation(fields: [accessTagOid], references: [oid], onDelete: Cascade)

  organizationMemberOid BigInt?
  organizationMember    OrganizationMember? @relation(fields: [organizationMemberOid], references: [oid], onDelete: SetNull)

  organizationActorOid BigInt?
  organizationActor    OrganizationActor? @relation(fields: [organizationActorOid], references: [oid], onDelete: SetNull)

  personalConsumerGroupOid BigInt        @unique
  personalConsumerGroup    ConsumerGroup @relation("ConsumerProfilePersonalGroup", fields: [personalConsumerGroupOid], references: [oid], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  consumerSessions               ConsumerSession[]
  groups                         ConsumerProfileGroup[]
  accessRequests                 ConsumerAccessRequest[]
  providerSetupSessionBindings   ConsumerProviderSetupSessionBinding[]
  magicMcpEndpoints              MagicMcpEndpoint[]
  actors                         ConsumerActor[]
  consumerTokens                 ConsumerToken[]
  integrations                   ConsumerIntegration[]
  integrationEndpoints           ConsumerIntegrationEndpoint[]
  integrationSessions            ConsumerIntegrationSession[]
  consumerAuthAttempts           ConsumerAuthAttempt[]
  consumerAuthTestAuthorizations ConsumerAuthTestAuthorization[]
  invite                         ConsumerInvite?
  createdSkills                  Skill[]
  consumerSkills                 ConsumerSkill[]
  resourceActors                 ResourceActor[]
  workspaceProfile               WorkspaceProfile?

  @@unique([surfaceOid, aresUserId])
  @@unique([email, surfaceOid])
}

enum ConsumerInviteStatus {
  pending
  accepted
}

model ConsumerInvite {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status  ConsumerInviteStatus @default(pending)
  message String?

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  surfaceOid BigInt
  surface    ConsumerSurface @relation(fields: [surfaceOid], references: [oid], onDelete: Cascade)

  consumerOid BigInt
  consumer    Consumer @relation(fields: [consumerOid], references: [oid], onDelete: Cascade)

  consumerProfileOid BigInt          @unique
  consumerProfile    ConsumerProfile @relation(fields: [consumerProfileOid], references: [oid], onDelete: Cascade)

  invitedByOid BigInt
  invitedBy    OrganizationActor @relation(fields: [invitedByOid], references: [oid], onDelete: Cascade)

  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  expiresAt  DateTime  @default(now())

  workspaceInvite WorkspaceInvite?

  @@unique([surfaceOid, consumerOid])
}

enum ConsumerProfileGroupAssignedVia {
  manual
  sso
}

model ConsumerProfileGroup {
  oid BigInt @id @default(autoincrement())

  profileOid BigInt
  profile    ConsumerProfile @relation(fields: [profileOid], references: [oid], onDelete: Cascade)

  groupOid BigInt
  group    ConsumerGroup @relation(fields: [groupOid], references: [oid], onDelete: Cascade)

  assignedVia ConsumerProfileGroupAssignedVia @default(manual)

  createdAt DateTime @default(now())

  @@unique([profileOid, groupOid])
}
