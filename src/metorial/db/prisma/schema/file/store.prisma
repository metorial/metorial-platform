enum StoreStatus {
  active
  archived
}

enum StoreAccess {
  private
  public_read
  public_write
}

enum StoreCloneType {
  sync_until_change
  duplicate
}

enum StoreTemplateItemEncoding {
  utf_8  @map("utf-8")
  base64
}

enum StoreTemplateType {
  linked_store
  standalone
}

enum StoreItemKind {
  file
  document
  directory
}

enum StorePathMode {
  legacy
  unicode
}

model Store {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name              String
  access            StoreAccess     @default(private)
  cloneType         StoreCloneType?
  itemCount         Int             @default(0)
  byteSize          BigInt?
  dirtyAt           DateTime?
  isReadOnly        Boolean         @default(false)
  isTemplateBacking Boolean         @default(false)
  lastEditedAt      DateTime        @default(now())

  pathMode StorePathMode @default(legacy)

  createdByResourceActorOid BigInt?
  createdByResourceActor    ResourceActor? @relation("StoreCreator", fields: [createdByResourceActorOid], references: [oid], onDelete: SetNull)

  resourceTenantOid BigInt?
  resourceTenant    ResourceTenant? @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  resourceGroupOid BigInt?
  resourceGroup    ResourceGroup? @relation(fields: [resourceGroupOid], references: [oid], onDelete: Cascade)

  projectOid BigInt
  project    Project @relation(fields: [projectOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  parentStoreOid BigInt?
  parentStore    Store?  @relation("StoreHierarchy", fields: [parentStoreOid], references: [oid], onDelete: Cascade)
  childStores    Store[] @relation("StoreHierarchy")

  parentStoreTemplateOid BigInt?
  parentStoreTemplate    StoreTemplate? @relation("StoreTemplateParent", fields: [parentStoreTemplateOid], references: [oid], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  items                  StoreItem[]
  versions               StoreVersion[]
  storeParticipants      StoreParticipant[]
  storeParticipantActors StoreParticipantActor[]
  accessTagEntities      AccessTagEntity[]
  skill                  Skill?
  storeDirectories       StoreDirectory[]
  sourceTemplates        StoreTemplate[]         @relation("StoreTemplateSource")
  templateBacking        StoreTemplateBacking?

  @@index([resourceTenantOid, resourceGroupOid, dirtyAt])
  @@index([resourceTenantOid, resourceGroupOid, isTemplateBacking])
  @@index([instanceOid, dirtyAt])
  @@index([instanceOid, isTemplateBacking])
}

model StoreTemplate {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name String
  type StoreTemplateType
  hash String?

  resourceTenantOid BigInt?
  resourceTenant    ResourceTenant? @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  resourceGroupOid BigInt?
  resourceGroup    ResourceGroup? @relation(fields: [resourceGroupOid], references: [oid], onDelete: Cascade)

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  sourceStoreOid BigInt?
  sourceStore    Store?  @relation("StoreTemplateSource", fields: [sourceStoreOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  items              StoreTemplateItem[]
  instantiatedStores Store[]                @relation("StoreTemplateParent")
  skillTemplate      SkillTemplate?
  backingStores      StoreTemplateBacking[]

  @@index([resourceTenantOid, resourceGroupOid])
  @@index([projectOid, instanceOid])
  @@index([sourceStoreOid])
  @@index([hash])
}

model StoreTemplateItem {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  kind StoreItemKind
  path String

  content         String?
  encoding        StoreTemplateItemEncoding?
  mimeType        String?
  title           String?
  hash            String?
  contentHash     String?
  fileStoreId     String?
  contentByteSize Int?

  storeTemplateOid BigInt
  storeTemplate    StoreTemplate @relation(fields: [storeTemplateOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([storeTemplateOid, path])
  @@index([storeTemplateOid, hash])
}

model StoreTemplateBacking {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  storeTemplateOid BigInt
  storeTemplate    StoreTemplate @relation(fields: [storeTemplateOid], references: [oid], onDelete: Cascade)

  resourceTenantOid BigInt?
  resourceTenant    ResourceTenant? @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  resourceGroupOid BigInt?
  resourceGroup    ResourceGroup? @relation(fields: [resourceGroupOid], references: [oid], onDelete: Cascade)

  projectOid BigInt
  project    Project @relation(fields: [projectOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  storeOid BigInt @unique
  store    Store  @relation(fields: [storeOid], references: [oid], onDelete: Cascade)

  lastSyncedHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([storeTemplateOid, resourceTenantOid, resourceGroupOid])
  @@unique([storeTemplateOid, instanceOid])
  @@index([resourceTenantOid, resourceGroupOid])
  @@index([instanceOid])
}

model StoreItem {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  kind StoreItemKind
  path String

  storeOid BigInt
  store    Store  @relation(fields: [storeOid], references: [oid], onDelete: Cascade)

  fileOid BigInt?
  file    File?   @relation(fields: [fileOid], references: [oid], onDelete: Cascade)

  referenceOid BigInt?
  reference    FileReference? @relation(fields: [referenceOid], references: [oid], onDelete: Cascade)

  documentOid BigInt?
  document    Document? @relation(fields: [documentOid], references: [oid], onDelete: Cascade)

  directoryOid BigInt?
  directory    StoreDirectory? @relation("StoreItemDirectory", fields: [directoryOid], references: [oid], onDelete: Cascade)

  parentDirectoryOid BigInt?
  parentDirectory    StoreDirectory? @relation("StoreItemParentDirectory", fields: [parentDirectoryOid], references: [oid], onDelete: Cascade)

  lastModifiedByResourceActorOid BigInt?
  lastModifiedByResourceActor    ResourceActor? @relation(fields: [lastModifiedByResourceActorOid], references: [oid], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  skillAgent SkillAgent?

  @@unique([storeOid, path])
  @@unique([directoryOid])
  @@index([parentDirectoryOid])
  @@index([documentOid])
}

model StoreVersion {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  versionNumber Int
  sourceDirtyAt DateTime

  storeOid BigInt
  store    Store  @relation(fields: [storeOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  items        StoreVersionItem[]
  skillVersion SkillVersion?

  @@unique([storeOid, versionNumber])
  @@unique([storeOid, sourceDirtyAt])
  @@index([storeOid, createdAt])
}

model StoreVersionItem {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  kind StoreItemKind
  path String

  storeVersionOid BigInt
  storeVersion    StoreVersion @relation(fields: [storeVersionOid], references: [oid], onDelete: Cascade)

  fileOid BigInt?
  file    File?   @relation(fields: [fileOid], references: [oid], onDelete: Cascade)

  documentOid BigInt?
  document    Document? @relation(fields: [documentOid], references: [oid], onDelete: Cascade)

  documentTitle String?

  documentVersionOid BigInt?
  documentVersion    DocumentVersion? @relation(fields: [documentVersionOid], references: [oid], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([storeVersionOid, path])
  @@index([fileOid])
  @@index([documentOid])
  @@index([documentVersionOid])
}

enum StoreParticipantPermissions {
  content_read
  content_write
}

enum StoreParticipantRole {
  creator
  editor
  viewer
  user
  forker
}

model StoreParticipant {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  roles StoreParticipantRole[] @default([])

  storeOid BigInt
  store    Store  @relation(fields: [storeOid], references: [oid], onDelete: Cascade)

  consumerOid BigInt?
  consumer    Consumer? @relation(fields: [consumerOid], references: [oid], onDelete: SetNull)

  primaryResourceActorOid BigInt
  primaryResourceActor    ResourceActor @relation("StoreParticipantPrimaryActor", fields: [primaryResourceActorOid], references: [oid], onDelete: Cascade)

  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  actors               StoreParticipantActor[]
  documentParticipants DocumentParticipant[]

  @@unique([storeOid, consumerOid])
  @@unique([storeOid, primaryResourceActorOid])
  @@index([consumerOid])
  @@index([primaryResourceActorOid])
  @@map("StoreParticipantPrincipal")
}

model StoreParticipantActor {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  roles       StoreParticipantRole[]        @default([])
  permissions StoreParticipantPermissions[]

  storeOid BigInt
  store    Store  @relation(fields: [storeOid], references: [oid], onDelete: Cascade)

  storeParticipantOid BigInt?
  storeParticipant    StoreParticipant? @relation(fields: [storeParticipantOid], references: [oid], onDelete: SetNull)

  resourceActorOid BigInt
  resourceActor    ResourceActor @relation(fields: [resourceActorOid], references: [oid], onDelete: Cascade)

  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([storeOid, resourceActorOid])
  @@index([storeParticipantOid])
  @@map("StoreParticipant")
}

model StoreDirectory {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  isAutoCreated Boolean
  path          String

  storeOid BigInt
  store    Store  @relation(fields: [storeOid], references: [oid], onDelete: Cascade)

  parentDirectoryOid BigInt?
  parentDirectory    StoreDirectory?  @relation("StoreDirectoryHierarchy", fields: [parentDirectoryOid], references: [oid], onDelete: Cascade)
  childDirectories   StoreDirectory[] @relation("StoreDirectoryHierarchy")

  storeItem  StoreItem?  @relation("StoreItemDirectory")
  storeItems StoreItem[] @relation("StoreItemParentDirectory")

  createdAt DateTime @default(now())

  @@unique([storeOid, path])
}
