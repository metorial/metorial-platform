enum FilePurposeOwnerType {
  user
  organization
  instance
}

enum FileStatus {
  active
  deleted
}

model FilePurpose {
  oid Int    @id @default(autoincrement())
  id  String @unique

  ownerType    FilePurposeOwnerType
  canHaveLinks Boolean              @default(false)

  slug String @unique
  name String

  createdAt DateTime @default(now())
  files     File[]
}

model File {
  oid    BigInt     @id @default(autoincrement())
  id     String     @unique
  status FileStatus @default(active)

  storeId String

  isInternal Boolean @default(false)

  fileName          String
  fileSize          Int
  fileType          String
  isReadOnly        Boolean @default(false)
  isTemplateBacking Boolean @default(false)

  purposeOid Int
  purpose    FilePurpose @relation(fields: [purposeOid], references: [oid], onDelete: Cascade)

  userOid BigInt?
  user    User?   @relation(fields: [userOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt?
  organization    Organization? @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  resourceTenantOid BigInt?
  resourceTenant    ResourceTenant? @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  resourceGroupOid BigInt?
  resourceGroup    ResourceGroup? @relation(fields: [resourceGroupOid], references: [oid], onDelete: Cascade)

  createdByResourceActorOid BigInt?
  createdByResourceActor    ResourceActor? @relation("FileCreator", fields: [createdByResourceActorOid], references: [oid], onDelete: SetNull)

  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  expiresAt DateTime?

  links                         FileLink[]
  document                      Document?
  storeItems                    StoreItem[]
  storeVersionItems             StoreVersionItem[]
  skillExports                  SkillExport[]
  skillExportRefs               SkillExportRef[]
  skillImports                  SkillImport[]
  mergeRequestItemsAsBaseFile   SkillMergeRequestItem[] @relation("SkillMergeRequestItemBaseFile")
  mergeRequestItemsAsSourceFile SkillMergeRequestItem[] @relation("SkillMergeRequestItemSourceFile")
  mergeRequestItemsAsTargetFile SkillMergeRequestItem[] @relation("SkillMergeRequestItemTargetFile")

  @@index([storeId, status])
  @@index([status, expiresAt, oid])
}

model FileLink {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  key String @unique

  fileOid BigInt
  file    File   @relation(fields: [fileOid], references: [oid], onDelete: Cascade)

  resourceTenantOid BigInt?
  resourceTenant    ResourceTenant? @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  resourceGroupOid BigInt?
  resourceGroup    ResourceGroup? @relation(fields: [resourceGroupOid], references: [oid], onDelete: Cascade)

  createdByResourceActorOid BigInt?
  createdByResourceActor    ResourceActor? @relation("FileLinkCreator", fields: [createdByResourceActorOid], references: [oid], onDelete: SetNull)

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  references      FileReference[]
  skillExportRefs SkillExportRef[]
  skillExports    SkillExport[]
  skillImports    SkillImport[]
}

model FileReference {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  fileLinkOid BigInt
  fileLink    FileLink @relation(fields: [fileLinkOid], references: [oid], onDelete: Cascade)

  resourceTenantOid BigInt?
  resourceTenant    ResourceTenant? @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  resourceGroupOid BigInt?
  resourceGroup    ResourceGroup? @relation(fields: [resourceGroupOid], references: [oid], onDelete: Cascade)

  entityType String
  entityId   String

  createdAt DateTime @default(now())

  storeItems      StoreItem[]
  skillExports    SkillExport[]
  skillExportRefs SkillExportRef[]
  skillImports    SkillImport[]
}
