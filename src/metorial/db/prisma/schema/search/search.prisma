model SearchIndex {
  oid        Int      @id @default(autoincrement())
  identifier String   @unique
  createdAt  DateTime @default(now())

  record SearchIndexRecord[]
}

model SearchIndexRecord {
  oid BigInt @id @default(autoincrement())

  indexOid Int
  index    SearchIndex @relation(fields: [indexOid], references: [oid])

  documentId String
  content    String
  fields     Json

  createdAt DateTime @default(now())

  @@unique([documentId, indexOid])
}
