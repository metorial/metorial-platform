model AccessTag {
  oid BigInt @id @default(autoincrement())

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  accessTagEntities AccessTagEntity[]
  fineGrainedKeys   FineGrainedKey[]
  consumerProfile   ConsumerProfile?
  consumerGroup     ConsumerGroup?
}

model AccessTagPolicy {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name             String
  roles            String[]
  systemIdentifier String?

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  accessTagEntities AccessTagEntity[]

  createdAt DateTime @default(now())

  @@unique([organizationOid, systemIdentifier])
}

model AccessTagEntity {
  oid BigInt @id @default(autoincrement())

  subspaceSessionId String?

  accessTagOid BigInt
  accessTag    AccessTag @relation(fields: [accessTagOid], references: [oid], onDelete: Cascade)

  accessTagPolicyOid BigInt
  accessTagPolicy    AccessTagPolicy @relation(fields: [accessTagPolicyOid], references: [oid], onDelete: Cascade)

  magicMcpTokenOid BigInt?
  magicMcpToken    MagicMcpToken? @relation(fields: [magicMcpTokenOid], references: [oid], onDelete: Cascade)

  magicMcpServerOid BigInt?
  magicMcpServer    MagicMcpServer? @relation(fields: [magicMcpServerOid], references: [oid], onDelete: Cascade)

  magicMcpEndpointOid BigInt?
  magicMcpEndpoint    MagicMcpEndpoint? @relation(fields: [magicMcpEndpointOid], references: [oid], onDelete: Cascade)

  // magicMcpGroupOid BigInt?
  // magicMcpGroup    MagicMcpGroup? @relation(fields: [magicMcpGroupOid], references: [oid], onDelete: Cascade)

  providerTemplateOid BigInt?
  providerTemplate    ProviderTemplate? @relation(fields: [providerTemplateOid], references: [oid], onDelete: Cascade)

  skillOid BigInt?
  skill    Skill?  @relation(fields: [skillOid], references: [oid], onDelete: Cascade)

  skillTemplateOid BigInt?
  skillTemplate    SkillTemplate? @relation(fields: [skillTemplateOid], references: [oid], onDelete: Cascade)

  skillGroupOid BigInt?
  skillGroup    SkillGroup? @relation(fields: [skillGroupOid], references: [oid], onDelete: Cascade)

  skillMarketplaceOid BigInt?
  skillMarketplace    SkillMarketplace? @relation(fields: [skillMarketplaceOid], references: [oid], onDelete: Cascade)

  // serverOAuthSession    ServerOAuthSession? @relation(fields: [serverOAuthSessionOid], references: [oid])
  // serverOAuthSessionOid BigInt?

  @@unique([accessTagOid, accessTagPolicyOid, skillOid])
  @@unique([accessTagOid, accessTagPolicyOid, skillTemplateOid])
  @@unique([accessTagOid, accessTagPolicyOid, skillGroupOid])
  @@unique([accessTagOid, accessTagPolicyOid, skillMarketplaceOid])
  @@index([skillMarketplaceOid])
}
