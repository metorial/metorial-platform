enum AccountDomainStatus {
  active
  inactive
}

enum AccountDomainVerificationStatus {
  unverified
  verified_basic
  verified_full
}

model AccountDomain {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  domain String @unique

  status             AccountDomainStatus
  verificationStatus AccountDomainVerificationStatus

  isFixedToVerified Boolean   @default(false)
  lastCheckedAt     DateTime?
  lastManualCheckAt DateTime?

  accountOid BigInt
  account    Account @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  verifications AccountDomainVerification[]
  statusChanges AccountDomainVerificationStatusChange[]

  @@index([accountOid, status, id])
  @@index([status, domain])
}

enum AccountDomainVerificationType {
  dns
  email
}

enum AccountDomainVerificationInnerStatus {
  unverified
  verified
}

model AccountDomainVerification {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type   AccountDomainVerificationType
  status AccountDomainVerificationInnerStatus

  verificationCode String

  accountDomainOid BigInt
  accountDomain    AccountDomain @relation(fields: [accountDomainOid], references: [oid], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  lastCheckedAt DateTime?

  statusChanges AccountDomainVerificationStatusChange[]

  @@unique([accountDomainOid, type])
  @@index([accountDomainOid, type, status])
}

model AccountDomainVerificationStatusChange {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  accountDomainVerificationOid BigInt
  accountDomainVerification    AccountDomainVerification @relation(fields: [accountDomainVerificationOid], references: [oid], onDelete: Cascade)

  accountDomainOid BigInt
  accountDomain    AccountDomain @relation(fields: [accountDomainOid], references: [oid], onDelete: Cascade)

  oldStatus AccountDomainVerificationInnerStatus
  newStatus AccountDomainVerificationInnerStatus

  createdAt DateTime @default(now())

  @@index([accountDomainVerificationOid, createdAt(sort: Desc)])
  @@index([accountDomainOid, createdAt(sort: Desc)])
}
