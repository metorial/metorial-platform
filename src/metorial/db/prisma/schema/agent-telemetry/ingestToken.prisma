enum AgentTelemetryIngestTokenStatus {
  active
  revoked
}

enum AgentTelemetryIngestTokenDeviceMode {
  bound
  ephemeral
}

model AgentTelemetryIngestToken {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status     AgentTelemetryIngestTokenStatus     @default(active)
  deviceMode AgentTelemetryIngestTokenDeviceMode

  groundstationIngestTokenId String @unique

  name String

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  consumerOid BigInt
  consumer    Consumer @relation(fields: [consumerOid], references: [oid], onDelete: Cascade)

  consumerDeviceOid BigInt?
  consumerDevice    ConsumerDevice? @relation(fields: [consumerDeviceOid], references: [oid], onDelete: SetNull)

  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([consumerDeviceOid, status])
  @@index([consumerOid, status])
  @@index([instanceOid])
}
