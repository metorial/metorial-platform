model ProductAssistantImplementation {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  assistants ProductAssistant[]
}

enum ProductAssistantOwner {
  metorial
  tenant
}

model ProductAssistant {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  ownerType ProductAssistantOwner

  resourceTenantOid BigInt?
  resourceTenant    ResourceTenant? @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  implementationOid BigInt
  implementation    ProductAssistantImplementation @relation(fields: [implementationOid], references: [oid], onDelete: Cascade)

  name             String
  slug             String  @unique
  systemIdentifier String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  assistantInstances     ProductAssistantInstance[]
  assistantConversations ProductAssistantConversation[]
  assistantRequests      ProductAssistantRequest[]
  assistantMessages      ProductAssistantMessage[]
  modelRuns              ProductAssistantModelRun[]

  @@index([resourceTenantOid])
  @@index([implementationOid])
}

model ProductAssistantConfig {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  resourceTenantOid BigInt @unique
  resourceTenant    ResourceTenant @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ProductAssistantInstance {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  assistantOid BigInt
  assistant    ProductAssistant @relation(fields: [assistantOid], references: [oid], onDelete: Cascade)

  resourceTenantOid BigInt
  resourceTenant    ResourceTenant @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  assistantConversations ProductAssistantConversation[]
  assistantRequests      ProductAssistantRequest[]
  assistantMessages      ProductAssistantMessage[]
  modelRuns              ProductAssistantModelRun[]

  @@unique([assistantOid, resourceTenantOid])
  @@index([resourceTenantOid])
}
