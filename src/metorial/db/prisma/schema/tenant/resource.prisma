enum ResourceGroupType {
  development
  production
}

enum ResourceActorType {
  external
  system
}

model ResourceTenant {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  /// [EntityImage]
  image            Json?
  organizationName String?

  identifier String @unique
  name       String

  user         User?
  organization Organization?
  project      Project?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  groups                ResourceGroup[]
  actors                ResourceActor[]
  instances             Instance[]
  files                 File[]
  fileLinks             FileLink[]
  fileReferences        FileReference[]
  documents             Document[]
  documentVersions      DocumentVersion[]
  stores                Store[]
  storeTemplates        StoreTemplate[]
  storeTemplateBackings StoreTemplateBacking[]
  skills                Skill[]
  skillConfigurations   SkillConfiguration[]
  skillTemplates        SkillTemplate[]
  skillMarketplaces     SkillMarketplace[]
  skillPlugins          SkillPlugin[]
  skillRepositories     SkillRepository[]
  skillExports          SkillExport[]
  skillExportRefs       SkillExportRef[]
  skillImports          SkillImport[]
  skillMergeRequests    SkillMergeRequest[]
  skillForkSyncs        SkillForkSync[]
}

model ResourceGroup {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type ResourceGroupType

  identifier String
  name       String

  resourceTenantOid BigInt
  resourceTenant    ResourceTenant @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  user         User?
  organization Organization?
  project      Project?
  instance     Instance?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  files                 File[]
  fileLinks             FileLink[]
  fileReferences        FileReference[]
  documents             Document[]
  documentVersions      DocumentVersion[]
  stores                Store[]
  storeTemplates        StoreTemplate[]
  storeTemplateBackings StoreTemplateBacking[]
  skills                Skill[]
  skillConfigurations   SkillConfiguration[]
  skillTemplates        SkillTemplate[]
  skillMarketplaces     SkillMarketplace[]
  skillPlugins          SkillPlugin[]
  skillRepositories     SkillRepository[]
  skillExports          SkillExport[]
  skillExportRefs       SkillExportRef[]
  skillImports          SkillImport[]
  skillMergeRequests    SkillMergeRequest[]
  skillForkSyncs        SkillForkSync[]

  @@unique([resourceTenantOid, identifier])
  @@index([resourceTenantOid])
}

model ResourceActor {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type ResourceActorType

  identifier String
  name       String

  resourceTenantOid BigInt
  resourceTenant    ResourceTenant @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  organizationActorOid BigInt?
  organizationActor    OrganizationActor? @relation(fields: [organizationActorOid], references: [oid], onDelete: SetNull)

  consumerOid BigInt?
  consumer    Consumer? @relation(fields: [consumerOid], references: [oid], onDelete: SetNull)

  consumerProfileOid BigInt?
  consumerProfile    ConsumerProfile? @relation(fields: [consumerProfileOid], references: [oid], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  documentParticipants      DocumentParticipant[]
  createdDocuments          Document[]                 @relation("DocumentCreator")
  createdStores             Store[]                    @relation("StoreCreator")
  createdSkills             Skill[]                    @relation("SkillCreator")
  createdFiles              File[]                     @relation("FileCreator")
  createdFileLinks          FileLink[]                 @relation("FileLinkCreator")
  createdSkillExports       SkillExport[]              @relation("SkillExportCreator")
  createdSkillImports       SkillImport[]              @relation("SkillImportCreator")
  createdMergeRequests      SkillMergeRequest[]        @relation("SkillMergeRequestCreator")
  createdSkillForkSyncs     SkillForkSync[]            @relation("SkillForkSyncCreator")
  startedMergeRequests      SkillMergeRequest[]        @relation("SkillMergeRequestMergeStarter")
  mergedMergeRequests       SkillMergeRequest[]        @relation("SkillMergeRequestMerger")
  closedMergeRequests       SkillMergeRequest[]        @relation("SkillMergeRequestCloser")
  rolledBackMergeRequests   SkillMergeRequest[]        @relation("SkillMergeRequestRollbacker")
  documentVersionEditors    DocumentVersionEditors[]
  storeParticipants         StoreParticipant[]
  skillParticipants         SkillParticipant[]
  resolvedMergeRequestItems SkillMergeRequestItem[]    @relation("SkillMergeRequestItemResolver")
  skillMergeRequestComments SkillMergeRequestComment[]
  skillMergeRequestEvents   SkillMergeRequestEvent[]
  lastModifiedStoreItems    StoreItem[]

  @@unique([resourceTenantOid, identifier])
  // Promoted to a unique index only after the one-shot actor reconciliation
  // reports zero duplicate/unresolved organization actors.
  @@index([resourceTenantOid, organizationActorOid])
  @@unique([resourceTenantOid, consumerProfileOid])
  @@index([consumerOid])
  @@index([consumerProfileOid])
}
