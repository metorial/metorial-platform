model AgentTrackingOrganizationLink {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  serviceOrganizationId String @unique

  organizationOid BigInt       @unique
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AgentTrackingProjectLink {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  serviceProjectId String @unique

  projectOid BigInt  @unique
  project    Project @relation(fields: [projectOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AgentTrackingInstanceLink {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  serviceInstanceId String @unique

  instanceOid BigInt   @unique
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
