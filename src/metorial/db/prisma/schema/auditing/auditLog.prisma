model AuditLog {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  resource String
  action   String

  ua String?
  ip String?

  resourceTenantOid BigInt
  resourceTenant    ResourceTenant @relation(fields: [resourceTenantOid], references: [oid], onDelete: Cascade)

  resourceGroupOid BigInt
  resourceGroup    ResourceGroup @relation(fields: [resourceGroupOid], references: [oid], onDelete: Cascade)

  resourceActorOid BigInt?
  resourceActor    ResourceActor? @relation(fields: [resourceActorOid], references: [oid], onDelete: SetNull)

  actorType     String?
  actorId       String?
  actorMetadata Json?

  eventOid BigInt?
  event    Event?  @relation(fields: [eventOid], references: [oid], onDelete: SetNull)

  recordedAt DateTime @default(now())

  @@index([resourceTenantOid, recordedAt])
  @@index([resourceGroupOid, recordedAt])
  @@index([resourceActorOid, recordedAt])
  @@index([actorType, actorId, recordedAt])
  @@index([resource, action, recordedAt])
  @@index([eventOid])
}
