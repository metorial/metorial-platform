enum SkillDestinationStorageMode {
  code_bucket
  manifest
}

enum SkillDestinationFileSourceKind {
  file
  blob
}

model SkillDestination {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  codeBucketId    String?
  tag             Int     @default(0)
  contentRevision Int     @default(0)

  storageMode          SkillDestinationStorageMode @default(code_bucket)
  storageModeChangedAt DateTime?

  syncRecoveryVersion Int @default(0)

  isDirty                Boolean   @default(false)
  lastTransientChangeAt  DateTime?
  firstTransientChangeAt DateTime?
  shouldFlushAt          DateTime?
  mustFlushAt            DateTime?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  currentManifestOid BigInt?
  currentManifest    SkillDestinationManifest? @relation("SkillDestinationCurrentManifest", fields: [currentManifestOid], references: [oid], onDelete: SetNull)

  syncs                        SkillDestinationSync[]
  skillMarketplace             SkillMarketplace?
  skillPlugin                  SkillPlugin?
  skillDestinationItems        SkillDestinationItem[]
  skillDestinationFiles        SkillDestinationFile[]
  skillDestinationDeletedFiles SkillDestinationDeletedFile[]
  manifests                    SkillDestinationManifest[]    @relation("SkillDestinationManifests")

  @@index([syncRecoveryVersion])
  @@index([isDirty])
  @@index([shouldFlushAt])
  @@index([mustFlushAt])
}

model SkillDestinationFile {
  oid BigInt @id @default(autoincrement())

  destinationOid BigInt
  destination    SkillDestination @relation(fields: [destinationOid], references: [oid], onDelete: Cascade)

  path      String
  pathBytes Bytes?
  signature String

  itemKey String?

  gitBlobSha String?
  sha256     String?
  byteSize   BigInt?
  crc32      BigInt?

  sourceKind    SkillDestinationFileSourceKind?
  sourceKey     String?
  sourceFileOid BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([destinationOid, path])
  @@index([destinationOid])
  @@index([destinationOid, itemKey])
  @@index([destinationOid, pathBytes])
  @@index([sourceKey])
}

model SkillDestinationManifest {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  sha256        String
  objectKey     String
  formatVersion Int

  entryCount Int
  totalBytes BigInt

  destinationOid BigInt
  destination    SkillDestination @relation("SkillDestinationManifests", fields: [destinationOid], references: [oid], onDelete: Cascade)

  createdAt        DateTime @default(now())
  lastReferencedAt DateTime @default(now())

  currentForDestinations SkillDestination[]                          @relation("SkillDestinationCurrentManifest")
  syncs                  SkillDestinationSync[]
  propagations           SkillDestinationSyncRepositoryPropagation[] @relation("PropagationManifest")
  lastPropagatedRepos    SkillRepository[]
  exportRefs             SkillExportRef[]

  @@unique([destinationOid, sha256])
  @@index([lastReferencedAt])
  @@index([objectKey])
}

model SkillSyncBlob {
  oid BigInt @id @default(autoincrement())

  key        String @unique
  sha256     String @unique
  gitBlobSha String
  crc32      BigInt
  byteSize   BigInt

  createdAt        DateTime @default(now())
  lastReferencedAt DateTime @default(now())

  @@index([lastReferencedAt])
}

model SkillDestinationDeletedFile {
  oid BigInt @id @default(autoincrement())

  destinationOid BigInt
  destination    SkillDestination @relation(fields: [destinationOid], references: [oid], onDelete: Cascade)

  path      String
  createdAt DateTime @default(now())

  @@unique([destinationOid, path])
  @@index([destinationOid, createdAt])
}

model SkillDestinationItem {
  oid BigInt @id @default(autoincrement())

  cargoOid BigInt? @unique

  destinationOid BigInt
  destination    SkillDestination @relation(fields: [destinationOid], references: [oid], onDelete: Cascade)

  skillMarketplaceOid BigInt?
  skillMarketplace    SkillMarketplace? @relation(fields: [skillMarketplaceOid], references: [oid], onDelete: Cascade)

  skillPluginOid BigInt?
  skillPlugin    SkillPlugin? @relation(fields: [skillPluginOid], references: [oid], onDelete: Cascade)

  skillOid BigInt?
  skill    Skill?  @relation(fields: [skillOid], references: [oid], onDelete: Cascade)

  hash String
}

enum SkillDestinationSyncStatus {
  pending
  completed
  failed
  processing
  waiting_for_review
  canceled
}

enum SkillDestinationSyncRepositoryPropagationStatus {
  pending
  processing
  waiting_for_review
  completed
  failed
  canceled
}

enum SkillDestinationSyncTrigger {
  automatic
  manual
  repair
  drift_check
  recovery
  migration
}

model SkillDestinationSync {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status            SkillDestinationSyncStatus
  trigger           SkillDestinationSyncTrigger @default(automatic)
  isAtRepoSyncStage Boolean                     @default(false)

  contentVersion Int @default(0)

  storageMode     SkillDestinationStorageMode @default(code_bucket)
  allowMassDelete Boolean                     @default(false)

  destinationOid BigInt
  destination    SkillDestination @relation(fields: [destinationOid], references: [oid], onDelete: Cascade)

  manifestOid BigInt?
  manifest    SkillDestinationManifest? @relation(fields: [manifestOid], references: [oid], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  prName        String?
  prDescription String?
  commitMessage String?

  /// [SyncLogEntry]
  logs Json[] @default([])

  repositoryPropagations SkillDestinationSyncRepositoryPropagation[]

  @@index([destinationOid, status])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([createdAt])
}

model SkillDestinationSyncRepositoryPropagation {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status                SkillDestinationSyncRepositoryPropagationStatus
  originSyncId          String?
  repositoryAccessMode  SkillMarketplaceRepositoryAccessMode            @default(pull_request)
  forceMergeOrPush      Boolean                                         @default(false)
  mergeBeforeChecksPass Boolean                                         @default(false)

  branchName    String
  prName        String
  prDescription String?
  commitMessage String?
  errorMessage  String?
  errorCode     String?
  endReason     String?

  /// [SkillSyncPropagationErrorDetails]
  errorDetails Json?

  waitingUntil  DateTime?
  waitingReason String?

  deletionsUpTo   DateTime?
  contentRevision Int?

  previousManifestSha256 String?

  /// [SkillSyncResultStats]
  resultStats Json?

  manifestOid BigInt?
  manifest    SkillDestinationManifest? @relation("PropagationManifest", fields: [manifestOid], references: [oid], onDelete: SetNull)

  skillDestinationSyncOid BigInt
  skillDestinationSync    SkillDestinationSync @relation(fields: [skillDestinationSyncOid], references: [oid], onDelete: Cascade)

  skillRepositoryOid BigInt
  skillRepository    SkillRepository @relation(fields: [skillRepositoryOid], references: [oid], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([skillDestinationSyncOid, skillRepositoryOid])
  @@index([status])
  @@index([originSyncId])
  @@index([skillRepositoryOid])
}

model SkillOriginChangeNotificationCursor {
  consumer String @id

  cursor String?

  leaseId    String?
  leaseUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([leaseUntil])
}
