enum OutpostTokenKeyPairStatus {
  active
  replaced
  expired
  revoked
}

model OutpostTokenKeyPair {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status OutpostTokenKeyPairStatus

  accountOid BigInt
  account    Account @relation(fields: [accountOid], references: [oid], onDelete: Cascade)

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  publicKey           Bytes
  privateKeyEncrypted Bytes

  stopSigningAt   DateTime
  stopVerifyingAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([accountOid, organizationOid, status])
  @@index([status, stopSigningAt])
  @@index([status, stopVerifyingAt])
}
