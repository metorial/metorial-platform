enum MagicMcpEndpointStatus {
  active
  archived
  deleted
}

enum MagicMcpEndpointSkillSelectionType {
  all
  selected
}

model MagicMcpEndpoint {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status                       MagicMcpEndpointStatus
  isConsumerReconciled         Boolean                @default(false)
  hasSubspaceBacking           Boolean                @default(false)
  isSubspaceBackingReconciling Boolean                @default(false)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid], onDelete: Cascade)

  consumerProfileOid BigInt?
  consumerProfile    ConsumerProfile? @relation(fields: [consumerProfileOid], references: [oid], onDelete: SetNull)

  source IntegrationResourceSource?

  isOwnerLocked      Boolean @default(false)
  isOwnerOnlyVisible Boolean @default(false)
  isSystemOwned      Boolean @default(false)

  ownerActorOid BigInt?
  ownerActor    IdentityActor? @relation(fields: [ownerActorOid], references: [oid], onDelete: SetNull)

  skillPluginOid BigInt?
  skillPlugin    SkillPlugin? @relation(fields: [skillPluginOid], references: [oid], onDelete: SetNull)

  enableSkillEditing   Boolean                            @default(false)
  enableSkillResources Boolean                            @default(false)
  skillSelectionType   MagicMcpEndpointSkillSelectionType @default(all)

  legacySubspaceSessionTemplateId   String? @map("subspaceSessionTemplateId")
  subspaceEphemeralManagedSessionId String?
  configurationHash                 String?

  name        String?
  description String?
  slug        String  @unique
  metadata    Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  servers                        MagicMcpEndpointServer[]
  subspaceSession                MagicMcpSession[]
  tokens                         MagicMcpToken[]
  uses                           MagicMcpTokenUse[]
  accessTagEntities              AccessTagEntity[]
  consumerAuthClients            ConsumerAuthClient[]
  consumerAuthAttempts           ConsumerAuthAttempt[]
  consumerAuthTestAuthorizations ConsumerAuthTestAuthorization[]
  consumerIntegrationEndpoints   ConsumerIntegrationEndpoint[]
  skillSelections                MagicMcpEndpointSkillSelection[]

  @@index([instanceOid, status])
  @@index([legacySubspaceSessionTemplateId])
  @@index([ownerActorOid])
}

model MagicMcpEndpointServer {
  oid BigInt @id @default(autoincrement())
  id  String @unique @default(dbgenerated("('mgep_00' || replace((gen_random_uuid())::text, '-', ''))"))

  magicMcpEndpointOid BigInt
  magicMcpEndpoint    MagicMcpEndpoint @relation(fields: [magicMcpEndpointOid], references: [oid], onDelete: Cascade)

  magicMcpServerOid BigInt
  magicMcpServer    MagicMcpServer @relation(fields: [magicMcpServerOid], references: [oid], onDelete: Cascade)

  toolFilters Json?

  createdAt DateTime @default(now())

  @@unique([magicMcpEndpointOid, magicMcpServerOid])
}

model MagicMcpEndpointSkillSelection {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  magicMcpEndpointOid BigInt
  magicMcpEndpoint    MagicMcpEndpoint @relation(fields: [magicMcpEndpointOid], references: [oid], onDelete: Cascade)

  skillOid BigInt?
  skill    Skill?  @relation(fields: [skillOid], references: [oid], onDelete: Cascade)

  skillGroupOid BigInt?
  skillGroup    SkillGroup? @relation(fields: [skillGroupOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([magicMcpEndpointOid, skillOid])
  @@unique([magicMcpEndpointOid, skillGroupOid])
  @@index([skillOid])
  @@index([skillGroupOid])
}
