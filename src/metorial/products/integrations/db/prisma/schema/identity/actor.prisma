enum IdentityActorType {
  organization_member
  person
  agent
  consumer
}

enum IdentityActorStatus {
  active
  archived
  deleted
}

model IdentityActor {
  oid BigInt @id
  id  String @unique

  type            IdentityActorType
  status          IdentityActorStatus
  isParentDeleted Boolean             @default(false)

  name            String
  description     String?
  metadata        Json?
  privateMetadata Json?

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  consumerOid BigInt?
  consumer    Consumer? @relation(fields: [consumerOid], references: [oid], onDelete: SetNull)

  instanceConsumerOid BigInt?
  instanceConsumer    InstanceConsumer? @relation("IdentityActorInstanceConsumer", fields: [instanceConsumerOid], references: [oid], onDelete: SetNull)

  consumerProfileOid BigInt?
  consumerProfile    ConsumerProfile? @relation(fields: [consumerProfileOid], references: [oid], onDelete: SetNull)

  defaultForInstanceConsumerOid BigInt?           @unique
  defaultForInstanceConsumer    InstanceConsumer? @relation("IdentityActorDefaultForInstanceConsumer", fields: [defaultForInstanceConsumerOid], references: [oid], onDelete: SetNull)

  defaultIdentityOid BigInt?   @unique
  defaultIdentity    Identity? @relation("IdentityActorDefaultIdentity", fields: [defaultIdentityOid], references: [oid], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?

  agent                          Agent?
  identities                     Identity[]                  @relation("IdentityActorIdentities")
  identityDelegationParties      IdentityDelegationParty[]
  identityDelegationRequests     IdentityDelegationRequest[]
  delegatedIdentities            DelegatedIdentity[]
  identityDelegations            IdentityDelegation[]        @relation("delegations")
  subDelegations                 IdentityDelegation[]        @relation("subDelegatedTo")
  integrationInstances           IntegrationInstance[]       @relation("IntegrationInstanceIdentityActor")
  integrationInstanceGroups      IntegrationInstanceGroup[]  @relation("IntegrationInstanceGroupIdentityActor")
  sessionTemplates               SessionTemplate[]           @relation("SessionTemplateIdentityActor")
  sessions                       Session[]                   @relation("SessionIdentityActor")
  magicMcpEndpointBackings       MagicMcpEndpointBacking[]   @relation("MagicMcpEndpointBackingActor")
  magicMcpServerBackings         MagicMcpServerBacking[]     @relation("MagicMcpServerBackingActor")
  ephemeralManagedSessions       EphemeralManagedSession[]   @relation("EphemeralManagedSessionActor")
  ownedIntegrationInstances      IntegrationInstance[]       @relation("IntegrationInstanceOwnerActor")
  ownedIntegrationInstanceGroups IntegrationInstanceGroup[]  @relation("IntegrationInstanceGroupOwnerActor")
  ownedSessionTemplates          SessionTemplate[]           @relation("SessionTemplateOwnerActor")
  ownedSessions                  Session[]                   @relation("SessionOwnerActor")
  ownedMagicMcpEndpointBackings  MagicMcpEndpointBacking[]   @relation("MagicMcpEndpointBackingOwnerActor")
  ownedMagicMcpServerBackings    MagicMcpServerBacking[]     @relation("MagicMcpServerBackingOwnerActor")
  ownedEphemeralManagedSessions  EphemeralManagedSession[]   @relation("EphemeralManagedSessionOwnerActor")
  ownedProviderConfigs           ProviderConfig[]
  ownedProviderAuthConfigs       ProviderAuthConfig[]
  ownedProviderSetupSessions     ProviderSetupSession[]
  ownedIntegrationSetupSessions  IntegrationSetupSession[]
  ownedPublicMcpServers          PublicMcpServer[]
  sessionParticipants            SessionParticipant[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
  @@index([projectOid])
  @@index([instanceOid])
  @@index([consumerOid])
  @@index([instanceConsumerOid])
  @@index([consumerProfileOid])
}
