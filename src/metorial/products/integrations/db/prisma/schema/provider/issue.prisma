enum ProviderIssueType {
  provider_error
  auth_error
  protoguard_warning
}

enum ProviderIssueSeverity {
  warning
  error
  critical
}

model ProviderIssue {
  oid BigInt @id
  id  String @unique

  type     ProviderIssueType
  subtype  String
  severity ProviderIssueSeverity
  hash     String

  code    String
  message String

  occurrenceCount Int @default(0)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  providerOid BigInt?
  provider    Provider? @relation(fields: [providerOid], references: [oid])

  protoGuardFilterOid BigInt?
  protoGuardFilter    ProtoGuardFilter? @relation(fields: [protoGuardFilterOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  projectOid BigInt
  project    Project @relation(fields: [projectOid], references: [oid])

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  occurrencePeriods ProviderIssueOccurrencePeriod[]
  sessionErrors     SessionError[]
  authConfigErrors  ProviderAuthConfigError[]
  protoGuardAlerts  ProtoGuardAlert[]

  @@unique([tenantOid, environmentOid, type, hash])
  @@index([instanceOid, lastSeenAt])
  @@index([instanceOid, type, lastSeenAt])
  @@index([providerOid])
  @@index([protoGuardFilterOid])
}

model ProviderIssueOccurrencePeriod {
  oid BigInt @id

  startsAt DateTime
  endsAt   DateTime

  occurrenceCount Int @default(0)

  issueOid BigInt
  issue    ProviderIssue @relation(fields: [issueOid], references: [oid], onDelete: Cascade)

  @@unique([issueOid, startsAt])
}
