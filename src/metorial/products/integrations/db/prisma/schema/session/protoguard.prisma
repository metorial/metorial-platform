enum ProtoGuardIssueType {
  instruction_override
  role_hijack
  jailbreak_persona
  prompt_exfiltration
  tool_call_forgery
  format_break
  instruction_block
  unicode_smuggling
  encoded_payload
  typoglycemia
  ascii_smuggling
  exfil_channel
  hidden_content
  cross_tool_reference
  addressed_to_agent
  secret_in_arguments
  tool_poisoning
  tool_shadowing
  tool_rug_pull
  injection_followed_by_sink
}

enum ProtoGuardSeverity {
  low
  medium
  high
  critical
}

enum ProtoGuardRuleStage {
  shadow
  active
  deprecated
}

enum ProtoGuardFindingDirection {
  input
  output
  session
}

enum ProtoGuardFindingView {
  raw
  canonical
  decoded
}

enum ProtoGuardRunCoverage {
  full
  sampled
  partial
  skipped
}

enum ProtoGuardSuppressionStatus {
  active
  archived
}

model ProtoGuardFilter {
  oid BigInt @id
  id  String @unique

  key         String  @unique
  name        String
  description String?

  issueType      ProtoGuardIssueType
  severity       ProtoGuardSeverity
  scoreWeight    Float
  defaultEnabled Boolean             @default(true)

  alertConfidenceThreshold Float

  stage ProtoGuardRuleStage @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenantFilterSettings ProtoGuardTenantFilterSetting[]
  alertInstances       ProtoGuardAlertInstance[]
  suppressions         ProtoGuardSuppression[]
  monitors             Monitor[]
  providerIssues       ProviderIssue[]

  @@index([issueType])
  @@index([severity])
  @@index([defaultEnabled])
}

model ProtoGuardTenantSetting {
  oid BigInt @id
  id  String @unique

  enabled Boolean @default(true)

  alertFilterCountThreshold Int?
  alertProbabilityThreshold Float?

  contentHashKey String?

  tenantOid BigInt @unique
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([projectOid])
}

model ProtoGuardTenantFilterSetting {
  oid BigInt @id
  id  String @unique

  enabled                  Boolean
  alertConfidenceThreshold Float?

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  filterOid BigInt
  filter    ProtoGuardFilter @relation(fields: [filterOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantOid, filterOid])
  @@index([tenantOid, enabled])
  @@index([projectOid])
}

enum ProtoGuardRunStatus {
  completed
  failed
  skipped
}

model ProtoGuardRun {
  oid BigInt @id
  id  String @unique

  status ProtoGuardRunStatus

  score                     Float
  maxScore                  Float
  confidence                Float
  triggeredFilterCount      Int
  matchedInstanceCount      Int
  alertFilterCountThreshold Int

  rulesetVersion String?
  retentionLevel SessionDataRetentionLevel?
  probability    Float?

  /// [ProtoGuardFamilyScores]
  familyScores Json?

  coverage     ProtoGuardRunCoverage?
  skipReason   String?
  scannedChars Int?
  totalChars   Int?
  durationMs   Int?

  error Json?

  messageOid BigInt         @unique
  message    SessionMessage @relation(fields: [messageOid], references: [oid], onDelete: Cascade)

  sessionOid BigInt
  session    Session @relation(fields: [sessionOid], references: [oid], onDelete: Cascade)

  connectionOid BigInt?
  connection    SessionConnection? @relation(fields: [connectionOid], references: [oid])

  providerRunOid BigInt?
  providerRun    ProviderRun? @relation(fields: [providerRunOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  alert    ProtoGuardAlert?
  findings ProtoGuardAlertInstance[]

  @@index([createdAt])
  @@index([tenantOid, createdAt])
  @@index([sessionOid, createdAt])
  @@index([status])
  @@index([confidence])
  @@index([projectOid])
  @@index([instanceOid])
  @@index([connectionOid])
  @@index([providerRunOid])
}

model ProtoGuardAlert {
  oid BigInt @id
  id  String @unique

  sampleMarkdown String

  issueTypes Json

  dedupKey        String?
  occurrenceCount Int       @default(1)
  firstSeenAt     DateTime?
  lastSeenAt      DateTime?

  runOid BigInt        @unique
  run    ProtoGuardRun @relation(fields: [runOid], references: [oid], onDelete: Cascade)

  issueOid BigInt?
  issue    ProviderIssue? @relation(fields: [issueOid], references: [oid])

  messageOid BigInt
  message    SessionMessage @relation(fields: [messageOid], references: [oid], onDelete: Cascade)

  sessionOid BigInt
  session    Session @relation(fields: [sessionOid], references: [oid], onDelete: Cascade)

  connectionOid BigInt?
  connection    SessionConnection? @relation(fields: [connectionOid], references: [oid])

  providerRunOid BigInt?
  providerRun    ProviderRun? @relation(fields: [providerRunOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid])

  createdAt DateTime @default(now())

  instances     ProtoGuardAlertInstance[]
  monitorAlerts MonitorAlert[]

  @@index([createdAt])
  @@index([tenantOid, createdAt])
  @@index([tenantOid, dedupKey, lastSeenAt])
  @@index([issueOid])
  @@index([sessionOid, createdAt])
  @@index([messageOid])
  @@index([projectOid])
  @@index([instanceOid])
  @@index([connectionOid])
  @@index([providerRunOid])
}

model ProtoGuardAlertInstance {
  oid BigInt @id
  id  String @unique

  issueType ProtoGuardIssueType
  severity  ProtoGuardSeverity

  ruleKey   String?
  stage     ProtoGuardRuleStage         @default(active)
  direction ProtoGuardFindingDirection?
  view      ProtoGuardFindingView?

  path           String
  startOffset    Int
  endOffset      Int
  matchedText    String?
  sampleMarkdown String?
  description    String?
  contentHmac    String?

  confidence          Float
  confidenceThreshold Float
  isSuppressed        Boolean @default(false)

  metadata Json?

  runOid BigInt?
  run    ProtoGuardRun? @relation(fields: [runOid], references: [oid], onDelete: Cascade)

  alertOid BigInt?
  alert    ProtoGuardAlert? @relation(fields: [alertOid], references: [oid], onDelete: Cascade)

  filterOid BigInt
  filter    ProtoGuardFilter @relation(fields: [filterOid], references: [oid], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([filterOid, issueType])
  @@index([severity])
  @@index([alertOid])
  @@index([runOid])
}

model ProtoGuardSuppression {
  oid BigInt @id
  id  String @unique

  status ProtoGuardSuppressionStatus @default(active)
  reason String?

  toolKey     String?
  contentHmac String?

  expiresAt  DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  filterOid BigInt
  filter    ProtoGuardFilter @relation(fields: [filterOid], references: [oid], onDelete: Cascade)

  providerOid BigInt?
  provider    Provider? @relation(fields: [providerOid], references: [oid])

  @@index([tenantOid, status])
  @@index([projectOid])
  @@index([filterOid])
  @@index([providerOid])
}

model ProtoGuardToolScan {
  oid BigInt @id
  id  String @unique

  rulesetVersion String
  status         ProtoGuardRunStatus

  probability Float
  isFlagged   Boolean

  /// [ProtoGuardToolFindings]
  findings Json

  previousToolHash String?

  createdAt DateTime @default(now())

  providerToolOid BigInt
  providerTool    ProviderTool @relation(fields: [providerToolOid], references: [oid], onDelete: Cascade)

  providerOid BigInt
  provider    Provider @relation(fields: [providerOid], references: [oid], onDelete: Cascade)

  @@unique([providerToolOid, rulesetVersion])
  @@index([providerOid, isFlagged])
  @@index([createdAt])
}
