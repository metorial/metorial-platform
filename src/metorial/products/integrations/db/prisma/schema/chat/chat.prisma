enum ChatStatus {
  active
  archived
  deleted
}

model Chat {
  oid BigInt @id
  id  String @unique

  status          ChatStatus @default(active)
  isParentDeleted Boolean    @default(false)
  archivedAt      DateTime?

  name String

  chatConnectionOid BigInt
  chatConnection    ChatConnection @relation(fields: [chatConnectionOid], references: [oid], onDelete: Cascade)

  chatInstanceOid BigInt
  chatInstance    ChatInstance @relation(fields: [chatInstanceOid], references: [oid], onDelete: Cascade)

  chatInstanceProviderOid BigInt
  chatInstanceProvider    ChatInstanceProvider @relation(fields: [chatInstanceProviderOid], references: [oid], onDelete: Cascade)

  adapterOid BigInt
  adapter    ProviderAdapter @relation(fields: [adapterOid], references: [oid], onDelete: Cascade)

  providerOid BigInt
  provider    Provider @relation(fields: [providerOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  workspace  ChatWorkspace?
  chatEvents ChatEvent[]
  authors   ChatAuthor[]
  channels  ChatChannel[]
  threads   ChatThread[]

  @@index([chatConnectionOid, status])
  @@index([chatInstanceOid, status])
  @@index([chatInstanceProviderOid, status])
  @@index([status, archivedAt])
  @@index([createdAt])
}
