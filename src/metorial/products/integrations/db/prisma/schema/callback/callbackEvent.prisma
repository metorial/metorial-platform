enum CallbackEventStatus {
  pending
  processed
  failed
}

enum CallbackEventSource {
  webhook
  polling
  // Not produced by callback ingestion -- used by ChatEvent rows recorded directly by the chat
  // module itself (resource lifecycle events, invocation failures), which have no CallbackEvent.
  internal
}

model CallbackEvent {
  oid BigInt @id
  id  String @unique

  status CallbackEventStatus @default(pending)
  source CallbackEventSource

  providerTriggerKey String

  providerTriggerOid BigInt?
  providerTrigger    ProviderTrigger? @relation(fields: [providerTriggerOid], references: [oid])

  mappedType String?
  mappedId   String?

  callbackOid BigInt
  callback    Callback @relation(fields: [callbackOid], references: [oid], onDelete: Cascade)

  callbackInstanceOid BigInt
  callbackInstance    CallbackInstance @relation(fields: [callbackInstanceOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  projectOid BigInt
  project    Project @relation(fields: [projectOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  occurredAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  slateTriggerEvent SlateTriggerEvent?
  chatEvents        ChatEvent[]

  @@index([callbackOid, createdAt])
  @@index([callbackInstanceOid, createdAt])
  @@index([createdAt, id])
  @@index([tenantOid, solutionOid, environmentOid, createdAt])
  @@index([status])
  @@index([projectOid])
  @@index([instanceOid])
  @@map("CallbackEventV2")
}
