enum WebhookRegistrationStatus {
  awaiting_setup
  active
  archived
  deleted
}

model WebhookRegistration {
  oid BigInt @id
  id  String @unique

  status     WebhookRegistrationStatus
  archivedAt DateTime?

  name        String
  description String?
  metadata    Json?

  receiveUrl String?

  /// [WebhookRegistrationSetup]
  setup Json?

  providerOid BigInt
  provider    Provider @relation(fields: [providerOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  slateWebhookRegistration SlateWebhookRegistration?

  @@index([tenantOid, solutionOid, environmentOid, status])
  @@index([providerOid, status])
  @@index([projectOid])
  @@index([instanceOid])
  @@map("WebhookRegistrationV2")
}
