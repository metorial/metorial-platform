model Network {
  oid BigInt @id
  id  String @unique

  name        String
  description String?

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  enclaves         Enclave[]
  firewalls        Firewall[]
  firewallBindings FirewallBinding[]

  @@unique([tenantOid, environmentOid])
  @@index([projectOid])
  @@index([instanceOid])
}

enum FirewallStatus {
  active
  archived
  deleted
}

model Firewall {
  oid BigInt @id
  id  String @unique

  status FirewallStatus @default(active)

  name        String
  description String?
  slug        String

  networkOid BigInt
  network    Network @relation(fields: [networkOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?

  bindings           FirewallBinding[]
  networkPolicyLinks FirewallNetworkPolicy[]

  @@unique([tenantOid, environmentOid, slug])
  @@index([status])
  @@index([projectOid])
  @@index([instanceOid])
}

enum FirewallBindingTargetType {
  enclave
  provider
  network
}

model FirewallBinding {
  oid BigInt @id
  id  String @unique

  firewallOid BigInt
  firewall    Firewall @relation(fields: [firewallOid], references: [oid], onDelete: Cascade)

  targetType FirewallBindingTargetType

  enclaveOid BigInt?
  enclave    Enclave? @relation(fields: [enclaveOid], references: [oid], onDelete: Cascade)

  providerOid BigInt?
  provider    Provider? @relation(fields: [providerOid], references: [oid], onDelete: Cascade)

  networkOid BigInt?
  network    Network? @relation(fields: [networkOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  createdAt DateTime @default(now())

  @@unique([firewallOid, enclaveOid])
  @@unique([firewallOid, providerOid])
  @@unique([firewallOid, networkOid])
  @@index([projectOid])
  @@index([instanceOid])
}

enum NetworkPolicyStatus {
  active
  archived
  deleted
}

model NetworkPolicy {
  oid BigInt @id
  id  String @unique

  status NetworkPolicyStatus @default(active)

  name        String
  description String?

  currentVersionOid BigInt?
  currentVersion    NetworkPolicyVersion? @relation("currentVersion", fields: [currentVersionOid], references: [oid])

  currentVersionNumber Int @default(0)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?

  versions      NetworkPolicyVersion[]
  firewallLinks FirewallNetworkPolicy[]

  @@index([status])
  @@index([projectOid])
  @@index([instanceOid])
}

model NetworkPolicyVersion {
  oid BigInt @id
  id  String @unique

  version Int

  /// [NetworkPolicyRules]
  rules Json

  networkPolicyOid BigInt
  networkPolicy    NetworkPolicy @relation(fields: [networkPolicyOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  currentVersionFor NetworkPolicy[] @relation("currentVersion")

  @@unique([networkPolicyOid, version])
}

model FirewallNetworkPolicy {
  oid BigInt @id
  id  String @unique

  firewallOid BigInt
  firewall    Firewall @relation(fields: [firewallOid], references: [oid], onDelete: Cascade)

  networkPolicyOid BigInt
  networkPolicy    NetworkPolicy @relation(fields: [networkPolicyOid], references: [oid], onDelete: Cascade)

  position Int @default(0)

  createdAt DateTime @default(now())

  @@unique([firewallOid, networkPolicyOid])
}

enum EnclaveIngressNetworkLogResult {
  allowed
  denied
}

model EnclaveIngressNetworkLog {
  oid BigInt @id
  id  String @unique

  enclaveOid BigInt
  sessionId  String?

  bucketStart DateTime

  sourceIp String
  hostname String
  port     Int

  result EnclaveIngressNetworkLogResult
  count  Int                            @default(1)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  solutionOid Int

  firstSeenAt DateTime
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())

  @@index([tenantOid, environmentOid, bucketStart])
  @@index([enclaveOid, bucketStart])
  @@index([sourceIp])
  @@index([result])
  @@index([environmentOid])
  @@index([projectOid])
  @@index([instanceOid])
}
