model Cell {
  oid        Int    @id @default(autoincrement())
  identifier String @unique

  lastSyncRangeStart DateTime?
  lastSyncRangeEnd   DateTime?

  endpointUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  organizations                     Organization[]
  portals                           Portal[]
  skillPlugins                      SkillPlugin[]
  consumerSurfaces                  ConsumerSurface[]
  users                             User[]
  oauthApplications                 OAuthApplication[]
  oauthAuthorizationRequestsCreated OAuthAuthorizationRequest[] @relation("createdBy")
  oauthAuthorizationRequestsClaimed OAuthAuthorizationRequest[] @relation("claimedBy")
  oauthTokens                       OAuthToken[]
  oauthJwks                         OAuthJwk[]
  globalLeases                      GlobalLease[]
  cellTokens                        CellToken[]
  workspaces                        Workspace[]
  instances                         Instance[]
  workspaceProfiles                 WorkspaceProfile[]
}

model CellToken {
  oid Int    @id @default(autoincrement())
  id  String @unique @default(uuid())

  cellOid Int
  cell    Cell @relation(fields: [cellOid], references: [oid])

  token     String
  expiresAt DateTime

  createdAt DateTime @default(now())
}
