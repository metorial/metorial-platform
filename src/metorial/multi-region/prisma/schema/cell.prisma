model Cell {
  oid        Int    @id @default(autoincrement())
  identifier String @unique

  lastSyncRangeStart DateTime?
  lastSyncRangeEnd   DateTime?

  endpointUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  organizations                     Organization[]
  portals                           Portal[]
  skillPlugins                      SkillPlugin[]
  consumerSurfaces                  ConsumerSurface[]
  users                             User[]
  oauthApplications                 OAuthApplication[]
  oauthAuthorizationRequestsCreated OAuthAuthorizationRequest[] @relation("createdBy")
  oauthAuthorizationRequestsClaimed OAuthAuthorizationRequest[] @relation("claimedBy")
  oauthTokens                       OAuthToken[]
  oauthJwks                         OAuthJwk[]
  globalLeases                      GlobalLease[]
  cellTokens                        CellToken[]
  hyperplanes                       Hyperplane[]
  workspaces                        Workspace[]
  instances                         Instance[]
  workspaceProfiles                 WorkspaceProfile[]
  workspaceInvites                  WorkspaceInvite[]
  workspaceGroups                   WorkspaceGroup[]
  workspacePolicies                 WorkspacePolicy[]
  workspaceGroupAssignments         WorkspaceGroupAssignment[]
  workspacePolicyAssignments        WorkspacePolicyAssignment[]
}

model CellToken {
  oid Int    @id @default(autoincrement())
  id  String @unique @default(uuid())

  cellOid Int
  cell    Cell @relation(fields: [cellOid], references: [oid])

  token     String
  expiresAt DateTime

  createdAt DateTime @default(now())
}

model Hyperplane {
  oid        Int    @id @default(autoincrement())
  identifier String @unique

  cellOid Int?
  cell    Cell? @relation(fields: [cellOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tokens HyperplaneToken[]
}

model HyperplaneToken {
  oid Int    @id @default(autoincrement())
  id  String @unique @default(uuid())

  hyperplaneOid Int
  hyperplane    Hyperplane @relation(fields: [hyperplaneOid], references: [oid])

  token     String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([hyperplaneOid, expiresAt])
}

model Horizon {
  oid        Int    @id @default(autoincrement())
  identifier String @unique

  endpointUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tokens HorizonToken[]
}

model HorizonToken {
  oid Int    @id @default(autoincrement())
  id  String @unique @default(uuid())

  horizonOid Int
  horizon    Horizon @relation(fields: [horizonOid], references: [oid])

  token     String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([horizonOid, expiresAt])
}
