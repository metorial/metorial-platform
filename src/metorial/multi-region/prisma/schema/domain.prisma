enum AccountDomainStatus {
  active
  inactive
}

enum AccountDomainVerificationStatus {
  unverified
  verified_basic
  verified_full
}

model AccountDomain {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  domain String @unique

  status             AccountDomainStatus
  verificationStatus AccountDomainVerificationStatus

  isFixedToVerified Boolean @default(false)

  accountId String

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  lastCheckedAt     DateTime?
  lastManualCheckAt DateTime?

  @@index([accountId, status, id])
  @@index([status, domain])
}
