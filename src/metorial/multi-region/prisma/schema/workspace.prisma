enum WorkspaceType {
  organization
  portal
}

enum WorkspaceStatus {
  active
  archived
  deleted
}

model Workspace {
  id String @id

  type   WorkspaceType
  status WorkspaceStatus

  name String

  accountId      String
  portalId       String?
  organizationId String?

  ownerOid Int
  owner    Cell @relation(fields: [ownerOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
