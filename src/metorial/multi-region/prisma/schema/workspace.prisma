enum WorkspaceType {
  organization
  portal
}

enum WorkspaceStatus {
  active
  archived
  deleted
}

model Workspace {
  id String @id

  type   WorkspaceType
  status WorkspaceStatus

  name String

  accountId      String
  portalId       String?
  organizationId String?

  ownerOid Int
  owner    Cell @relation(fields: [ownerOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  profiles WorkspaceProfile[]
  invites  WorkspaceInvite[]
}

enum WorkspaceProfileStatus {
  active
  deleted
}

model WorkspaceProfile {
  id String @id

  status WorkspaceProfileStatus @default(active)

  name  String
  email String

  accountId            String
  userId               String?
  organizationMemberId String?
  consumerId           String?
  consumerProfileId    String?
  instanceConsumerId   String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  globalProfileId String
  globalProfile   GlobalProfile @relation(fields: [globalProfileId], references: [id], onDelete: Cascade)

  ownerOid Int
  owner    Cell @relation(fields: [ownerOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum WorkspaceInviteStatus {
  pending
  accepted
  rejected
  deleted
}

model WorkspaceInvite {
  id String @id

  status WorkspaceInviteStatus @default(pending)

  email String

  accountId String

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  globalProfileId String
  globalProfile   GlobalProfile @relation(fields: [globalProfileId], references: [id], onDelete: Cascade)

  consumerInviteId     String? @unique
  organizationInviteId String? @unique

  ownerOid Int
  owner    Cell @relation(fields: [ownerOid], references: [oid])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  expiresAt DateTime

  @@unique([workspaceId, globalProfileId])
  @@index([accountId])
  @@index([workspaceId])
  @@index([globalProfileId])
}
