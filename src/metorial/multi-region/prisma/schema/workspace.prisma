enum WorkspaceType {
  organization
  portal
}

enum WorkspaceStatus {
  active
  archived
  deleted
}

model Workspace {
  id String @id

  type   WorkspaceType
  status WorkspaceStatus

  name String

  accountId      String
  portalId       String?
  organizationId String?

  ownerOid Int
  owner    Cell @relation(fields: [ownerOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  profiles WorkspaceProfile[]
}

enum WorkspaceProfileStatus {
  active
  deleted
}

model WorkspaceProfile {
  id String @id

  status WorkspaceProfileStatus @default(active)

  name  String
  email String

  accountId            String
  userId               String?
  organizationMemberId String?
  consumerId           String?
  consumerProfileId    String?
  instanceConsumerId   String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  globalProfileId String
  globalProfile   GlobalProfile @relation(fields: [globalProfileId], references: [id], onDelete: Cascade)

  ownerOid Int
  owner    Cell @relation(fields: [ownerOid], references: [oid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
