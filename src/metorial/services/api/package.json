{
  "name": "@metorial/app-api",
  "version": "1.0.0",
  "author": "Tobias Herber",
  "license": "FSL-1.1",
  "main": "src/index.ts",
  "scripts": {
    "oss:server:build": "ncc build ./src/server.ts -o ./dist --source-map --external bun:sqlite",
    "oss:server:start": "bun ./dist/index.js",
    "dev": "bun \"$(ROOT=$(git rev-parse --show-toplevel); if [ -f \"$ROOT/scripts/dev-tools/src/cli.ts\" ]; then echo \"$ROOT/scripts/dev-tools/src/cli.ts\"; else echo \"$ROOT/oss/scripts/dev-tools/src/cli.ts\"; fi)\" watch-bun ./src/server.ts"
  },
  "dependencies": {
    "@metorial/api-auth": "1.0.0",
    "@metorial/api-connection": "1.0.0",
    "@metorial/api-core": "1.0.0",
    "@metorial/api-custom-portal": "1.0.0",
    "@metorial/api-files": "1.0.0",
    "@lowerdeck/api-mux": "workspace:2.0.0",
    "@metorial/auth": "1.0.0",
    "@metorial/logging": "1.0.0",
    "@metorial/module-access": "1.0.0",
    "@metorial/module-cargo-sync": "1.0.0",
    "@metorial/module-email": "1.0.0",
    "@metorial/module-event": "1.0.0",
    "@metorial/module-file": "1.0.0",
    "@metorial/module-machine-access": "1.0.0",
    "@metorial/module-organization": "1.0.0",
    "@metorial/module-usage": "1.0.0",
    "@metorial/module-user": "1.0.0",
    "@metorial/queue": "1.0.0",
    "@vercel/ncc": "^0.38.4"
  },
  "devDependencies": {
    "@metorial/tsconfig": "^1.0.0",
    "typescript": "5.8.2",
    "vitest": "^3.1.2"
  }
}
