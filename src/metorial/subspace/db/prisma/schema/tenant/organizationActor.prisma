enum OrganizationActorType {
  member
  machine_access
  system
  oauth_application
  agent
}

model OrganizationActor {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  type     OrganizationActorType
  isSystem Boolean?

  email String?
  name  String

  /// [EntityImage]
  image Json

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  member            OrganizationMember?
  consumers         Consumer[]
  instanceConsumers InstanceConsumer[]
  consumerProfiles  ConsumerProfile[]

  @@index([organizationOid])
}
