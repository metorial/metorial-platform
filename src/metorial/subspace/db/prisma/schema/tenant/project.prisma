enum ProjectStatus {
  active
  deleted
}

model Project {
  oid BigInt @id @default(autoincrement())
  id  String @unique

  status ProjectStatus

  slug String @unique
  name String

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  instances Instance[]

  agents                                     Agent[]
  agentClients                               AgentClient[]
  brands                                     Brand[]
  callbacks                                  Callback[]
  callbackDestinations                       CallbackDestination[]
  codeBuckets                                CodeBucket[]
  customProviders                            CustomProvider[]
  customProviderCommits                      CustomProviderCommit[]
  customProviderDeployments                  CustomProviderDeployment[]
  customProviderEnvironments                 CustomProviderEnvironment[]
  customProviderVersions                     CustomProviderVersion[]
  enclaves                                   Enclave[]
  enclaveEnvironments                        EnclaveEnvironment[]
  enclaveIngressNetworkLogs                  EnclaveIngressNetworkLog[]
  environments                               Environment[]
  environmentProviders                       EnvironmentProvider[]
  ephemeralManagedSessions                   EphemeralManagedSession[]
  firewalls                                  Firewall[]
  firewallBindings                           FirewallBinding[]
  identities                                 Identity[]
  identityActors                             IdentityActor[]
  identityDelegations                        IdentityDelegation[]
  identityDelegationConfigs                  IdentityDelegationConfig[]
  identityDelegationRequests                 IdentityDelegationRequest[]
  integrations                               Integration[]
  integrationInstances                       IntegrationInstance[]
  integrationInstanceGroups                  IntegrationInstanceGroup[]
  integrationInstanceGroupProviders          IntegrationInstanceGroupProvider[]
  integrationInstanceGroupSources            IntegrationInstanceGroupSource[]
  integrationInstanceProviders               IntegrationInstanceProvider[]
  integrationProviders                       IntegrationProvider[]
  integrationSetupSessions                   IntegrationSetupSession[]
  managedProviderAuthCredentialsBackings     ManagedProviderAuthCredentialsBacking[]
  monitors                                   Monitor[]
  monitorAlerts                              MonitorAlert[]
  networks                                   Network[]
  networkPolicies                            NetworkPolicy[]
  protoGuardAlerts                           ProtoGuardAlert[]
  protoGuardRuns                             ProtoGuardRun[]
  protoGuardFilterSettings                   ProtoGuardTenantFilterSetting[]
  protoGuardSettings                         ProtoGuardTenantSetting[]
  providerAuthConfigs                        ProviderAuthConfig[]
  providerAuthConfigErrorGlobals             ProviderAuthConfigErrorGlobal[]
  providerAuthConfigErrors                   ProviderAuthConfigError[]
  providerAuthConfigEvents                   ProviderAuthConfigEvent[]
  providerAuthCredentials                    ProviderAuthCredentials[]
  providerAuthExports                        ProviderAuthExport[]
  providerAuthImports                        ProviderAuthImport[]
  providerConfigs                            ProviderConfig[]
  providerConfigVaults                       ProviderConfigVault[]
  providerDeployments                        ProviderDeployment[]
  providerDeploymentConfigPairs              ProviderDeploymentConfigPair[]
  providerEnvironments                       ProviderEnvironment[]
  providerListingGroups                      ProviderListingGroup[]
  providerOAuthSetups                        ProviderOAuthSetup[]
  providerRuns                               ProviderRun[]
  providerRunUsageRecords                    ProviderRunUsageRecord[]
  providerSetupSessions                      ProviderSetupSession[]
  providerSpecificationChangeNotifications   ProviderSpecificationChangeNotification[]
  providerUses                               ProviderUse[]
  publishers                                 Publisher[]
  scmRepos                                   ScmRepo[]
  scmRepoPushes                              ScmRepoPush[]
  serverInstanceConfigurations               ServerInstanceConfiguration[]
  sessions                                   Session[]
  sessionConnections                         SessionConnection[]
  sessionErrors                              SessionError[]
  sessionErrorGroups                         SessionErrorGroup[]
  sessionEvents                              SessionEvent[]
  sessionMessages                            SessionMessage[]
  sessionParticipants                        SessionParticipant[]
  sessionProviders                           SessionProvider[]
  sessionTemplates                           SessionTemplate[]
  sessionTemplateProviders                   SessionTemplateProvider[]
  sessionUsageRecords                        SessionUsageRecord[]
  sessionWarnings                            SessionWarning[]
  shuttleAuthConfigs                         ShuttleAuthConfig[]
  shuttleCustomServers                       ShuttleCustomServer[]
  shuttleCustomServerDeployments             ShuttleCustomServerDeployment[]
  shuttleOAuthCredentials                    ShuttleOAuthCredentials[]
  shuttleOAuthSetups                         ShuttleOAuthSetup[]
