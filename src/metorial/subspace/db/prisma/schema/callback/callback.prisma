enum CallbackDestinationStatus {
  active
  archived
  deleted
}

model CallbackDestination {
  oid BigInt @id
  id  String @unique

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  status CallbackDestinationStatus

  name        String
  description String?
  metadata    Json?

  url    String
  method String

  signalEventDestinationId  String?
  lastSignalSyncedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  callbackDestinationLinks CallbackDestinationLink[]

  @@index([tenantOid, solutionOid, status])
}

enum CallbackStatus {
  active
  archived
  deleted
}

enum CallbackMode {
  manual
}

model Callback {
  oid BigInt @id
  id  String @unique

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  providerDeploymentOid BigInt
  providerDeployment    ProviderDeployment @relation(fields: [providerDeploymentOid], references: [oid], onDelete: Cascade)

  status        CallbackStatus
  mode          CallbackMode
  isCallbacksV2 Boolean        @default(false)

  name                        String
  description                 String?
  metadata                    Json?
  pollIntervalSecondsOverride Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?

  callbackProviderTriggers      CallbackProviderTrigger[]
  callbackDestinationLinks      CallbackDestinationLink[]
  callbackInstances             CallbackInstance[]
  securityAuditRecords          CallbackSecurityAuditRecord[]

  @@index([tenantOid, environmentOid, solutionOid, status])
  @@index([providerDeploymentOid, status])
}

model CallbackProviderTrigger {
  oid BigInt @id
  id  String @unique

  callbackOid BigInt
  callback    Callback @relation(fields: [callbackOid], references: [oid], onDelete: Cascade)

  providerTriggerOid BigInt
  providerTrigger    ProviderTrigger @relation(fields: [providerTriggerOid], references: [oid])

  eventTypes String[]

  createdAt DateTime @default(now())

  @@unique([callbackOid, providerTriggerOid])
  @@index([callbackOid])
}

model CallbackDestinationLink {
  oid BigInt @id

  callbackOid BigInt
  callback    Callback @relation(fields: [callbackOid], references: [oid], onDelete: Cascade)

  callbackDestinationOid BigInt
  callbackDestination    CallbackDestination @relation(fields: [callbackDestinationOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([callbackOid, callbackDestinationOid])
}

enum CallbackInstanceStatus {
  attached
  detached
}

enum CallbackInstanceRegistrationStatus {
  pending
  registering
  registered
  renewing
  failed
  unregistering
  unregistered
}

model CallbackInstance {
  oid BigInt @id
  id  String @unique

  callbackOid BigInt
  callback    Callback @relation(fields: [callbackOid], references: [oid], onDelete: Cascade)

  isParentDeleted Boolean @default(false)

  providerDeploymentConfigPairOid BigInt
  providerDeploymentConfigPair    ProviderDeploymentConfigPair @relation(fields: [providerDeploymentConfigPairOid], references: [oid], onDelete: Cascade)

  status                               CallbackInstanceStatus
  registrationStatus                   CallbackInstanceRegistrationStatus
  registrationGeneration               Int                                @default(0)
  registrationTransitionVersion        Int                                @default(0)
  registrationErrorCode                String?
  registrationErrorMessage             String?
  registrationErrorMetadata            Json?
  registrationErrorAt                  DateTime?
  registrationPublicSnapshot           Json?
  registrationMirrorVersion            Int                                @default(0)
  registrationReceiverAuthorityVersion Int                                @default(0)
  slateTriggerReceiverId               String?
  lastSyncErrorCode                    String?
  lastSyncErrorMessage                 String?
  lastSyncedAt                         DateTime?
  lastRegistrationSyncErrorCode        String?
  lastRegistrationSyncErrorMessage     String?
  lastRegistrationSyncErrorAt          DateTime?

  verificationMechanism String?
  verificationSpecHash  String?

  provisionedTenantApps          ProvisionedTenantApp[]
  securityAuditRecords           CallbackSecurityAuditRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([callbackOid, status])
  @@index([providerDeploymentConfigPairOid, status])
  @@unique([callbackOid, providerDeploymentConfigPairOid], map: "sub_callback_instance_pair_key")
}

enum CallbackSecurityAuditAction {
  secret_created
  secret_imported
  secret_projected
  secret_rotated
  secret_revoked
  secret_issuance_receipt_issued
  secret_issuance_receipt_consumed
  secret_issuance_receipt_denied
}

/// Immutable OSS-side link to the authoritative Hub secret audit. Application
/// services expose append/get only; there is deliberately no update/delete path.
model CallbackSecurityAuditRecord {
  oid BigInt @id
  id  String @unique(map: "sub_callback_security_audit_id_key")

  tenantOid BigInt?
  tenant    Tenant? @relation(fields: [tenantOid], references: [oid], onDelete: SetNull, map: "sub_callback_security_audit_tenant_fk")

  callbackOid BigInt?
  callback    Callback? @relation(fields: [callbackOid], references: [oid], onDelete: SetNull, map: "sub_callback_security_audit_callback_fk")

  callbackInstanceOid BigInt?
  callbackInstance    CallbackInstance? @relation(fields: [callbackInstanceOid], references: [oid], onDelete: SetNull, map: "sub_callback_security_audit_instance_fk")

  hubReceiverId        String
  hubAuditCorrelationId String @unique(map: "sub_callback_security_audit_correlation_key")
  tenantIdSnapshot     String
  callbackIdSnapshot   String
  callbackInstanceIdSnapshot String
  receiverAuthorityVersionSnapshot Int
  authorityCommittedAt DateTime
  action               CallbackSecurityAuditAction
  actorId              String
  requestId            String
  requestIp            String?
  requestUserAgent     String?
  metadata             Json
  createdAt            DateTime @default(now())

  outbox CallbackSecurityAuditOutbox?

  @@index([tenantOid, callbackInstanceOid, createdAt], map: "sub_callback_security_audit_owner_idx")
}

/// Transactional outbox committed with CallbackSecurityAuditRecord. Consumers
/// may publish it to an optional enterprise listener without coupling OSS to it.
model CallbackSecurityAuditOutbox {
  oid BigInt @id
  id  String @unique(map: "sub_callback_security_outbox_id_key")

  auditRecordOid BigInt @unique(map: "sub_callback_security_outbox_audit_key")
  auditRecord    CallbackSecurityAuditRecord @relation(fields: [auditRecordOid], references: [oid], onDelete: Cascade, map: "sub_callback_security_outbox_audit_fk")

  hubAuditCorrelationId String @unique(map: "sub_callback_security_outbox_correlation_key")
  action                CallbackSecurityAuditAction
  payload               Json
  createdAt             DateTime @default(now())
  publishedAt           DateTime?

  @@index([publishedAt, createdAt], map: "sub_callback_security_outbox_pending_idx")
}
