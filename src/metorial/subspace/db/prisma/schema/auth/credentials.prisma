enum ProviderAuthCredentialsStatus {
  active
  archived
  deleted
}

enum ProviderAuthCredentialsType {
  oauth
}

enum ProviderAuthCredentialsOrigin {
  tenant_created
  managed_public
  managed_backing
}

enum ManagedProviderAuthCredentialsStatus {
  active
  archived
}

model ProviderAuthCredentials {
  oid BigInt @id
  id  String @unique

  type   ProviderAuthCredentialsType
  status ProviderAuthCredentialsStatus
  origin ProviderAuthCredentialsOrigin @default(tenant_created)

  isEphemeral        Boolean
  isDefault          Boolean
  isAutoRegistration Boolean

  name            String?
  description     String?
  metadata        Json?
  privateMetadata Json?

  /// [ProviderAuthScopes]
  scopes Json @default("[]")

  needsScopeSync Boolean @default(true)

  tenantOid BigInt?
  tenant    Tenant? @relation(fields: [tenantOid], references: [oid])

  environmentOid BigInt?
  environment    Environment? @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  solutionOid Int?
  solution    Solution? @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  providerOid BigInt
  provider    Provider @relation(fields: [providerOid], references: [oid])

  backendOid BigInt
  backend    Backend @relation(fields: [backendOid], references: [oid])

  slateCredentialsOid BigInt?                @unique
  slateCredentials    SlateOAuthCredentials? @relation(fields: [slateCredentialsOid], references: [oid])

  shuttleCredentialsOid BigInt?                  @unique
  shuttleCredentials    ShuttleOAuthCredentials? @relation(fields: [shuttleCredentialsOid], references: [oid])

  managedCredentialsOid BigInt?                         @unique
  managedCredentials    ManagedProviderAuthCredentials? @relation("ManagedProviderAuthCredentialsPublic", fields: [managedCredentialsOid], references: [oid])

  managedCredentialsBacking        ManagedProviderAuthCredentialsBacking?        @relation("ManagedProviderAuthCredentialsBackingCredential")
  managedCredentialsBackingSecrets ManagedProviderAuthCredentialsBackingSecret[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?

  providerOAuthSetups         ProviderOAuthSetup[]
  providerSetupSessions       ProviderSetupSession[]
  providerAuthConfigVersions  ProviderAuthConfigVersion[]
  providerAuthConfigs         ProviderAuthConfig[]
  authConfigEvents            ProviderAuthConfigEvent[]
  authConfigErrors            ProviderAuthConfigError[]
  integrationProviderVersions IntegrationProviderVersion[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([isDefault])
  @@index([isEphemeral])
  @@index([origin])
  @@index([status])
  @@index([archivedAt])
  @@index([status, archivedAt])
  @@index([type])
  @@index([needsScopeSync])
}

model ManagedProviderAuthCredentials {
  oid BigInt @id
  id  String @unique

  status ManagedProviderAuthCredentialsStatus

  name        String?
  description String?
  metadata    Json?

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  initialProviderAuthMethodOid BigInt             @map("providerAuthMethodOid")
  initialProviderAuthMethod    ProviderAuthMethod @relation(fields: [initialProviderAuthMethodOid], references: [oid])

  providerOid BigInt?
  provider    Provider? @relation(fields: [providerOid], references: [oid])

  providerAuthMethodGlobalOid BigInt?
  providerAuthMethodGlobal    ProviderAuthMethodGlobal? @relation(fields: [providerAuthMethodGlobalOid], references: [oid])

  oauthClientId     String
  oauthClientSecret String

  /// [ProviderAuthScopes]
  oauthScopes Json @default("[]")

  providerAuthCredentials ProviderAuthCredentials?                      @relation("ManagedProviderAuthCredentialsPublic")
  backings                ManagedProviderAuthCredentialsBacking[]
  secrets                 ManagedProviderAuthCredentialSecret[]
  backingSecrets          ManagedProviderAuthCredentialsBackingSecret[] @relation("ManagedProviderAuthCredentialsBackingSecretOwner")
  provisionedTenantApps   ProvisionedTenantApp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
}

enum ProvisionedTenantAppCredentialOwnerType {
  managed
  byo
}

enum ProvisionedAppProjectionEntityKind {
  route
  binding
}

enum ProvisionedAppProjectionOutboxStatus {
  pending
  delivering
  delivered
}

/// Authoritative app-scoped parent. routeIdentifier is a public selector and is
/// deliberately distinct from both opaque secret identifiers.
model ProvisionedVendorAppRoute {
  oid                        BigInt   @id
  id                         String   @unique
  vendor                     String
  purpose                    String
  routeIdentifier            String   @unique
  generation                 Int
  credentialOwnerRef         String
  routeSecretId              String
  routeSecretVersion         Int
  vendorVerificationSecretId String
  vendorVerificationVersion  Int
  status                     String
  projectionDigest           String
  expiresAt                  DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @default(now()) @updatedAt
  deletedAt                  DateTime?

  tenantApps ProvisionedTenantApp[]

  @@index([vendor, purpose, status], map: "sub_provisioned_route_vendor_status_idx")
  @@index([status, expiresAt], map: "sub_provisioned_route_expiry_idx")
}

/// Tenant/receiver/external-installation binding. Hub identities are copied
/// cross-database authority fields, never Prisma relations.
model ProvisionedTenantApp {
  oid BigInt @id
  id  String @unique

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  callbackInstanceOid BigInt
  callbackInstance    CallbackInstance @relation(fields: [callbackInstanceOid], references: [oid], onDelete: Cascade)

  vendorAppRouteOid BigInt
  vendorAppRoute    ProvisionedVendorAppRoute @relation(fields: [vendorAppRouteOid], references: [oid], onDelete: Restrict)

  hubReceiverId         String
  hubReceiverGeneration Int
  hubReceiverTriggerId  String
  triggerActionId       String
  triggerSpecHash       String

  vendor                 String
  purpose                String
  externalAppId          String?
  externalAccountId      String?
  externalInstallationId String?
  externalOwnershipKey   String? @unique(map: "sub_provisioned_tenant_app_external_owner_key")
  retainedExternalOwnershipKey String?
  ownerIdentity          String?

  credentialOwnerType   ProvisionedTenantAppCredentialOwnerType
  managedCredentialsOid BigInt?
  managedCredentials    ManagedProviderAuthCredentials? @relation(fields: [managedCredentialsOid], references: [oid], onDelete: Restrict)
  credentialOwnerRef    String
  credentialSecretId    String?
  credentialSecretPurpose String @default("vendor_verification")
  credentialVersion     Int

  generation       Int
  status           String
  projectionDigest String
  correlationId    String?
  expiresAt        DateTime?

  githubManifestStateHash      String?
  githubManifestStateExpiresAt DateTime?
  githubManifestCompletedAt    DateTime?
  githubInstallationCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([managedCredentialsOid, tenantOid, callbackInstanceOid, purpose], map: "sub_provisioned_tenant_app_managed_idx")
  @@index([vendorAppRouteOid, externalInstallationId], map: "sub_provisioned_tenant_app_installation_idx")
  @@index([tenantOid, callbackInstanceOid, hubReceiverId, hubReceiverGeneration], map: "sub_provisioned_tenant_app_receiver_idx")
  @@index([vendor, externalInstallationId], map: "sub_provisioned_tenant_app_vendor_installation_idx")
  @@index([vendorAppRouteOid, retainedExternalOwnershipKey], map: "sub_provisioned_tenant_app_retained_owner_idx")
  @@index([status, expiresAt], map: "sub_provisioned_tenant_app_status_idx")
}

/// Transactional projection outbox. payload is the canonical, credential-free
/// projection snapshot committed with the authoritative route/binding mutation.
model ProvisionedAppProjectionOutbox {
  oid BigInt @id
  id  String @unique

  entityKind      ProvisionedAppProjectionEntityKind
  entityId        String
  generation      Int
  projectionDigest String
  correlationId  String
  idempotencyKey String @unique
  tombstone       Boolean @default(false)
  payload         Json

  status          ProvisionedAppProjectionOutboxStatus @default(pending)
  attemptCount    Int @default(0)
  deliveryToken   String?
  deliveryLeaseExpiresAt DateTime?
  lastAttemptAt   DateTime?
  lastErrorCode   String?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([entityKind, entityId, generation], map: "sub_provisioned_projection_generation_key")
  @@index([status, deliveryLeaseExpiresAt, createdAt], map: "sub_provisioned_projection_pending_idx")
}

model ManagedProviderAuthCredentialsBacking {
  oid BigInt @id

  managedCredentialsOid BigInt
  managedCredentials    ManagedProviderAuthCredentials @relation(fields: [managedCredentialsOid], references: [oid], onDelete: Cascade)

  providerAuthCredentialsOid BigInt                  @unique
  providerAuthCredentials    ProviderAuthCredentials @relation("ManagedProviderAuthCredentialsBackingCredential", fields: [providerAuthCredentialsOid], references: [oid], onDelete: Cascade)

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  secrets ManagedProviderAuthCredentialsBackingSecret[]

  @@unique([managedCredentialsOid, tenantOid])
}

model ManagedProviderAuthCredentialSecret {
  oid BigInt @id
  id  String @unique(map: "sub_managed_secret_source_id_key")

  managedCredentialsOid BigInt
  managedCredentials    ManagedProviderAuthCredentials @relation(fields: [managedCredentialsOid], references: [oid], onDelete: Cascade, map: "sub_managed_secret_source_owner_fk")

  purpose              String
  encryptedValue       String
  secretVersion        Int
  encryptionKeyVersion Int
  aadVersion           Int
  status               String
  validFrom            DateTime
  validUntil           DateTime?
  createdAt            DateTime  @default(now())
  rotatedAt            DateTime?
  revokedAt            DateTime?

  backingProjections ManagedProviderAuthCredentialsBackingSecret[] @relation("ManagedProviderAuthCredentialSecretBackings")

  @@unique([managedCredentialsOid, purpose, secretVersion], map: "sub_managed_secret_source_owner_version_key")
  @@unique([managedCredentialsOid, id, secretVersion], map: "sub_managed_secret_source_owner_id_version_key")
  @@index([managedCredentialsOid, status, validUntil], map: "sub_managed_secret_source_status_idx")
}

model ManagedProviderAuthCredentialsBackingSecret {
  oid BigInt @id
  id  String

  managedCredentialsBackingOid BigInt
  managedCredentialsBacking    ManagedProviderAuthCredentialsBacking @relation(fields: [managedCredentialsBackingOid], references: [oid], onDelete: Cascade, map: "sub_managed_secret_backing_owner_fk")

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade, map: "sub_managed_secret_backing_tenant_fk")

  providerAuthCredentialsOid BigInt
  providerAuthCredentials    ProviderAuthCredentials @relation(fields: [providerAuthCredentialsOid], references: [oid], onDelete: Cascade, map: "sub_managed_secret_backing_credential_fk")

  managedCredentialsOid BigInt
  managedCredentials    ManagedProviderAuthCredentials @relation("ManagedProviderAuthCredentialsBackingSecretOwner", fields: [managedCredentialsOid], references: [oid], onDelete: Cascade, map: "sub_managed_secret_backing_source_owner_fk")

  sourceSecretId       String
  sourceSecretVersion  Int
  sourceSecret         ManagedProviderAuthCredentialSecret @relation("ManagedProviderAuthCredentialSecretBackings", fields: [managedCredentialsOid, sourceSecretId, sourceSecretVersion], references: [managedCredentialsOid, id, secretVersion], onDelete: NoAction, map: "sub_managed_secret_backing_source_fk")
  purpose              String
  encryptedValue       String
  secretVersion        Int
  encryptionKeyVersion Int
  aadVersion           Int
  status               String
  validFrom            DateTime
  validUntil           DateTime?
  createdAt            DateTime                            @default(now())
  rotatedAt            DateTime?
  revokedAt            DateTime?

  @@unique([managedCredentialsBackingOid, purpose, secretVersion], map: "sub_managed_secret_backing_owner_version_key")
  @@unique([managedCredentialsBackingOid, id, secretVersion], map: "sub_managed_secret_backing_owner_id_version_key")
  @@index([tenantOid, providerAuthCredentialsOid], map: "sub_managed_secret_backing_tenant_credential_idx")
  @@index([sourceSecretId, sourceSecretVersion], map: "sub_managed_secret_backing_source_idx")
  @@index([managedCredentialsBackingOid, status, validUntil], map: "sub_managed_secret_backing_status_idx")
  @@index([managedCredentialsOid, sourceSecretId, sourceSecretVersion], map: "sub_managed_secret_backing_source_owner_idx")
}
