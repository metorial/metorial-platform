enum SessionStatus {
  active
  archived
  deleted
}

model Session {
  oid BigInt @id
  id  String @unique

  status     SessionStatus
  archivedAt DateTime?

  isEphemeral Boolean
  isInternal  Boolean @default(false)

  adapterGlobalOid BigInt?
  adapterGlobal    ProviderAdapterGlobal? @relation(fields: [adapterGlobalOid], references: [oid])

  connectionState SessionConnectionState @default(disconnected)
  isStarted       Boolean                @default(false)
  hasErrors       Boolean                @default(false)
  hasWarnings     Boolean                @default(false)

  name            String?
  description     String?
  metadata        Json?
  privateMetadata Json?

  sharedProviderName        String?
  sharedProviderDescription String?

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  environmentOid BigInt
  environment    Environment @relation(fields: [environmentOid], references: [oid], onDelete: Cascade)

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  solutionOid Int
  solution    Solution @relation(fields: [solutionOid], references: [oid], onDelete: Cascade)

  identityActorOid BigInt?
  identityActor    IdentityActor? @relation(fields: [identityActorOid], references: [oid], onDelete: SetNull)

  identityOid BigInt?
  identity    Identity? @relation(fields: [identityOid], references: [oid], onDelete: SetNull)

  ephemeralManagedSessionOid BigInt?
  ephemeralManagedSession    EphemeralManagedSession? @relation("EphemeralManagedSessionSessions", fields: [ephemeralManagedSessionOid], references: [oid])

  totalProductiveClientMessageCount   Int @default(0)
  totalProductiveProviderMessageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  lastConnectionCreatedAt DateTime?
  lastMessageAt           DateTime?
  lastActiveAt            DateTime?

  providers                         SessionProvider[]
  providerRuns                      ProviderRun[]
  sessionMessages                   SessionMessage[]
  sessionEvents                     SessionEvent[]
  connections                       SessionConnection[]
  sessionErrors                     SessionError[]
  sessionProviderInstances          SessionProviderInstance[]
  toolCalls                         ToolCall[]
  sessionWarnings                   SessionWarning[]
  sessionUsageRecords               SessionUsageRecord[]
  protoGuardRuns                    ProtoGuardRun[]
  protoGuardAlerts                  ProtoGuardAlert[]
  currentForEphemeralManagedSession EphemeralManagedSession?  @relation("EphemeralManagedSessionCurrentSession")

  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastActiveAt])
  @@index([connectionState])
  @@index([status])
  @@index([archivedAt])
  @@index([status, archivedAt])
  @@index([identityActorOid])
  @@index([identityOid])
  @@index([isEphemeral])
  @@index([isInternal])
  @@index([adapterGlobalOid])
  @@index([tenantOid, environmentOid, isInternal, createdAt])
  @@index([ephemeralManagedSessionOid])
  @@index([projectOid])
  @@index([instanceOid])
}
