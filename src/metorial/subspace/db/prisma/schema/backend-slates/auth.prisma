model SlateOAuthCredentials {
  oid BigInt @id
  id  String @unique

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  createdAt DateTime @default(now())

  providerAuthCredentials    ProviderAuthCredentials[]
  provisionedVendorAppRoutes ProvisionedVendorAppRoute[]

  @@index([projectOid])
}

model SlateOAuthSetup {
  oid BigInt @id
  id  String @unique

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  createdAt DateTime @default(now())

  providerOAuthSetups ProviderOAuthSetup[]

  @@index([projectOid])
}

model SlateAuthConfig {
  oid BigInt @id
  id  String @unique

  slateOid BigInt
  slate    Slate  @relation(fields: [slateOid], references: [oid])

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid])

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  providerAuthConfigUpdateOid BigInt?
  providerAuthConfigUpdate    ProviderAuthConfigUpdate? @relation(fields: [providerAuthConfigUpdateOid], references: [oid])

  providerAuthConfigVersion ProviderAuthConfigVersion?

  createdAt DateTime @default(now())

  @@index([projectOid])
}
