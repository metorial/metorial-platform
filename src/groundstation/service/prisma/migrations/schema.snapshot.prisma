generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

generator json {
  provider = "prisma-json-types-generator"
}

model Organization {
  oid BigInt @id
  id  String @unique

  ref  String  @unique
  name String?

  hashKeyVersion    Int @default(1)
  contentKeyVersion Int @default(1)

  /// [OrganizationSettings]
  settings Json @default("{}")

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projects           Project[]
  instances          Instance[]
  ingestTokens       IngestToken[]
  ingestSources      IngestSource[]
  entityKinds        EntityKind[]
  entities           Entity[]
  entityIdentifiers  EntityIdentifier[]
  entityLinks        EntityLink[]
  pendingMemberships PendingMembership[]
  attributionRules   AttributionRule[]
  classifierLabels   ClassifierLabel[]
  mergeSuggestions   MergeSuggestion[]
  rebuildRuns        RebuildRun[]
  priceOverrides     PriceOverride[]
}

model Project {
  oid BigInt @id
  id  String @unique

  ref  String  @unique
  name String?

  recordRetentionDays  Int @default(90)
  contentRetentionDays Int @default(30)
  usageRetentionDays   Int @default(400)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  instances        Instance[]
  scopedEntities   Entity[]
  attributionRules AttributionRule[]
  rebuildRuns      RebuildRun[]
  priceOverrides   PriceOverride[]

  @@index([organizationOid])
}

model Instance {
  oid BigInt @id
  id  String @unique

  ref  String  @unique
  name String?

  skewBoundSeconds   Int  @default(86400)
  backfillMaxAgeDays Int?

  recordRetentionDays  Int @default(90)
  contentRetentionDays Int @default(30)
  usageRetentionDays   Int @default(400)

  /// [InstanceSettings]
  settings Json @default("{}")

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  projectOid BigInt
  project    Project @relation(fields: [projectOid], references: [oid])

  ingestTokens     IngestToken[]
  ingestSources    IngestSource[]
  scopedEntities   Entity[]
  attributionRules AttributionRule[]
  rebuildRuns      RebuildRun[]

  @@index([organizationOid])
  @@index([projectOid])
}

enum IngestDeviceMode {
  bound
  ephemeral
}

model IngestToken {
  oid BigInt @id
  id  String @unique

  prefix     String @unique
  secretHash String

  name String

  /// [ContentPolicy]
  contentPolicy Json

  /// [IngestTokenLimits]
  limits Json

  allowedClients  String[]
  allowedChannels String[]

  userRef    String
  deviceRef  String?
  deviceMode IngestDeviceMode @default(bound)
  agentRef   String?

  /// [IngestTags]
  tags Json @default("[]")

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  userEntityOid BigInt
  userEntity    Entity @relation("IngestTokenUser", fields: [userEntityOid], references: [oid])

  deviceEntityOid BigInt?
  deviceEntity    Entity? @relation("IngestTokenDevice", fields: [deviceEntityOid], references: [oid])

  agentEntityOid BigInt?
  agentEntity    Entity? @relation("IngestTokenAgent", fields: [agentEntityOid], references: [oid])

  @@index([organizationOid])
  @@index([instanceOid])
}

model IngestSource {
  oid BigInt @id
  id  String @unique

  prefix     String @unique
  secretHash String

  name   String
  family String

  /// [ContentPolicy]
  contentPolicy Json

  /// [IngestTokenLimits]
  limits Json

  allowedChannels String[]

  newUserLimitPerDay Int @default(50)

  /// [IngestTags]
  tags Json @default("[]")

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  instanceOid BigInt
  instance    Instance @relation(fields: [instanceOid], references: [oid])

  @@index([organizationOid])
  @@index([instanceOid])
}

enum EntityCardinality {
  single
  multi
}

model EntityKind {
  oid BigInt @id
  id  String @unique

  key  String
  name String

  cardinality EntityCardinality @default(single)

  /// [EntityKindAttributes]
  attributes Json @default("{}")

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  @@unique([organizationOid, key])
}

enum EntityStatus {
  managed
  discovered
  merged
  archived
}

model Entity {
  oid BigInt @id
  id  String @unique

  kind   String
  status EntityStatus

  source String?
  ref    String?
  slug   String?

  name String?

  /// [EntityAttributes]
  attributes Json @default("{}")

  needsReview Boolean @default(false)

  mergedIntoOid BigInt?

  firstSeenAt DateTime?
  lastSeenAt  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  scopeProjectOid BigInt?
  scopeProject    Project? @relation(fields: [scopeProjectOid], references: [oid])

  scopeInstanceOid BigInt?
  scopeInstance    Instance? @relation(fields: [scopeInstanceOid], references: [oid])

  identifiers           EntityIdentifier[]
  outgoingLinks         EntityLink[]        @relation("EntityLinkFrom")
  incomingLinks         EntityLink[]        @relation("EntityLinkTo")
  userTokens            IngestToken[]       @relation("IngestTokenUser")
  deviceTokens          IngestToken[]       @relation("IngestTokenDevice")
  agentTokens           IngestToken[]       @relation("IngestTokenAgent")
  pendingMemberships    PendingMembership[]
  attributionRules      AttributionRule[]
  classifierLabels      ClassifierLabel[]
  discoveredSuggestions MergeSuggestion[]   @relation("MergeSuggestionDiscovered")
  managedSuggestions    MergeSuggestion[]   @relation("MergeSuggestionManaged")

  @@unique([organizationOid, kind, source, ref])
  @@unique([organizationOid, kind, slug])
  @@index([organizationOid, kind, status, lastSeenAt])
  @@index([mergedIntoOid])
}

model EntityIdentifier {
  oid BigInt @id
  id  String @unique

  kind  String
  type  String
  value String

  createdAt DateTime @default(now())

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  entityOid BigInt
  entity    Entity @relation(fields: [entityOid], references: [oid])

  @@unique([organizationOid, kind, type, value])
  @@index([entityOid])
}

model EntityLink {
  oid BigInt @id
  id  String @unique

  type   String
  origin String

  weight Float?

  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  fromOid BigInt
  from    Entity @relation("EntityLinkFrom", fields: [fromOid], references: [oid])

  toOid BigInt
  to    Entity @relation("EntityLinkTo", fields: [toOid], references: [oid])

  @@index([organizationOid, type])
  @@index([fromOid, type, validFrom])
  @@index([toOid, type, validFrom])
}

model PendingMembership {
  oid BigInt @id
  id  String @unique

  email  String
  type   String
  weight Float?

  validFrom DateTime
  createdAt DateTime @default(now())

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  targetEntityOid BigInt
  targetEntity    Entity @relation(fields: [targetEntityOid], references: [oid])

  @@unique([organizationOid, email, targetEntityOid, type])
}

enum AttributionRuleEffect {
  assign
  exclude
}

model AttributionRule {
  oid BigInt @id
  id  String @unique

  name String

  effect   AttributionRuleEffect @default(assign)
  priority Int                   @default(0)
  enabled  Boolean               @default(true)

  /// [AttributionRuleMatch]
  match Json

  validFrom  DateTime  @default(now())
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  targetEntityOid BigInt
  targetEntity    Entity @relation(fields: [targetEntityOid], references: [oid])

  scopeProjectOid BigInt?
  scopeProject    Project? @relation(fields: [scopeProjectOid], references: [oid])

  scopeInstanceOid BigInt?
  scopeInstance    Instance? @relation(fields: [scopeInstanceOid], references: [oid])

  @@index([organizationOid, enabled])
}

model ClassifierLabel {
  oid BigInt @id
  id  String @unique

  kind       String
  sessionKey String

  /// [ClassifierFeatures]
  features Json

  createdAt DateTime @default(now())

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  entityOid BigInt
  entity    Entity @relation(fields: [entityOid], references: [oid])

  @@unique([organizationOid, kind, sessionKey])
  @@index([organizationOid, kind, createdAt])
}

enum MergeSuggestionStatus {
  open
  accepted
  dismissed
}

model MergeSuggestion {
  oid BigInt @id
  id  String @unique

  score   Float
  reasons String[]

  status MergeSuggestionStatus @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  discoveredEntityOid BigInt
  discoveredEntity    Entity @relation("MergeSuggestionDiscovered", fields: [discoveredEntityOid], references: [oid])

  managedEntityOid BigInt
  managedEntity    Entity @relation("MergeSuggestionManaged", fields: [managedEntityOid], references: [oid])

  @@unique([discoveredEntityOid, managedEntityOid])
  @@index([organizationOid, status])
}

enum RebuildRunStatus {
  queued
  running
  completed
  failed
  cancelled
}

model RebuildRun {
  oid BigInt @id
  id  String @unique

  layers String[]
  reason String

  /// [RebuildFilter]
  filter Json?

  rangeFrom DateTime
  rangeTo   DateTime

  status RebuildRunStatus @default(queued)
  cursor String?
  error  String?

  processed Int  @default(0)
  total     Int?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  instanceOid BigInt?
  instance    Instance? @relation(fields: [instanceOid], references: [oid])

  @@index([organizationOid, createdAt])
  @@index([status])
}

model KnowledgeSource {
  oid BigInt @id
  id  String @unique

  url String @unique

  etag            String?
  lastFingerprint String?
  lastError       String?

  lastCheckedAt DateTime?
  lastChangedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  snapshots KnowledgeSnapshot[]
}

enum KnowledgeSnapshotStatus {
  current
  superseded
  rejected
}

model KnowledgeSnapshot {
  oid BigInt @id
  id  String @unique

  fingerprint   String
  schemaVersion Int

  status         KnowledgeSnapshotStatus
  rejectedReason String?

  /// [KnowledgeSnapshotCounts]
  counts Json

  /// [KnowledgeSnapshotAnomalies]
  anomalies Json @default("[]")

  archive Bytes?

  generatedAt DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sourceOid BigInt
  source    KnowledgeSource @relation(fields: [sourceOid], references: [oid])

  changes      KnowledgeChange[]
  pricePeriods KnowledgePricePeriod[]

  @@unique([sourceOid, fingerprint])
  @@index([status, generatedAt])
}

model KnowledgeOrganization {
  oid BigInt @id
  id  String @unique

  name   String
  roles  String[]
  status String

  /// [KnowledgeOrganizationData]
  data        Json
  contentHash String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model KnowledgeFamily {
  oid BigInt @id
  id  String @unique

  name          String
  labId         String
  kind          String
  status        String
  latestModelId String?

  /// [KnowledgeFamilyData]
  data        Json
  contentHash String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([labId])
}

model KnowledgeModel {
  oid BigInt @id
  id  String @unique

  name     String
  labId    String
  familyId String?
  kind     String
  status   String

  releaseDate      DateTime? @db.Date
  openWeights      Boolean
  contextTokens    Int?
  capabilities     String[]
  inputModalities  String[]
  outputModalities String[]

  /// [KnowledgeModelData]
  data        Json
  contentHash String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([labId])
  @@index([familyId])
  @@index([kind, status])
}

model KnowledgeRelease {
  oid BigInt @id
  id  String @unique

  modelId String
  date    DateTime @db.Date
  status  String

  /// [KnowledgeReleaseData]
  data        Json
  contentHash String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([modelId])
}

model KnowledgePointer {
  oid BigInt @id
  id  String @unique

  labId    String
  familyId String?

  /// [KnowledgePointerData]
  data        Json
  contentHash String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([labId])
}

model KnowledgeVendor {
  oid BigInt @id
  id  String @unique

  name           String
  organizationId String
  kind           String
  status         String

  /// [KnowledgeVendorData]
  data        Json
  contentHash String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([organizationId])
  @@index([kind])
}

model KnowledgeEndpoint {
  oid BigInt @id
  id  String @unique

  name        String
  vendorId    String
  plan        String
  region      String?
  baseUrlHost String?
  status      String

  /// [KnowledgeEndpointData]
  data        Json
  contentHash String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([vendorId])
  @@index([baseUrlHost])
}

model KnowledgeOffering {
  oid BigInt @id
  id  String @unique

  vendorId      String
  vendorModelId String
  variantKey    String

  name   String
  kind   String
  status String
  free   Boolean

  modelId   String?
  releaseId String?
  pointerId String?

  pricingHash String?

  /// [KnowledgeOfferingData]
  data        Json
  contentHash String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  pricePeriods    KnowledgePricePeriod[] @relation("OfferingPricePeriods")
  openPricePeriod KnowledgePricePeriod?  @relation("OfferingOpenPricePeriod")

  @@index([vendorId, vendorModelId])
  @@index([modelId])
}

model KnowledgeName {
  oid BigInt @id
  id  String @unique

  namespace     String
  raw           String
  key           String
  status        String
  targetModelId String?

  /// [KnowledgeNameData]
  data        Json
  contentHash String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([raw])
  @@index([key])
  @@index([targetModelId])
}

model KnowledgeAgent {
  oid BigInt @id
  id  String @unique

  name       String
  makerId    String
  status     String
  openSource Boolean
  surfaces   String[]

  aliasKeys       String[]
  defaultVendorId String?
  vendorIds       String[]

  /// [KnowledgeAgentData]
  data        Json
  contentHash String

  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([makerId])
}

enum KnowledgeEntity {
  organization
  family
  model
  release
  pointer
  vendor
  endpoint
  offering
  name
  agent
}

enum KnowledgeChangeType {
  added
  changed
  removed
}

model KnowledgeChange {
  oid BigInt @id
  id  String @unique

  entity   KnowledgeEntity
  entityId String
  change   KnowledgeChangeType

  /// [KnowledgeEntityData]
  before Json?

  /// [KnowledgeEntityData]
  after Json?

  createdAt DateTime @default(now())

  snapshotOid BigInt
  snapshot    KnowledgeSnapshot @relation(fields: [snapshotOid], references: [oid])

  @@index([entity, entityId, createdAt])
  @@index([snapshotOid])
  @@index([createdAt])
}

enum KnowledgePriceOrigin {
  bootstrap
  observed
  correction
}

enum KnowledgePriceCloseReason {
  changed
  corrected
}

model KnowledgePricePeriod {
  oid BigInt @id
  id  String @unique

  vendorId String
  modelId  String?

  /// [KnowledgePricing]
  pricing     Json
  pricingHash String

  origin      KnowledgePriceOrigin
  closeReason KnowledgePriceCloseReason?

  correctionReason String?
  correctedBy      String?

  validFrom   DateTime
  validTo     DateTime?
  confirmedAt DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  offeringOid BigInt
  offering    KnowledgeOffering @relation("OfferingPricePeriods", fields: [offeringOid], references: [oid])

  // Set to offeringOid while the period is open and cleared when it closes. Postgres allows many
  // NULLs in a unique column, so this enforces one open period per offering, which Prisma can't
  // express as a partial unique index.
  openOfferingOid BigInt?            @unique
  openOffering    KnowledgeOffering? @relation("OfferingOpenPricePeriod", fields: [openOfferingOid], references: [oid])

  openedBySnapshotOid BigInt?
  openedBySnapshot    KnowledgeSnapshot? @relation(fields: [openedBySnapshotOid], references: [oid])

  @@index([offeringOid, validFrom])
  @@index([modelId, validFrom])
  @@index([vendorId, validFrom])
}

enum PriceOverrideTarget {
  all
  lab
  family
  model
  offering
  vendor
  agent
}

enum PriceOverrideKind {
  multiplier
  rates
  included
}

model PriceOverride {
  oid BigInt @id
  id  String @unique

  name   String
  reason String?

  target   PriceOverrideTarget
  targetId String?
  vendorId String?

  kind       PriceOverrideKind
  multiplier Decimal?          @db.Decimal(12, 6)

  /// [KnowledgePricing]
  rates Json?

  priority  Int     @default(0)
  createdBy String?

  validFrom  DateTime
  validTo    DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organizationOid BigInt
  organization    Organization @relation(fields: [organizationOid], references: [oid])

  projectOid BigInt?
  project    Project? @relation(fields: [projectOid], references: [oid])

  @@index([organizationOid, archivedAt])
  @@index([projectOid])
}
