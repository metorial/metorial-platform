{
  "name": "@metorial/oss",
  "private": true,
  "scripts": {
    "build": "turbo run --ui=stream build",
    "generate:client": "turbo run generate:client && turbo run build",
    "client:generate": "bun run generate:client",
    "client:generate:dashboard": "turbo run generate:client:dashboard",
    "client:generate:consumer": "turbo run generate:client:consumer",
    "dev": "turbo run --concurrency 99 --continue=always dev",
    "test": "turbo run --concurrency=1 --ui=stream test",
    "prisma:generate": "turbo run --ui=stream prisma:generate",
    "prisma:push": "turbo run --ui=stream --concurrency=1 prisma:push --",
    "prepare": "echo prepare",
    "postinstall": "echo postinstall && [ -f \"./vendor/mcp-inspector\" ] && { cd ./vendor/mcp-inspector && npm install; } || { echo \"No vendor dependencies to install.\"; }",
    "preinstall": "[ -f \"../metorial_enterprise_install.sh\" ] && { ../metorial_enterprise_install.sh; } || { [ ! -f \"../metorial_enterprise_install.sh\" ] && echo \"Ignoring enterprise dependencies.\"; }"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.2.15"
  },
  "packageManager": "bun@1.2.15",
  "workspaces": [
    "_clients/metorial-node/*/*",
    "clients/metorial-dashboard",
    "clients/metorial-consumer",
    "scripts/*",
    "vendor-placeholder/*",
    "src/metorial/*",
    "src/metorial/*/*",
    "src/metorial-frontend/*",
    "src/metorial-frontend/*/*",
    "src/lowerdeck/packages/*",
    "src/ares/*",
    "src/ares/*/*",
    "src/ares/*/*/*",
    "src/cargo/*",
    "src/cargo/*/*",
    "src/cargo/*/*/*",
    "src/cargo/*/*/*/*",
    "src/forge/*",
    "src/forge/*/*",
    "src/forge/*/*/*",
    "src/function-bay/*",
    "src/function-bay/*/*",
    "src/function-bay/*/*/*",
    "src/function-bay/*/*/*/*",
    "src/nebula/*",
    "src/nebula/*/*",
    "src/nebula/*/*/*",
    "src/origin/*",
    "src/origin/*/*",
    "src/origin/*/*/*",
    "src/origin/*/*/*/*",
    "src/shuttle/*",
    "src/shuttle/*/*",
    "src/shuttle/*/*/*",
    "src/signal/*",
    "src/signal/*/*",
    "src/signal/*/*/*",
    "src/slates/*",
    "src/slates/*/*",
    "src/slates/*/*/*",
    "src/slates/*/*/*/*",
    "src/subspace/*",
    "src/subspace/*/*",
    "src/subspace/*/*/*",
    "src/subspace/*/*/*/*",
    "src/subspace/*/*/*/*/*",
    "src/synthesis/*",
    "src/synthesis/*/*",
    "src/synthesis/*/*/*",
    "src/voyager/*",
    "src/voyager/*/*",
    "src/voyager/*/*/*",
    "src/relay/*",
    "src/relay/*/*",
    "src/relay/*/*/*"
  ],
  "dependencies": {
    "sade": "^1.8.1",
    "ts-proto": "^2.7.5"
  },
  "overrides": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "fast-xml-parser": "5.7.3",
    "@aws-sdk/client-cognito-identity": "3.1048.0",
