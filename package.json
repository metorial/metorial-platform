{
  "name": "@metorial/oss",
  "private": true,
  "scripts": {
    "build": "bun x nx run-many --target=build --all",
    "generate:client": "bun x nx run-many --target=generate:client --all --parallel=1 && bun x nx run-many --target=build --all",
    "control": "bun run --cwd ./src/tooling/control ./src/cli.ts",
    "client:generate": "bun run generate:client",
    "client:generate:dashboard": "bun x nx run-many --target=generate:client:dashboard --all --parallel=1",
    "client:generate:consumer": "bun x nx run-many --target=generate:client:consumer --all --parallel=1",
    "dev": "bun x nx run-many --target=dev --all --parallel=99",
    "test": "bun x nx run-many --target=test --all --parallel=1",
    "prisma:generate": "bun x nx run-many --target=prisma:generate --all --parallel=1",
    "prisma:push": "bun x nx run-many --target=prisma:push --all --parallel=1",
    "prepare": "echo prepare",
    "postinstall": "echo postinstall && [ -f \"./vendor/mcp-inspector\" ] && { cd ./vendor/mcp-inspector && npm install; } || { echo \"No vendor dependencies to install.\"; }",
    "preinstall": "[ -f \"../metorial_enterprise_install.sh\" ] && { ../metorial_enterprise_install.sh; } || { [ ! -f \"../metorial_enterprise_install.sh\" ] && echo \"Ignoring enterprise dependencies.\"; }"
  },
  "devDependencies": {
    "nx": "^22.7.3",
    "prettier": "^3.5.3",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.2.15"
  },
  "packageManager": "bun@1.2.15",
  "workspaces": [
    "_clients/metorial-node/*/*",
    "clients/metorial-dashboard",
    "clients/metorial-consumer",
    "scripts/*",
    "vendor-placeholder/*",
    "src/frontend/*",
    "src/frontend/*/*",
    "src/backend/*",
    "src/backend/*/*",
    "src/packages/*",
    "src/packages/*/*",
    "src/_shared/*/*",
    "src/systems/*/*",
    "src/systems/_clients/*",
    "src/systems/*/*/*",
    "src/systems/*/*/*/*",
    "src/systems/*/*/*/*/*"
    ,
    "src/tooling/*"
  ],
  "dependencies": {
    "sade": "^1.8.1",
    "ts-proto": "^2.7.5"
  },
  "overrides": {
    "@aws-sdk/client-cognito-identity": "3.1048.0",
    "@aws-sdk/client-dynamodb": "3.1048.0",
    "@aws-sdk/client-sso": "3.1048.0",
    "@aws-sdk/core": "3.974.11",
    "@aws-sdk/credential-providers": "3.1048.0",
    "@aws-sdk/nested-clients": "3.997.9",
    "@aws-sdk/util-dynamodb": "3.996.2"
  }
}
