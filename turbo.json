{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "enterprise:dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:client": {
      "dependsOn": ["^build", "^build:client"],
      "outputs": ["dist/**"]
    },
    "prisma:generate": {
      "outputs": ["prisma/generated/**"]
    },
    "prisma:push": {
      "cache": false,
      "env": ["DATABASE_URL", "PAYMENT_DATABASE_URL", "FEDERATION_CORE_DATABASE_URL"]
    },
    "generate:client": {
      "dependsOn": ["^generate:client"],
      "cache": false,
      "env": ["API_URL"]
    },
    "generate:client:dashboard": {
      "dependsOn": ["^generate:client:dashboard"],
      "cache": false,
      "env": ["API_URL"]
    },
    "generate:client:consumer": {
      "dependsOn": ["^generate:client:consumer"],
      "cache": false,
      "env": ["API_URL"]
    },
    "frontend:build": {
      "dependsOn": ["^build", "^frontend:build"],
      "outputs": ["dist/**", "frontend/*/dist/**"],
      "env": ["SENTRY_AUTH_TOKEN", "METORIAL_ENV", "VITE_*"]
    },
    "_frontend:build": {
      "dependsOn": ["^build", "^_frontend:build"],
      "outputs": ["dist/**"],
      "env": ["METORIAL_ENV", "VITE_*"]
    },
    "admin:build": {
      "dependsOn": ["^build", "^admin:build"],
      "outputs": ["dist/admin/**"],
      "env": ["METORIAL_ENV", "VITE_*"]
    },
    "worker:build": {
      "dependsOn": ["prisma:generate", "^prisma:generate", "^build", "^worker:build"],
      "outputs": ["dist-worker/**"],
      "env": ["METORIAL_ENV"]
    },
    "setup_vscode": {
      "cache": false
    },
    "deploy:only": {
      "env": [
        "SENTRY_AUTH_TOKEN",
        "METORIAL_ENV",
        "VITE_*",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    },
    "deploy": {
      "env": [
        "SENTRY_AUTH_TOKEN",
        "METORIAL_ENV",
        "VITE_*",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    },
    "server:build": {
      "dependsOn": [
        "admin:build",
        "prisma:generate",
        "^prisma:generate",
        "^build",
        "^server:build"
      ],
      "env": ["METORIAL_ENV"],
      "outputs": ["dist/**", "!dist/admin/**"]
    },
    "oss:server:build": {
      "dependsOn": [
        "prisma:generate",
        "^prisma:generate",
        "^build",
        "^server:build",
        "^oss:server:build"
      ],
      "env": ["METORIAL_ENV"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "control:db:generate": {
      "cache": false
    },
    "control:db:push": {
      "cache": false
    }
  }
}
