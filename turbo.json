{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "tui",
  "globalEnv": ["METORIAL_EDITION", "METORIAL_RELEASE_CHANNEL"],
  "tasks": {
    "enterprise:dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!README*",
        "!control/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:client": {
      "dependsOn": ["^build", "^build:client"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!README*",
        "!control/**"
      ],
      "outputs": ["dist/**"]
    },
    "@metorial-platform-systems/function-bay-client#build": {
      "dependsOn": ["^build", "@metorial/function-bay#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "prisma:generate": {
      "dependsOn": ["^prisma:generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!README*",
        "!control/**"
      ],
      "outputs": ["prisma/generated/**"]
    },
    "prisma:push": {
      "cache": false,
      "env": ["DATABASE_URL", "PAYMENT_DATABASE_URL", "FEDERATION_CORE_DATABASE_URL"]
    },
    "generate:client": {
      "dependsOn": ["^generate:client"],
      "cache": false,
      "env": ["API_URL", "INTROSPECTION_SNAPSHOT"]
    },
    "generate:client:dashboard": {
      "dependsOn": ["^generate:client:dashboard"],
      "cache": false,
      "env": ["API_URL", "INTROSPECTION_SNAPSHOT"]
    },
    "generate:client:consumer": {
      "dependsOn": ["^generate:client:consumer"],
      "cache": false,
      "env": ["API_URL", "INTROSPECTION_SNAPSHOT"]
    },
    "frontend:build": {
      "dependsOn": ["^build", "^frontend:build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!README*",
        "!control/**"
      ],
      "outputs": ["dist/**", "frontend/*/dist/**"],
      "env": ["SENTRY_AUTH_TOKEN", "METORIAL_ENV", "VITE_*"]
    },
    "_frontend:build": {
      "dependsOn": ["^build", "^_frontend:build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!README*",
        "!control/**"
      ],
      "outputs": ["dist/**"],
      "env": ["METORIAL_ENV", "VITE_*"]
    },
    "admin:build": {
      "dependsOn": ["^build", "^admin:build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!README*",
        "!control/**"
      ],
      "outputs": ["dist/admin/**"],
      "env": ["METORIAL_ENV", "VITE_*"]
    },
    "worker:build": {
      "dependsOn": ["prisma:generate", "^prisma:generate", "^build", "^worker:build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!README*",
        "!control/**"
      ],
      "outputs": ["dist-worker/**"],
      "env": ["METORIAL_ENV"]
    },
    "setup_vscode": {
      "cache": false
    },
    "deploy:only": {
      "env": [
        "SENTRY_AUTH_TOKEN",
        "METORIAL_ENV",
        "VITE_*",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    },
    "deploy": {
      "env": [
        "SENTRY_AUTH_TOKEN",
        "METORIAL_ENV",
        "VITE_*",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    },
    "server:build": {
      "dependsOn": ["admin:build", "prisma:generate", "^prisma:generate", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!README*",
        "!control/**"
      ],
      "env": ["METORIAL_ENV"],
      "outputs": ["dist/**", "!dist/admin/**"]
    },
    "oss:server:build": {
      "dependsOn": ["prisma:generate", "^prisma:generate", "^build", "^oss:server:build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!README*",
        "!control/**"
      ],
      "env": ["METORIAL_ENV"],
      "outputs": ["dist/**"]
    },
    "@mtsrc/auth-core-client-internal#build": {
      "dependsOn": ["^build", "@mtsrc/auth-core-service#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@metorial-platform-systems/forge-client#build": {
      "dependsOn": ["^build", "@metorial/forge#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@mtsrc/secret-store-client-internal#build": {
      "dependsOn": ["^build", "@mtsrc/secret-store-service#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@metorial-platform-systems/origin-client#build": {
      "dependsOn": ["^build", "@metorial/origin#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@mtsrc/email-client-internal#build": {
      "dependsOn": ["^build", "@mtsrc/email-service#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@metorial-platform-systems/shuttle-client#build": {
      "dependsOn": ["^build", "@metorial/shuttle#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@metorial-platform-systems/signal-client#build": {
      "dependsOn": ["^build", "@metorial/signal#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@metorial-platform-systems/slates-client#build": {
      "dependsOn": ["^build", "@metorial/slates#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@mtsrc/ai-gateway-client-internal#build": {
      "dependsOn": ["^build", "@mtsrc/ai-gateway-db#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@mtsrc/search-client-internal#build": {
      "dependsOn": ["^build", "@mtsrc/search-service#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@metorial-services/slates-registry-client#build": {
      "dependsOn": ["^build", "@metorial/slates-registry#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "@metorial-services/slates-registry-internal-client#build": {
      "dependsOn": ["^build", "@metorial/slates-registry#prisma:generate"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "prisma:generate", "^prisma:generate", "test:inputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README*",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!control/**",
        "$TURBO_ROOT$/tsconfig*.json"
      ],
      "outputs": [],
      "env": ["CI", "NODE_ENV", "TEST_CACHE_RUNTIME"]
    },
    "@metorial-platform-products/runtime#test": {
      "dependsOn": ["^build", "prisma:generate", "^prisma:generate", "test:inputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README*",
        "!**/Dockerfile",
        "!**/*.Dockerfile",
        "!.dockerignore",
        "!**/control/**",
        "$TURBO_ROOT$/src/lowerdeck/go/**/*.go",
        "$TURBO_ROOT$/src/lowerdeck/go/**/go.mod",
        "$TURBO_ROOT$/src/lowerdeck/go/**/go.sum",
        "$TURBO_ROOT$/src/object-storage/clients/go/**/*.go",
        "$TURBO_ROOT$/src/object-storage/clients/go/**/go.mod",
        "$TURBO_ROOT$/src/object-storage/clients/go/**/go.sum"
      ],
      "outputs": [],
      "env": ["CI", "NODE_ENV", "TEST_CACHE_RUNTIME"]
    },
    "rust:fmt": {
      "inputs": ["**/*.rs", "Cargo.toml", "Cargo.lock", "rustfmt.toml"],
      "outputs": []
    },
    "rust:check": {
      "inputs": ["**/*.rs", "**/Cargo.toml", "Cargo.lock"],
      "outputs": []
    },
    "rust:lint": {
      "inputs": ["**/*.rs", "**/Cargo.toml", "Cargo.lock", "clippy.toml"],
      "outputs": []
    },
    "rust:test": {
      "inputs": ["**/*.rs", "**/Cargo.toml", "Cargo.lock", "object-store/tests/**"],
      "outputs": []
    },
    "rust:build": {
      "inputs": ["**/*.rs", "**/Cargo.toml", "Cargo.lock"],
      "outputs": ["target/release/object-store-service"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "control:db:generate": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "control:db:push": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "control:db:migrate": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@metorial-subspace/app-worker#server:build": {
      "dependsOn": [
        "admin:build",
        "prisma:generate",
        "^prisma:generate",
        "^build",
        "@metorial/module-community#build",
        "@metorial/module-skill-groups#build",
        "@metorial/module-skill-templates#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!README*",
        "!control/**"
      ],
      "env": ["METORIAL_ENV"],
      "outputs": ["dist/**", "!dist/admin/**"]
    },
    "@metorial/module-organization#test": {
      "dependsOn": [
        "^build",
        "prisma:generate",
        "^prisma:generate",
        "test:inputs",
        "@metorial/module-access#test:inputs"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/.prettierrc",
        "$TURBO_ROOT$/src/metorial-frontend/packages/state/src/config/generated/organizationConfigs.ts"
      ],
      "outputs": [],
      "env": ["CI", "NODE_ENV", "TEST_CACHE_RUNTIME"]
    },
    "test:inputs": {
      "dependsOn": ["^test:inputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README*",
        "!Dockerfile",
        "!dev.Dockerfile",
        "!.dockerignore",
        "!control/**",
        "$TURBO_ROOT$/tsconfig*.json"
      ],
      "outputs": []
    },
    "e2e:fingerprint": {
      "dependsOn": ["^e2e:fingerprint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!README*",
        "$TURBO_ROOT$/tsconfig*.json"
      ],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build", "prisma:generate", "^prisma:generate"],
      "env": ["CONTROL_E2E_STACK_KEY"],
      "passThroughEnv": ["*"],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build", "prisma:generate", "^prisma:generate"],
      "passThroughEnv": ["*"]
    }
  }
}
